# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*

# firebase
.firebase/
firebase-debug.log
firestore-debug.log

# Service-account keys. These grant full admin access to the project and cannot be scoped down, so
# they are ignored by shape rather than by exact name — the console names the download after the
# project and a random suffix, which is easy to commit by accident when it lands in the repo root.
*firebase-adminsdk*.json
service-account*.json
serviceAccount*.json