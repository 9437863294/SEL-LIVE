{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "src/app/(protected)/office-hub/**/*.ts",
    "src/app/(protected)/office-hub/**/*.tsx",
    "src/app/api/office-hub/**/*.ts",
    "src/components/office-hub/**/*.ts",
    "src/components/office-hub/**/*.tsx",
