# ──────────────────────────────────────────────────────────────────────────────────────────────
# Mail Hub — environment variables (docs/mail-hub.md)
#
# Copy what you need into .env.local for development. In production (Firebase App Hosting) set
# them in the backend's environment configuration, and put every value marked SECRET in Secret
# Manager — never in apphosting.yaml as plain text, and never in a NEXT_PUBLIC_ variable.
#
# Every provider is optional. Mail Hub shows only the providers that are fully configured.
# ──────────────────────────────────────────────────────────────────────────────────────────────

# ── Where connection secrets are sealed (one of these is REQUIRED) ────────────────────────────
# Preferred: a Cloud KMS key. The Firebase Admin service account needs
# roles/cloudkms.cryptoKeyEncrypterDecrypter on this key and nothing more.
MAIL_HUB_KMS_KEY_NAME=projects/YOUR_PROJECT/locations/asia-south1/keyRings/mail-hub/cryptoKeys/credentials
# Or: 32 random bytes from Secret Manager (SECRET). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAIL_HUB_TOKEN_KEY=
MAIL_HUB_TOKEN_KEY_VERSION=v1
# During a rotation only (see scripts/mail-hub-rotate-keys.mjs):
MAIL_HUB_TOKEN_KEY_PREVIOUS=
MAIL_HUB_TOKEN_KEY_PREVIOUS_VERSION=v0

# HMAC key for OAuth state and Graph clientState (SECRET). Optional — derived from the key above
# when unset — but a separate value means rotating one does not invalidate the other.
MAIL_HUB_STATE_SECRET=

# The public URL the providers redirect to and call back. Defaults to NEXT_PUBLIC_APP_URL /
# APP_BASE_URL. Must be https in production.
MAIL_HUB_PUBLIC_URL=https://seltech.store

# ── Google Workspace / Gmail ──────────────────────────────────────────────────────────────────
# Falls back to Office Hub's GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET when unset.
# Authorised redirect URI to register: {MAIL_HUB_PUBLIC_URL}/api/mail-hub/oauth/gmail/callback
MAIL_HUB_GOOGLE_CLIENT_ID=
MAIL_HUB_GOOGLE_CLIENT_SECRET=          # SECRET

# Push notifications (optional; without them Gmail is polled every 30 minutes and on demand).
MAIL_HUB_GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/mail-hub-gmail
# The push subscription's OIDC service account (recommended) …
MAIL_HUB_GMAIL_PUSH_SERVICE_ACCOUNT=mail-hub-push@YOUR_PROJECT.iam.gserviceaccount.com
# … and the audience it was configured with (defaults to the webhook URL).
MAIL_HUB_GMAIL_PUSH_AUDIENCE=
# … or, for a subscription without OIDC, a random token appended as ?token= to the push URL (SECRET).
MAIL_HUB_GMAIL_PUSH_TOKEN=

# ── Microsoft 365 / Outlook ───────────────────────────────────────────────────────────────────
# Entra ID app registration. Redirect URI (Web):
#   {MAIL_HUB_PUBLIC_URL}/api/mail-hub/oauth/microsoft/callback
MAIL_HUB_MICROSOFT_CLIENT_ID=
MAIL_HUB_MICROSOFT_CLIENT_SECRET=       # SECRET
# Your tenant id for a single-tenant registration; `organizations` accepts any work account.
MAIL_HUB_MICROSOFT_TENANT=organizations
# Graph change notifications need a public https URL; set to true to force polling.
MAIL_HUB_DISABLE_GRAPH_WEBHOOKS=false

# ── Company mailbox (IMAP/SMTP, e.g. the server behind Roundcube) ─────────────────────────────
# Optional: `npm run migrate:mail-hub` turns these into the first server preset. Presets can also
# be added on Mail Hub › Permissions & sharing › Connection settings. Users can only connect to
# configured presets — never to a host they type in.
MAIL_HUB_IMAP_DEFAULT_LABEL=SEL mail
MAIL_HUB_IMAP_DEFAULT_HOST=mail.example.com
MAIL_HUB_IMAP_DEFAULT_PORT=993
MAIL_HUB_IMAP_DEFAULT_SECURITY=tls          # tls | starttls
MAIL_HUB_SMTP_DEFAULT_HOST=mail.example.com
MAIL_HUB_SMTP_DEFAULT_PORT=465
MAIL_HUB_SMTP_DEFAULT_SECURITY=tls          # tls | starttls (587)
MAIL_HUB_IMAP_DEFAULT_USERNAME_STYLE=email  # email | local-part
MAIL_HUB_IMAP_DEFAULT_DOMAINS=example.com
# Set true only if the SMTP server rejects senders the login is not authorised for
# (Postfix reject_sender_login_mismatch). Required before shared-mailbox sending can be verified.
MAIL_HUB_SMTP_DEFAULT_ENFORCES_SENDER=false
MAIL_HUB_SMTP_DEFAULT_APPEND_SENT=true

# ── Background worker ─────────────────────────────────────────────────────────────────────────
# Shared with the other scheduled routes. The Mail Hub worker refuses to run without it (SECRET).
CRON_SECRET=

# ── Optional protections ──────────────────────────────────────────────────────────────────────
# HTTP malware scanner (e.g. a ClamAV REST sidecar) that answers {"clean": true|false}.
MAIL_HUB_SCAN_URL=
MAIL_HUB_SCAN_TOKEN=                    # SECRET
# Google Safe Browsing API key for the link interstitial.
MAIL_HUB_SAFE_BROWSING_KEY=             # SECRET

# ── AI suggestions (optional, opt-in per user) ────────────────────────────────────────────────
# Uses the app's existing Genkit/Gemini configuration.
GEMINI_API_KEY=                         # SECRET
