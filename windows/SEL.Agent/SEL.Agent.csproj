<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The desktop agent: tray icon, access gate, morning dashboard and status window.

    WindowsForms is referenced alongside WPF for one reason — NotifyIcon. WPF has never shipped a
    tray API, and every third-party wrapper is this same class with a XAML surface on it. One
    extra framework assembly is cheaper than a hand-rolled Shell_NotifyIcon host and its
    taskbar-restart handling.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Sel.Agent</RootNamespace>
    <AssemblyName>SEL.Agent</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- AgentHost passes SelLiveApiClient.Http to FirebaseAuthClient so the two share a
         connection pool, which puts HttpClient in this assembly's signature surface. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The embedded ERP window. WebView2 is not part of Windows — it is a separately installed
      runtime — so this reference only makes the API callable. ErpBrowser probes at startup and
      falls back to the default browser when the runtime is absent, which is why nothing here
      is conditional on the Windows version.
    -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SEL.Agent.Core\SEL.Agent.Core.csproj" />
    <ProjectReference Include="..\SEL.Agent.WindowsLegacy\SEL.Agent.WindowsLegacy.csproj" />
    <ProjectReference Include="..\SEL.Agent.WindowsModern\SEL.Agent.WindowsModern.csproj" />
  </ItemGroup>

</Project>
