<Window x:Class="Sel.Agent.ExitApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEL LIVE Agent — Administrator approval"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        ShowInTaskbar="True">

    <!--
      Closing the agent needs a SEL LIVE administrator, not a Windows one.

      The earlier version of this used a UAC prompt, which asks the wrong question. Plenty of
      employees are local administrators on their own laptop — that is a fact about who set the
      machine up, and says nothing about whether they may stop their own attendance recording.
      Meanwhile the HR or IT staff who should decide often hold no Windows rights on that PC.

      So this asks for a SEL LIVE sign-in and the server checks the permission. Styled to match
      FirstRunSetupWindow rather than the dark sign-in screen: this is a utility dialog an
      administrator sees occasionally, not the face of the product.
    -->

    <StackPanel Margin="24">
        <TextBlock Text="A SEL LIVE administrator must approve this"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="#0F172A" />
        <TextBlock x:Name="IntroText"
                   FontSize="12"
                   Foreground="#64748B"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />

        <TextBlock Text="Administrator email"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#334155"
                   Margin="0,20,0,6" />
        <TextBox x:Name="EmailBox"
                 Padding="9,7"
                 FontSize="13"
                 BorderBrush="#CBD5E1"
                 BorderThickness="1" />

        <TextBlock Text="Password"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#334155"
                   Margin="0,14,0,6" />
        <!-- PasswordBox, not TextBox: its contents are not exposed as a bindable property and
             are held in unmanaged memory, so the password does not sit in a managed string
             waiting to be collected. -->
        <PasswordBox x:Name="PasswordBox"
                     Padding="9,7"
                     FontSize="13"
                     BorderBrush="#CBD5E1"
                     BorderThickness="1" />

        <TextBlock Text="Reason (optional)"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#334155"
                   Margin="0,14,0,6" />
        <TextBox x:Name="ReasonBox"
                 Padding="9,7"
                 FontSize="13"
                 BorderBrush="#CBD5E1"
                 BorderThickness="1" />
        <TextBlock Text="Recorded in the SEL LIVE audit trail alongside who approved it, e.g. &quot;PC being re-imaged&quot;."
                   FontSize="11"
                   Foreground="#94A3B8"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />

        <Border x:Name="StatusPanel"
                Margin="0,16,0,0"
                Padding="12,9"
                CornerRadius="4"
                Visibility="Collapsed">
            <TextBlock x:Name="StatusText"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="ApproveButton"
                    Content="Approve and close agent"
                    Padding="16,7"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#B91C1C"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsDefault="True"
                    Click="OnApproveClicked" />
            <Button x:Name="CancelButton"
                    Content="Keep running"
                    Padding="14,7"
                    Margin="8,0,0,0"
                    Cursor="Hand"
                    IsCancel="True"
                    Click="OnCancelClicked" />
        </StackPanel>

        <TextBlock x:Name="FooterText"
                   FontSize="11"
                   Foreground="#94A3B8"
                   TextWrapping="Wrap"
                   Margin="0,14,0,0" />
    </StackPanel>
</Window>
