<Window x:Class="Sel.Agent.ErpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SEL LIVE"
        Icon="app.ico"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#020617">

    <!--
      The ERP, inside the agent.

      A thin chrome over a WebView2: a back/forward/reload strip, the address of the page it is
      on, and an escape to the real browser. Deliberately not a full browser — no tabs, no
      address bar to type into, no downloads UI. It is a window onto one application, and every
      control it grows is one more thing to keep working on Windows 7.

      WebView2 rather than the built-in WPF WebBrowser control: that one is Internet Explorer 11,
      which cannot run a modern Next.js application at all. Where WebView2 is unavailable — which
      includes Windows 7 and 8.1, whose WebView2 support Microsoft ended in 2023 — this window is
      never created and the tray opens the user's own browser instead. See ErpBrowser.
    -->

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A5F3FC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6"
                                Background="#14FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2622D3EE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B1220" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
            <Grid Margin="10,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BackButton" Content="&#x2190;" Width="30" Height="26"
                            ToolTip="Back" Click="OnBack" Style="{StaticResource NavButton}" />
                    <Button x:Name="ForwardButton" Content="&#x2192;" Width="30" Height="26" Margin="4,0,0,0"
                            ToolTip="Forward" Click="OnForward" Style="{StaticResource NavButton}" />
                    <Button x:Name="ReloadButton" Content="&#x21BB;" Width="30" Height="26" Margin="4,0,0,0"
                            ToolTip="Reload" Click="OnReload" Style="{StaticResource NavButton}" />
                    <Button x:Name="HomeButton" Content="&#x2302;" Width="30" Height="26" Margin="4,0,0,0"
                            ToolTip="SEL LIVE home" Click="OnHome" Style="{StaticResource NavButton}" />
                </StackPanel>

                <Border Grid.Column="1" Margin="10,0" CornerRadius="6" Padding="10,5"
                        Background="#12FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                    <TextBlock x:Name="AddressText"
                               FontSize="11.5"
                               Foreground="#94A3B8"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </Border>

                <!--
                  No "Open in browser".

                  It was here as an escape hatch, and it is the wrong thing to offer once this
                  window is the working session: closing it locks the PC, so a button that
                  moves the ERP into Chrome hands somebody a way to keep working outside the
                  window whose closure is supposed to end the session. The whole arrangement
                  only means something if there is one way in.

                  Where WebView2 genuinely cannot run — Windows 7 and 8.1, or a policy that
                  blocks it — the agent still opens the default browser, automatically, without
                  offering it as a choice. See ErpBrowser.
                -->
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" />

            <!-- Shown until the first navigation completes, and again on a hard failure. -->
            <StackPanel x:Name="StatusPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="StatusTitle"
                           Text="Opening SEL LIVE…"
                           FontSize="15"
                           Foreground="#CFFAFE"
                           TextAlignment="Center" />
                <TextBlock x:Name="StatusDetail"
                           Margin="0,8,0,0"
                           MaxWidth="460"
                           FontSize="12"
                           Foreground="#64748B"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <!-- Retry, not "open it somewhere else". A page that failed to load is usually
                     a network blip, and the alternative this used to offer is the one the
                     window exists to avoid. -->
                <Button x:Name="StatusActionButton"
                        Content="Try again"
                        Margin="0,16,0,0"
                        Padding="14,7"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed"
                        Click="OnRetry"
                        Style="{StaticResource NavButton}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#0B1220" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0">
            <TextBlock x:Name="FooterText"
                       Margin="12,5"
                       FontSize="10.5"
                       Foreground="#475569" />
        </Border>
    </Grid>
</Window>
