<Window x:Class="Sel.Agent.FirstRunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEL LIVE Agent — Setup"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        ShowInTaskbar="True">

    <!--
      First-run setup, and the reason it exists rather than an error dialog.

      The agent used to show "The SEL LIVE address has not been configured. Ask IT to complete the
      agent configuration at C:\ProgramData\..." and then exit. That is a dead end: it names a
      file, not an action, and the person who sees it is usually the person who was supposed to do
      the configuring. It also made the MSI unusable by double-clicking, because the address and
      the API key had to be passed as msiexec properties.

      This asks for the one thing an administrator actually knows — the address of their own ERP —
      and fetches the rest from it. The enrolment code is optional here because a machine can be
      enrolled later; what cannot be deferred is knowing which server to talk to.
    -->

    <StackPanel Margin="24">
        <TextBlock Text="Connect this computer to SEL LIVE"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="#0F172A" />
        <TextBlock Text="The agent needs the address of your SEL LIVE installation. It will collect everything else from the server."
                   FontSize="12"
                   Foreground="#64748B"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />

        <TextBlock Text="SEL LIVE address"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#334155"
                   Margin="0,20,0,6" />
        <TextBox x:Name="UrlBox"
                 Padding="9,7"
                 FontSize="13"
                 BorderBrush="#CBD5E1"
                 BorderThickness="1"
                 Text="https://" />
        <TextBlock Text="For example https://sel.yourcompany.com — the same address you open SEL LIVE with in a browser."
                   FontSize="11"
                   Foreground="#94A3B8"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />

        <TextBlock Text="Enrolment code (optional)"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#334155"
                   Margin="0,14,0,6" />
        <TextBox x:Name="CodeBox"
                 Padding="9,7"
                 FontSize="13"
                 BorderBrush="#CBD5E1"
                 BorderThickness="1" />
        <TextBlock Text="Given to you by IT, e.g. SEL-HO-2026. Without it this computer will not register until a code is added later."
                   FontSize="11"
                   Foreground="#94A3B8"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />

        <Border x:Name="StatusPanel"
                Margin="0,16,0,0"
                Padding="12,9"
                CornerRadius="4"
                Visibility="Collapsed">
            <TextBlock x:Name="StatusText"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="TestButton"
                    Content="Test connection"
                    Padding="14,7"
                    Margin="0,0,8,0"
                    Cursor="Hand"
                    Click="OnTestClicked" />
            <Button x:Name="SaveButton"
                    Content="Save and start"
                    Padding="16,7"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#2563EB"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsDefault="True"
                    Click="OnSaveClicked" />
            <Button x:Name="CancelButton"
                    Content="Close"
                    Padding="14,7"
                    Margin="8,0,0,0"
                    Cursor="Hand"
                    IsCancel="True"
                    Click="OnCancelClicked" />
        </StackPanel>

        <TextBlock x:Name="FooterText"
                   FontSize="11"
                   Foreground="#94A3B8"
                   TextWrapping="Wrap"
                   Margin="0,14,0,0" />
    </StackPanel>
</Window>
