<Window x:Class="Sel.Agent.AgentStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEL LIVE Agent"
        Icon="app.ico"
        Width="640"
        Height="620"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        ResizeMode="CanResize">

    <!--
      Agent status (§47) and the monitoring disclosure (§52), in the one window the employee can
      always reach from the tray.

      The two belong together. A person told that their computer is monitored will want to know
      two things — is it working, and what exactly is it recording — and answering the second one
      on the same screen as the first is what makes the answer credible. A policy page buried in
      the ERP that says "we do not log keystrokes" is a claim; the same sentence next to a live
      readout of what the agent is doing reads as a description.
    -->

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeadlineText" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
            <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="14" Background="White" CornerRadius="6"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid x:Name="FactsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="FactsLeft" Grid.Column="0" />
                <StackPanel x:Name="FactsRight" Grid.Column="1" />
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Margin="0,14,0,0" BorderBrush="#E2E8F0" Background="White">
            <TabItem Header="What is recorded">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel x:Name="DisclosurePanel" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Activity log">
                <Grid>
                    <TextBox x:Name="LogBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="11"
                             BorderThickness="0"
                             Background="#0F172A"
                             Foreground="#CBD5E1"
                             Padding="10" />
                </Grid>
            </TabItem>
            <TabItem Header="Policy in force">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel x:Name="PolicyPanel" />
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="RunChecksButton" Content="Run connection checks" Padding="14,7" Margin="0,0,8,0"
                    Cursor="Hand" Click="OnRunChecks" />
            <Button x:Name="SyncButton" Content="Sync now" Padding="14,7" Margin="0,0,8,0"
                    Cursor="Hand" Click="OnSyncNow" />
            <Button x:Name="CloseButton" Content="Close" Padding="14,7" Cursor="Hand" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
