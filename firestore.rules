rules_version = '2';

/**
 * Firestore security rules for the access-management, Site Account Statement and Office Hub
 * collections.
 *
 * ── Read this before deploying ──────────────────────────────────────────────────────────────────
 *
 * This repository has never contained a `firestore.rules` file. `firebase.json` declares only the
 * Realtime Database rules, the Storage rules and the Firestore *indexes* — the Firestore rules for
 * this project are maintained in the Firebase console. That means **deploying this file as-is would
 * replace whatever is currently in the console with only what is written here, and every collection
 * not mentioned below would stop being readable.**
 *
 * So it is deliberately not wired into `firebase.json`. Two safe ways to adopt it:
 *
 *   1. Copy the `accessGrants`, `accessScopeGrants`, `accessTemplates`, `accessAuditLogs` and
 *      `accessBatches` blocks — plus the two helper functions — into the existing console ruleset,
 *      leaving everything else there untouched. This is the recommended route.
 *
 *      The same applies to the `siteAccount*` blocks near the bottom of this file. Those are worth
 *      adopting sooner rather than later: until they are in place, Site Account Statement has no
 *      server-side authorization at all — the module's pages decide what a user may see and change
 *      entirely in the browser, which anyone can bypass. Copy them together with their `sas*`
 *      helper functions, and verify with the rules simulator that a user assigned to one project
 *      can read that project's expenses and not another's.
 *
 *      The same applies to the `officeHub*` blocks at the bottom of this file. Until they are in
 *      the console ruleset, Office Hub's meetings, tasks and decisions are readable and writable by
 *      any signed-in user — the module's screens enforce its permissions in the browser, which
 *      anyone can bypass. Copy them together with their `canOpenOfficeHub`, `officeHubHolds` and
 *      `isOfficeHubMeetingMember` helpers, and verify with the rules simulator that a user who is
 *      not a participant of a meeting cannot read that meeting's document.
 *
 *   2. Export the console's current rules, paste them into this file above the access blocks, add
 *      `"rules": "firestore.rules"` under `"firestore"` in `firebase.json`, and from then on manage
 *      them here. Verify with `firebase deploy --only firestore:rules --dry-run` first.
 *
 * ── Why the rules look like this ────────────────────────────────────────────────────────────────
 *
 * `canManageAccess()` is the same test the UI and the API routes make, expressed in rules: either
 * the new `Settings.Access Management` permission, or the User Management + Role Management pair
 * that existing administrators hold. The fallback is what makes the feature possible to turn on —
 * on the day it ships nobody holds the new permission, because it did not exist when the current
 * role documents were written.
 *
 * Grant documents are readable by their own subject as well as by administrators. A signed-in user
 * has to be able to read their own `accessGrants/{uid}` document, because that is what
 * `AuthProvider` subscribes to in order to know what they can do. They can never write it.
 *
 * Audit rows are append-only and never updatable or deletable by anybody, including administrators.
 * An audit trail an administrator can edit is not an audit trail.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function actor() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /**
     * The permission map for the signed-in user's base role.
     *
     * `users.role` holds a role *name*, not an id, and rules cannot run a query — so this resolves
     * the role by document id only. Installations whose role document ids are not the role names
     * will fall through to `false` here; in that case use option 1 above and gate these collections
     * on whatever test the existing console ruleset already uses for `Settings.User Management`.
     */
    function rolePermissions() {
      return get(/databases/$(database)/documents/roles/$(actor().role)).data.permissions;
    }

    function holdsPermission(resource, action) {
      return signedIn()
        && rolePermissions() != null
        && rolePermissions()[resource] != null
        && action in rolePermissions()[resource];
    }

    function canManageAccess() {
      return holdsPermission('Settings.Access Management', 'Assign')
        || holdsPermission('Settings.Access Management', 'Administer')
        || (holdsPermission('Settings.User Management', 'Edit')
            && holdsPermission('Settings.Role Management', 'Edit'));
    }

    function canViewAccess() {
      return holdsPermission('Settings.Access Management', 'View') || canManageAccess();
    }

    /**
     * A user's additive grants.
     *
     * Self-read is required: `AuthProvider` subscribes to this document to resolve the user's own
     * effective permissions. Self-write is not, and must never be allowed — a user who could write
     * their own grant document could grant themselves anything.
     */
    match /accessGrants/{userId} {
      allow get, list: if signedIn() && (request.auth.uid == userId || canViewAccess());
      allow create, update: if canManageAccess();
      // Deleting a grant document would silently drop somebody's additional access with no audit
      // record. Removal goes through the revoke workflow, which rewrites the document and logs it.
      allow delete: if false;
    }

    /** Department, designation and project rules. Read by every signed-in user's resolver. */
    match /accessScopeGrants/{scopeId} {
      allow get, list: if signedIn();
      allow create, update: if canManageAccess();
      allow delete: if false;
    }

    /** Reusable access bundles. Only ever read by the administration screens. */
    match /accessTemplates/{templateId} {
      allow get, list: if canViewAccess();
      allow create, update: if canManageAccess();
      allow delete: if false;
    }

    /** The permission-change audit trail: append-only, for everybody. */
    match /accessAuditLogs/{entryId} {
      allow get, list: if canViewAccess()
        || holdsPermission('Settings.Access Management', 'View Audit')
        || holdsPermission('Settings.Audit Logs', 'View');
      allow create: if canManageAccess();
      allow update, delete: if false;
    }

    /** Bulk-operation records. Same append-only treatment as the audit rows. */
    match /accessBatches/{batchId} {
      allow get, list: if canViewAccess()
        || holdsPermission('Settings.Access Management', 'View Audit')
        || holdsPermission('Settings.Audit Logs', 'View');
      allow create: if canManageAccess();
      allow update, delete: if false;
    }

    /* ── greytHR integration (docs/greythr-integration.md) ── */

    function canViewEmployees() {
      return holdsPermission('Settings.Employee Management', 'View');
    }

    /**
     * The employee mirror.
     *
     * Readable by every signed-in user, as it was before this integration — the HR module, the
     * access screens and several pickers all read it. **Writes are server-only:** the sync runs
     * through the Admin SDK, which bypasses these rules, so denying client writes here closes the
     * path by which a signed-in user could edit their own employment state and undo a deactivation.
     */
    match /employees/{employeeId} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    /** Effective-dated category history. Same reasoning. */
    match /employeePositions/{employeeNo} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    /**
     * The replaceable snapshot of greytHR's CURRENT roster — one document per currently-employed
     * person, cleared and rewritten on each successful complete fetch.
     *
     * Stated explicitly rather than left to Firestore's default deny, because this is the one
     * collection in the integration that gets **deleted from**. `allow write: if false` means those
     * deletions can only ever come from the Admin SDK path that carries the guards in
     * `shouldReplaceRosterSnapshot` — a client cannot empty the roster by writing directly, and
     * cannot forge a snapshot that a screen would then present as greytHR's answer.
     *
     * Readable by any signed-in user on the same footing as `employees`: it holds no field that
     * collection does not already expose.
     */
    match /greythrCurrentRoster/{employeeId} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    /**
     * Restricted personal data — Aadhaar, PAN, bank accounts, religion, disability, home addresses.
     *
     * The whole reason this is a separate collection. `employees` above is readable by every
     * signed-in user because half the application reads it; this must not be. Gated on its own
     * permission, which by default no role holds.
     *
     * Note what is *not* here: a self-read exemption. It would be reasonable to let somebody read
     * their own Aadhaar number, but `users` and `employees` are joined by email rather than by id,
     * so a rule cannot establish "this is me" without a query — and rules cannot query. Employees
     * who need their own details have them in greytHR's own self-service portal.
     */
    match /employeeSensitive/{employeeId} {
      allow get, list: if holdsPermission('Employee.Personal Data', 'View');
      allow write: if false;
    }

    /**
     * Leave balances and attendance summaries.
     *
     * Gated on Employee Management rather than left open like `employees`: how much leave somebody
     * has and how often they arrive late is not something every colleague needs to see, even though
     * it is not special-category data. Server-only writes, as with everything the sync maintains.
     */
    match /employeeLeaveBalance/{employeeId} {
      allow get, list: if canViewEmployees();
      allow write: if false;
    }

    match /employeeAttendance/{employeeId} {
      allow get, list: if canViewEmployees();
      allow write: if false;
    }

    /**
     * Run records.
     *
     * Written only by the Admin SDK. Read by the sync console, which is gated on Employee
     * Management — the run report names who resigned and when, which is not general-audience data.
     */
    match /greythrSyncRuns/{runId} {
      allow get, list: if canViewEmployees();
      allow write: if false;
    }

    /**
     * The user ↔ employee link history.
     *
     * Read by anyone who can see User Management, because the question it answers — "why is this
     * account attached to that employee" — is asked from that screen. Written only by the Admin SDK
     * behind `/api/greythr/link`: a client that could write here could forge the record of who
     * attached a login to whose HR data, which is the one thing this collection exists to prove.
     */
    match /greythrLinkAudit/{entryId} {
      allow get, list: if holdsPermission('Settings.User Management', 'View');
      allow write: if false;
    }

    // ── Site Account Statement ──────────────────────────────────────────────────────────────────
    //
    // This module's authorization was, until now, entirely client-side: every page decided what the
    // user could see in JavaScript *after* downloading the collection. Anyone signed in could read
    // the whole organisation's site ledger straight from the network tab, and write to any project
    // they were not assigned to. These rules put the same decisions on the server.
    //
    // The client no longer issues unconstrained collection reads (see
    // `src/lib/site-account-statement-queries.ts`) — every query is bounded by `projectId`, which
    // is what makes a per-document `list` rule enforceable here rather than merely decorative.
    //
    // ── One constraint to respect when changing these ──
    // The member checks below call `get()` on the row's project document. Firestore permits 20
    // document-access calls per query, and caches identical paths so the cost is one call per
    // *distinct* project in the query, plus two for the caller's own user and role documents.
    // `SAS_IN_CHUNK` in the query module is pinned to 15 to stay inside that budget. Widening the
    // `in` filter without widening this reasoning would make queries fail for precisely the
    // project-assigned users these rules exist to serve. Holders of `All Projects` short-circuit on
    // the first clause and never reach a per-document lookup at all.

    function sasPerm(resource, action) {
      return holdsPermission('Site Account Statement.' + resource, action);
    }

    /** Holders of All Projects see and act across every project — the module's administrators. */
    function sasViewsAllProjects() {
      return sasPerm('All Projects', 'View');
    }

    function sasProject(projectId) {
      return get(/databases/$(database)/documents/siteAccountProjects/$(projectId)).data;
    }

    /** Assigned person or alternative user — the two roles that may record transactions. */
    function sasCanWriteProject(projectId) {
      let project = sasProject(projectId);
      return signedIn() && (
        project.assignedPersonId == request.auth.uid
        || project.altUserId == request.auth.uid
      );
    }

    /** Adds the viewer, who may read a project's figures but never change them. */
    function sasCanReadProject(projectId) {
      let project = sasProject(projectId);
      return signedIn() && (
        project.assignedPersonId == request.auth.uid
        || project.altUserId == request.auth.uid
        || project.viewerId == request.auth.uid
      );
    }

    /**
     * Project setup.
     *
     * Readable by any signed-in user because every page in the module starts by resolving which
     * projects the current user is attached to — that question cannot be answered without reading
     * the assignment rows. The rows carry no financial figures. Writing one changes who can see and
     * spend against a site, so it stays behind Project Settings.
     */
    match /siteAccountProjects/{projectId} {
      allow get, list: if signedIn();
      allow create, update: if sasPerm('Project Settings', 'Add') || sasPerm('Project Settings', 'Edit');
      allow delete: if sasPerm('Project Settings', 'Delete');
    }

    /**
     * The ledger: money received from Head Office, and money spent at site.
     *
     * Reads are allowed for administrators, for holders of the matching RBAC resource, and for
     * anyone attached to the project the row belongs to. Writes additionally require a
     * *write-bearing* assignment — being the viewer on a project is not enough, which is the
     * server-side half of the per-project check the forms now make.
     */
    match /siteAccountPayments/{paymentId} {
      allow get, list: if sasViewsAllProjects()
        || sasPerm('Payments', 'View')
        || (resource != null && sasCanReadProject(resource.data.projectId));
      allow create: if sasPerm('Payments', 'Add') || sasCanWriteProject(request.resource.data.projectId);
      allow update: if sasPerm('Payments', 'Edit') || sasCanWriteProject(resource.data.projectId);
      allow delete: if sasPerm('Payments', 'Delete');
    }

    match /siteAccountExpenses/{expenseId} {
      allow get, list: if sasViewsAllProjects()
        || sasPerm('Expenses', 'View')
        || (resource != null && sasCanReadProject(resource.data.projectId));
      allow create: if sasPerm('Expenses', 'Add') || sasCanWriteProject(request.resource.data.projectId);
      allow update: if sasPerm('Expenses', 'Edit') || sasCanWriteProject(resource.data.projectId);
      allow delete: if sasPerm('Expenses', 'Delete');
    }

    /**
     * Budgets, at all four levels.
     *
     * Role management is granular here — Total / FY / Monthly / Category are separate resources —
     * but the documents live in two collections, and a rule cannot tell which level a role was
     * granted without reading `budgetType`. The coarse `Budget` permission, or any of the four
     * specific ones, is accepted; the UI is what presents the right level to the right role.
     */
    function sasCanWriteBudget(action) {
      return sasPerm('Budget', action)
        || sasPerm('Total Budget', action)
        || sasPerm('FY Budget', action)
        || sasPerm('Monthly Budget', action)
        || sasPerm('Category Budget', action);
    }

    function sasCanReadBudget() {
      return sasViewsAllProjects()
        || sasCanWriteBudget('View')
        || sasCanWriteBudget('Add')
        || sasCanWriteBudget('Edit');
    }

    match /siteAccountBudgets/{budgetId} {
      allow get, list: if sasCanReadBudget()
        || (resource != null && sasCanReadProject(resource.data.projectId));
      allow create: if sasCanWriteBudget('Add') || sasCanWriteProject(request.resource.data.projectId);
      allow update: if sasCanWriteBudget('Edit') || sasCanWriteProject(resource.data.projectId);
      allow delete: if sasCanWriteBudget('Delete');
    }

    match /siteAccountCategoryBudgets/{budgetId} {
      allow get, list: if sasCanReadBudget()
        || (resource != null && sasCanReadProject(resource.data.projectId));
      allow create: if sasCanWriteBudget('Add') || sasCanWriteProject(request.resource.data.projectId);
      allow update: if sasCanWriteBudget('Edit') || sasCanWriteProject(resource.data.projectId);
      allow delete: if sasCanWriteBudget('Delete');
    }

    match /siteAccountTenderBudgets/{budgetId} {
      allow get, list: if sasViewsAllProjects()
        || sasPerm('Tender Budget', 'View')
        || sasPerm('Tender Forecast', 'View')
        || (resource != null && sasCanReadProject(resource.data.projectId));
      allow create, update: if sasPerm('Tender Budget', 'Add') || sasPerm('Tender Budget', 'Edit');
      allow delete: if sasPerm('Tender Budget', 'Delete');
    }

    /** Scanned monthly budget approvals. Same audience as the monthly budget they evidence. */
    match /siteAccountBudgetApprovals/{approvalId} {
      allow get, list: if sasCanReadBudget()
        || (resource != null && sasCanReadProject(resource.data.projectId));
      allow create, update: if sasCanWriteBudget('Add') || sasCanWriteBudget('Edit');
      allow delete: if sasCanWriteBudget('Delete');
    }

    /**
     * Expense categories — the module's shared vocabulary.
     *
     * Every expense form needs to read them, so reads are open to signed-in users. Renaming one now
     * rewrites the name across historical expenses and category budgets, which is why writing is
     * restricted to the Expense Categories resource rather than to anyone who can add an expense.
     */
    match /siteAccountCategories/{categoryId} {
      allow get, list: if signedIn();
      allow create, update: if sasPerm('Expense Categories', 'Add') || sasPerm('Expense Categories', 'Edit');
      allow delete: if sasPerm('Expense Categories', 'Delete');
    }

    /** Module settings, including the Field Control configuration every form subscribes to. */
    match /siteAccountSettings/{docId} {
      allow get, list: if signedIn();
      allow create, update, delete: if sasPerm('Field Control', 'Edit')
        || sasPerm('Field Control', 'Add')
        || sasPerm('Project Settings', 'Edit');
    }

    /** Who gets told when a budget threshold is crossed. */
    match /siteAccountBudgetAlertConfigs/{configId} {
      allow get, list: if signedIn();
      allow create, update: if sasPerm('Budget Alerts', 'Add')
        || sasPerm('Budget Alerts', 'Edit')
        || sasPerm('Project Settings', 'Edit');
      allow delete: if sasPerm('Budget Alerts', 'Delete');
    }

    /**
     * Which thresholds have already fired.
     *
     * Bookkeeping, not a record anybody reads directly. It has to be writable by whoever is
     * recording the expense that trips a threshold — the alert runs in their browser — and
     * deletable by them too, since editing a budget or removing an expense now clears the entries
     * that a changed threshold line has made meaningless.
     */
    match /siteAccountBudgetAlertState/{stateId} {
      allow get, list, create, update, delete: if signedIn();
    }

    /**
     * Roles.
     *
     * Every signed-in user needs to read the roles collection — the resolver looks up additional
     * roles by id, and `AuthProvider` has always read the user's own role to get their permissions.
     * Writing a role is what changes what a role means for everybody holding it, so it stays behind
     * Role Management's own permission.
     */
    match /roles/{roleId} {
      allow get, list: if signedIn();
      allow create, update: if holdsPermission('Settings.Role Management', 'Add')
        || holdsPermission('Settings.Role Management', 'Edit');
      allow delete: if holdsPermission('Settings.Role Management', 'Delete');
    }

    /* ── Office Hub (docs/office-hub.md) ──────────────────────────────────────────────────────
     *
     * Meetings, tasks, decisions, teams and minutes. §49 of the module's specification is the
     * point of this block: the browser decides what to *render*, and these rules decide what can
     * actually be read and written. A front-end permission check is a courtesy; this is the control.
     *
     * ── The shape of the rules, and its one honest limitation ────────────────────────────────
     *
     * Firestore rules cannot run a query, so a rule cannot ask "is this user a participant of the
     * meeting this agenda item belongs to?" without a `get()` per document — which on a list of
     * fifty agenda items is fifty extra reads, billed, on every render. So the rules are built
     * around fields that live *on the document being accessed*:
     *
     *   • A **meeting** carries `participantUserIds`, so participant access is a single
     *     `in` test against the requester with no extra reads. That is exactly why the service
     *     denormalises that array (see `office-hub.ts`).
     *   • A **task** carries `assigneeId`, `createdBy` and `watcherUserIds`, for the same reason.
     *   • The **child collections** — participants, agenda, notes, attendance, documents — are
     *     readable by any signed-in user who can open the module, and writable only by somebody
     *     holding the corresponding module permission. This is deliberately *coarser* than the UI,
     *     which additionally requires you to be the organizer. It is coarser because tightening it
     *     needs the parent-meeting `get()` described above; if an installation decides the read cost
     *     is worth it, the commented `isMeetingParticipant()` helper below is the change to make.
     *
     * ── What is genuinely closed here ────────────────────────────────────────────────────────
     *
     *   • **Nothing is hard-deletable** except a participant row (removing somebody from an
     *     invitation) and an agenda item. Meetings, tasks, decisions, action items and teams are
     *     soft-deleted by the application (§83), so `allow delete: if false` is not a restriction
     *     the app has to work around — it is the app's own model expressed as a rule.
     *   • **Reminders and counters are server-only.** A client that could write a reminder row
     *     could schedule a notification as anybody; a client that could write a counter could
     *     duplicate a reference number. Both are written by the Admin SDK, which bypasses rules.
     *   • **A participant may only answer their own invitation.** The update rule pins
     *     `userId` to the requester for the response fields.
     *   • **Settings are read by everyone and written by administrators.** Every screen reads them.
     */

    function canOpenOfficeHub() {
      return signedIn() && rolePermissions() != null && (
        rolePermissions()['Office Hub'] != null
        || rolePermissions()['Office Hub.Meetings'] != null
        || rolePermissions()['Office Hub.Tasks'] != null
        || rolePermissions()['Office Hub.Dashboard'] != null
      );
    }

    function officeHubHolds(page, action) {
      return holdsPermission('Office Hub.' + page, action);
    }

    /**
     * Whether the requester is named on this meeting.
     *
     * Reads only the document being accessed, so it costs nothing extra. The child-collection rules
     * could call a `get()`-based variant of this against their parent meeting; see the note above
     * for why they do not by default.
     */
    function isOfficeHubMeetingMember(meeting) {
      return signedIn() && (
        meeting.organizerId == request.auth.uid
        || (meeting.participantUserIds is list && request.auth.uid in meeting.participantUserIds)
      );
    }

    match /officeHubMeetings/{meetingId} {
      allow get, list: if canOpenOfficeHub() && (
        officeHubHolds('Meetings', 'View All')
        || officeHubHolds('Meetings', 'View Department')
        || officeHubHolds('Meetings', 'View Team')
        // A participant can always read their own meeting, however narrow their grant.
        || isOfficeHubMeetingMember(resource.data)
      );
      allow create: if officeHubHolds('Meetings', 'Create');
      allow update: if officeHubHolds('Meetings', 'Edit')
        || officeHubHolds('Meetings', 'Cancel')
        || officeHubHolds('Meetings', 'Reschedule')
        || officeHubHolds('Meetings', 'Manage Participants')
        // The organizer edits their own meeting without needing a role permission: organising a
        // meeting *is* the authority over it. See `office-hub-permissions.ts`.
        || resource.data.organizerId == request.auth.uid;
      // Soft-deleted through `isDeleted`, never removed (§83).
      allow delete: if false;
    }

    match /officeHubParticipants/{participantId} {
      allow get, list: if canOpenOfficeHub();
      allow create: if officeHubHolds('Meetings', 'Create')
        || officeHubHolds('Meetings', 'Manage Participants');
      allow update: if officeHubHolds('Meetings', 'Manage Participants')
        || officeHubHolds('Attendance', 'Record')
        // Answering your own invitation. The document id is `<meetingId>_<userId>`, and `userId` is
        // immutable here, so this cannot be used to answer on somebody else's behalf.
        || (resource.data.userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid);
      // Removing somebody from an invitation list is a real removal, not an archive: the
      // invitation should stop existing rather than linger as a cancelled one.
      allow delete: if officeHubHolds('Meetings', 'Manage Participants');
    }

    match /officeHubAgenda/{agendaId} {
      allow get, list: if canOpenOfficeHub();
      allow create, update: if officeHubHolds('Agenda', 'Add')
        || officeHubHolds('Agenda', 'Edit')
        || officeHubHolds('Meetings', 'Create')
        || officeHubHolds('Meetings', 'Edit');
      allow delete: if officeHubHolds('Agenda', 'Delete') || officeHubHolds('Meetings', 'Edit');
    }

    /** One notes document per meeting, keyed by the meeting id. Auto-saved during the meeting. */
    match /officeHubNotes/{meetingId} {
      allow get, list: if canOpenOfficeHub();
      allow create, update: if officeHubHolds('Minutes', 'Prepare')
        || officeHubHolds('Meetings', 'Create')
        || officeHubHolds('Meetings', 'Edit');
      allow delete: if false;
    }

    match /officeHubMom/{meetingId} {
      allow get, list: if canOpenOfficeHub();
      allow create, update: if officeHubHolds('Minutes', 'Prepare')
        || officeHubHolds('Minutes', 'Review')
        || officeHubHolds('Minutes', 'Approve')
        || officeHubHolds('Minutes', 'Publish')
        || officeHubHolds('Meetings', 'Create');
      // The minutes are the record of the meeting. They are superseded, never deleted.
      allow delete: if false;
    }

    match /officeHubDecisions/{decisionId} {
      allow get, list: if canOpenOfficeHub() && (
        officeHubHolds('Decisions', 'View')
        || officeHubHolds('Decisions', 'View All')
        || resource.data.ownerId == request.auth.uid
      );
      allow create: if officeHubHolds('Decisions', 'Create');
      allow update: if officeHubHolds('Decisions', 'Edit')
        || officeHubHolds('Decisions', 'Close')
        || resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    match /officeHubActionItems/{itemId} {
      allow get, list: if canOpenOfficeHub();
      allow create: if officeHubHolds('Action Items', 'Create')
        || officeHubHolds('Meetings', 'Create');
      allow update: if officeHubHolds('Action Items', 'Edit')
        || officeHubHolds('Action Items', 'Complete')
        || officeHubHolds('Action Items', 'Convert to Task')
        || resource.data.responsibleUserId == request.auth.uid;
      allow delete: if false;
    }

    match /officeHubTasks/{taskId} {
      allow get, list: if canOpenOfficeHub() && (
        officeHubHolds('Tasks', 'View All')
        || officeHubHolds('Tasks', 'View Department')
        || officeHubHolds('Tasks', 'View Team')
        // Your own work, and anything you raised or are following, regardless of grant.
        || resource.data.assigneeId == request.auth.uid
        || resource.data.createdBy == request.auth.uid
        || (resource.data.watcherUserIds is list
            && request.auth.uid in resource.data.watcherUserIds)
      );
      allow create: if officeHubHolds('Tasks', 'Create');
      allow update: if officeHubHolds('Tasks', 'Edit')
        || officeHubHolds('Tasks', 'Assign')
        || officeHubHolds('Tasks', 'Complete')
        || officeHubHolds('Tasks', 'Delete')
        // The assignee owns their own work; a task whose owner cannot update it never gets updated.
        || resource.data.assigneeId == request.auth.uid
        || resource.data.createdBy == request.auth.uid;
      allow delete: if false;
    }

    match /officeHubTaskComments/{commentId} {
      allow get, list: if canOpenOfficeHub();
      allow create: if officeHubHolds('Tasks', 'Comment') || officeHubHolds('Tasks', 'View');
      // Edits rewrite history on a thread other people have read, so a comment is amended by
      // adding another, never by changing the one that was posted.
      allow update, delete: if false;
    }

    /** Append-only. An activity trail that can be edited is not a trail. */
    match /officeHubTaskActivity/{entryId} {
      allow get, list: if canOpenOfficeHub();
      allow create: if canOpenOfficeHub();
      allow update, delete: if false;
    }

    match /officeHubTeams/{teamId} {
      allow get, list: if canOpenOfficeHub();
      allow create: if officeHubHolds('Teams', 'Create');
      allow update: if officeHubHolds('Teams', 'Edit')
        || officeHubHolds('Teams', 'Manage Members')
        || officeHubHolds('Teams', 'Change Leader')
        || officeHubHolds('Teams', 'Archive')
        // The team leader manages their own team.
        || resource.data.leaderId == request.auth.uid;
      // Archived, never deleted: every past meeting and task still names the team (§6).
      allow delete: if false;
    }

    match /officeHubDocuments/{documentId} {
      allow get, list: if canOpenOfficeHub();
      allow create: if officeHubHolds('Documents', 'Upload');
      // Soft-deleted, so a file referenced by published minutes cannot vanish from them.
      allow update: if officeHubHolds('Documents', 'Delete')
        || resource.data.uploadedById == request.auth.uid;
      allow delete: if false;
    }

    /**
     * Reminder rows are written by the client when a meeting or task is saved, and consumed by the
     * cron route.
     *
     * **Reads are pinned to the requester; writes deliberately are not.** An organizer scheduling a
     * meeting has to write a reminder row for each participant, so a create rule that pinned
     * `userId` to the requester would break the feature entirely. What the read pin buys is
     * privacy: a user can see the reminders addressed to them and nobody else's, so this collection
     * cannot be used to enumerate who is being reminded about what.
     *
     * The residual exposure is that a user who can open the module could create a reminder row
     * addressed to somebody else, which the sweep would turn into a notification. It is bounded by
     * the sweep only rendering copy from the entity the row points at — so the worst case is an
     * unwanted reminder about a real meeting or task, not arbitrary text. Closing it properly needs
     * a `get()` on the parent meeting to check the requester is its organizer; the trade is the same
     * one described at the top of this block.
     */
    match /officeHubReminders/{reminderId} {
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if canOpenOfficeHub()
        && request.resource.data.userId is string
        && request.resource.data.entityId is string
        && request.resource.data.status == 'Scheduled';
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /officeHubMeetingTemplates/{templateId} {
      allow get, list: if canOpenOfficeHub();
      allow create, update: if officeHubHolds('Templates', 'Add')
        || officeHubHolds('Templates', 'Edit');
      allow delete: if false;
    }

    match /officeHubAgendaTemplates/{templateId} {
      allow get, list: if canOpenOfficeHub();
      allow create, update: if officeHubHolds('Templates', 'Add')
        || officeHubHolds('Templates', 'Edit');
      allow delete: if false;
    }

    /** Office-wide configuration. Read by every screen; written by administrators. */
    match /officeHubSettings/{docId} {
      allow get, list: if signedIn();
      allow create, update: if officeHubHolds('Settings', 'Edit');
      allow delete: if false;
    }

    /** A user's own preferences. Nobody else's, including an administrator's. */
    match /officeHubUserSettings/{userId} {
      allow get, list: if signedIn() && userId == request.auth.uid;
      allow create, update: if signedIn() && userId == request.auth.uid;
      allow delete: if false;
    }

    /**
     * Reference-number counters. Server-only.
     *
     * The client allocates references through a transaction on these documents, which needs write
     * access — so this is one place where the rule is deliberately looser than "server-only" would
     * be, and the compensating control is that a counter can only ever be *incremented* by the
     * transaction's read-then-write. A counter a client could set freely would let two records
     * share a reference number.
     */
    match /officeHubCounters/{counterId} {
      allow get: if canOpenOfficeHub();
      // `resource` is null on a create, so that case is tested separately rather than through a
      // property on it. The first allocation must start at 1; every later one must be exactly the
      // stored value plus one, which is what stops two records being given the same reference.
      allow create: if canOpenOfficeHub()
        && request.resource.data.value == 1;
      allow update: if canOpenOfficeHub()
        && request.resource.data.value is int
        && request.resource.data.value == resource.data.value + 1;
      allow list, delete: if false;
    }

    /** Written only by the cron route, through the Admin SDK. */
    match /officeHubAttendanceLog/{entryId} {
      allow get, list: if canOpenOfficeHub();
      allow write: if false;
    }

    /**
     * Google OAuth credentials. Closed to every client, including the owner's.
     *
     * The strictest block in this file, and the only Office Hub collection a signed-in user cannot
     * read their own document from. Each holds an AES-256-GCM envelope around a Google **refresh
     * token** — a standing grant to read and write that person's calendar that does not expire on
     * its own. A rule allowing `userId == request.auth.uid` would look reasonable and would mean any
     * XSS in the application, or any leaked ID token, could exfiltrate the envelope; combined with
     * an `OFFICE_HUB_GOOGLE_TOKEN_KEY` that leaks separately, that is a live grant.
     *
     * Nothing in the client needs it. `office-hub-google-server.ts` is the sole accessor, through
     * the Admin SDK, which bypasses these rules; the browser learns whether it is connected from
     * `GET /api/office-hub/google/status`, which returns a redacted view with no token in it. If
     * this rule and that file ever disagree, this one is right.
     */
    match /officeHubGoogleConnections/{userId} {
      allow read, write: if false;
    }
  }
}
