rules_version = '2';

/**
 * Firestore security rules — the live ruleset. Deploy with `firebase deploy --only firestore:rules`
 * after `npm test` in tests/firestore-rules passes; never paste a partial ruleset into the console.
 *
 * ── Where this stands (2026-10-13) ──────────────────────────────────────────────────────────────
 *
 * From 2025-09-05 to 2026-10-13 the database ran `allow read, write: if true`, open to anyone.
 * These rules are being tightened in stages, each tested in the emulator and published on its own:
 *
 *   Stage 1: collections only the server touches are closed to every browser, and
 *     collections the browser only reads cannot be written from it. Everything else is still open
 *     to any signed-in user, through the transitional catch-all at the bottom.
 *   Stage 2 (under way; see ownRules): per-module rules on the user's resolved permissions (`userPermissions/{authUid}`,
 *     written by the server — see src/lib/access-rules-permissions.ts), module by module, each one
 *     taken out of the catch-all as it gets rules of its own.
 *
 * The inventory behind the lists below — every collection, which code reads and writes it from the
 * browser, and under what check — was built from the code on 2026-10-13. A collection a browser
 * starts reading or writing has to be moved out of these lists first, or that screen will fail.
 *
 * ── Two constraints any future block must respect ──────────────────────────────────────────────
 *
 *   - The browser filters "my" records by the `users` document id (`useAuth().user.id`), which is
 *     not always the auth uid (email-matched legacy accounts, and impersonation). A rule comparing a
 *     field with `request.auth.uid` will refuse those users; use `userPermissions` instead.
 *   - Rules are OR'd. A block that allows nothing does not close a collection the catch-all still
 *     matches, which is why the catch-all tests the lists rather than relying on narrower blocks.
 *     And a block whose condition errors (a `get()` of a missing document) has been seen to refuse
 *     requests another block allows, so per-module blocks must guard every `get()` with `exists()`.
 *
 * The previous draft of per-module rules (written for role ids equal to role names, which is not
 * true here) is in git history at 661bbd16:firestore.rules.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /*
     * Collections no browser reads or writes. Their screens go through API routes on the Admin
     * SDK, which these rules do not apply to. Mail Hub's and Bill Tracking's settings pages probe
     * these from the browser and expect to be refused.
     */
    function serverOnly(collection) {
      return collection in [
        'billTrackingActivity', 'billTrackingBills', 'billTrackingCollections', 'billTrackingComments',
        'billTrackingConfig', 'billTrackingCounters', 'billTrackingDocuments', 'billTrackingFollowUps',
        'billTrackingImportJobs', 'billTrackingRetention', 'billTrackingSavedViews', 'billTrackingTargets',
        'chatConversations',
        // Employee trip claims (Driver Management): every read and write goes through
        // /api/driver-management on the Admin SDK (src/lib/employee-trips).
        'employeeTripClaims', 'employeeTripCounters', 'employeeTripRecords', 'employeeTripSettings',
        // SEL Fleet (docs/fleet): every read and write goes through /api/fleet on the Admin SDK
        // (src/lib/fleet/server) — approvals, daily summaries, geofences, payment reports, purposes,
        // settings, photo records, and the geofence arrivals synced from a trip. The photos
        // themselves are in Storage under fleet/, closed in storage.rules.
        'fleetApprovals', 'fleetDailySummary', 'fleetGeofences', 'fleetPaymentReports', 'fleetPurposes',
        'fleetSettings', 'fleetUploads', 'vehicleManagementTripGeofenceEvents',
        // Once-only markers the scheduled jobs (digest, service due) write.
        'fleetJobRuns',
        // Only ever used to mint ids: doc(collection(db, 'contraIds')).id — nothing is read or written.
        'contraIds',
        'employeeAttendance', 'employeeLeaveBalance', 'employeeSensitive', 'employeeSwipes',
        'greythrLinkAudit', 'greythrSyncRuns',
        'inventoryApprovalHistory', 'inventoryIdempotency', 'inventoryNumberSequences',
        'locationTrackingAccessSessions', 'locationTrackingOtpChallenges', 'locationTrackingOtpRateLimits',
        'mailHubAccounts', 'mailHubAuditEvents', 'mailHubBodies', 'mailHubCredentials', 'mailHubFolders',
        'mailHubFollowUps', 'mailHubJobs', 'mailHubLinks', 'mailHubMailboxMembers', 'mailHubMessages',
        'mailHubNotes', 'mailHubOAuthStates', 'mailHubOutbound', 'mailHubRoutingRules', 'mailHubSettings',
        'mailHubSharedMailboxes', 'mailHubSignatures', 'mailHubSyncCursors', 'mailHubTemplates',
        'mailHubThreads', 'mailHubUploads', 'mailHubUserSettings',
        'news', 'team',
        'officeHubAttendanceLog', 'officeHubGoogleConnections',
        'recurringPaymentAutomationRuns',
        // The reporting copy's schedule and run state; only its API routes read or write them.
        'reportingCopy',
        'userAppearance', 'userPermissions',
        'windowsApplicationUsage', 'windowsDeviceAssignments', 'windowsNotificationReceipts',
        'workCalls', 'workContacts'
      ];
    }

    /** Collections the browser reads but only the server writes. */
    function browserReadOnly(collection) {
      return collection in [
        'categories',
        'greythrCurrentRoster',
        'inventoryBalances', 'inventoryDocuments', 'inventoryItems', 'inventoryLocations',
        'inventoryStockCounts', 'stockLedger',
        'recurringPaymentAutomationLogs', 'recurringPaymentNotificationQueue',
        'userLocationSettings'
      ];
    }

    /** Collections with rules of their own (stage 2). The catch-all leaves them alone. */
    function ownRules(collection) {
      return collection in [
        'windowsAgentPolicies', 'windowsAgentVersions', 'windowsAppCatalog', 'windowsAuditLogs',
        'windowsEnrollmentCodes', 'windowsHeartbeats',
        'windowsActivityEvents', 'windowsAgentSettings', 'windowsDailyActivity', 'windowsDevices',
        'windowsNotifications', 'windowsSessions', 'windowsUserAccess',
        'eApprovalAttachments', 'eApprovalComments', 'eApprovalCounters', 'eApprovalDelegations',
        'eApprovalDepartmentRouting', 'eApprovalHistory', 'eApprovalProjectRouting', 'eApprovalRequests',
        'eApprovalRules', 'eApprovalSettings', 'eApprovalSignatures', 'eApprovalSteps',
        'eApprovalTemplates', 'eApprovalTypes', 'eApprovalVersions', 'paymentObligations',
        'recurringPaymentApprovalRules', 'recurringPaymentAutomationLogs', 'recurringPaymentCategories', 'recurringPaymentMasters',
        'recurringPaymentNotificationQueue', 'recurringPaymentNotificationRules', 'recurringPaymentSettings', 'recurringPaymentVendors',
        'siteAccountBudgetAlertConfigs', 'siteAccountBudgetAlertState', 'siteAccountBudgetAllocations', 'siteAccountBudgetApprovals',
        'siteAccountBudgets', 'siteAccountCategories', 'siteAccountCategoryBudgets', 'siteAccountExpenses',
        'siteAccountPayments', 'siteAccountProjects', 'siteAccountSettings', 'siteAccountTenderBudgets',
        'siteFundRequestProjects', 'siteFundRequests',
        'candidateApplications', 'candidates', 'compensationApprovals', 'hrActivities',
        'hrCounters', 'hrEscalations', 'hrManpowerPlans', 'hrRecruitmentCosts',
        'hrReferrals', 'hrRequirementApprovals', 'hrRequirementTemplates', 'hrRequirements',
        'hrSettings', 'interviewFeedback', 'interviews', 'jobDescriptions',
        'joiningRecords', 'offers', 'preJoining', 'recruitmentAgencies',
        'recruitmentSources', 'selectionProposals', 'talentPools', 'bankAccounts',
        'bankBalanceCounters', 'bankBalanceSettings', 'bankExpenses', 'bankInstrumentNos',
        'bankPayments', 'loans', 'monthlyInterest', 'paymentMethods',
        'insuranceCompanies', 'insuranceTasks', 'insurance_policies', 'insuredAssets',
        'policyCategories', 'policyHolders', 'project_insurance_policies',
        'officeHubActionItems', 'officeHubAgenda', 'officeHubAgendaTemplates', 'officeHubCounters',
        'officeHubDecisions', 'officeHubDocuments', 'officeHubMeetingTemplates', 'officeHubMeetings',
        'officeHubMom', 'officeHubNotes', 'officeHubParticipants', 'officeHubReminders',
        'officeHubSettings', 'officeHubTaskActivity', 'officeHubTaskComments', 'officeHubTasks',
        'officeHubTeams', 'officeHubUserSettings', 'accountHeads', 'departmentSerialConfigs',
        'expenseRequests', 'expensesSettings', 'subAccountHeads', 'dailyRequisitionSettings',
        'dailyRequisitions', 'requisitions', 'vehicleManagementDocuments', 'vehicleManagementDriver',
        'vehicleManagementDriverAssignments', 'vehicleManagementDriverDailyStatus', 'vehicleManagementEmployeeTrips', 'vehicleManagementFitness',
        'vehicleManagementFuelLogs', 'vehicleManagementInsurance', 'vehicleManagementInsuranceWorkflowActivities', 'vehicleManagementInsuranceWorkflowCases',
        'vehicleManagementMaintenanceLogs', 'vehicleManagementPermit', 'vehicleManagementPuc', 'vehicleManagementRoadTax',
        'vehicleManagementSettings', 'vehicleManagementTripLocations', 'vehicleManagementTrips', 'vehicleManagementVehicles'
      ];
    }

    /* ── The signed-in user's resolved permissions ──────────────────────────────────────────────
     *
     * `userPermissions/{authUid}.p` maps each held resource to its actions, aliases expanded: the
     * same answer `useAuthorization().can` gives. Only the server writes it (at every app load, on
     * user creation, and when Access Management asks). One `get()`, cached for the request. No
     * document, or a deactivated user's empty one, holds nothing.
     */
    function permissionsPath() {
      return /databases/$(database)/documents/userPermissions/$(request.auth.uid);
    }

    function hasPermissions() {
      return signedIn() && exists(permissionsPath());
    }

    function holds(resource, action) {
      return hasPermissions() && get(permissionsPath()).data.p.get(resource, []).hasAny([action]);
    }

    /** Any action on any of these resources: how a module decides whether you may open it. */
    function holdsAnyOf(resources) {
      return hasPermissions() && get(permissionsPath()).data.p.keys().hasAny(resources);
    }

    /* ── Readable before sign-in ─────────────────────────────────────────────────────────────── */

    /** The sign-in page shows the company's branding before anyone has signed in. */
    match /settings/appearance {
      allow get: if true;
    }

    /* ── Server-written documents a person may read their own copy of ───────────────────────── */

    /** The resolved permissions the rules will read in stage 2. Written only by the server. */
    match /userPermissions/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    /* ── Searches across every project's subcollection ──────────────────────────────────────────
     *
     * A collection-group query is checked against rules that match the group at any depth, which
     * the catch-all below (keyed on the top-level collection) does not. These are the groups the
     * browser searches: billing, work orders and subcontractor records under projects/{id}, the
     * project-management approval queues, and Recurring Payments' transactions.
     */
    match /{path=**}/bills/{id} { allow read: if signedIn(); }
    match /{path=**}/workOrders/{id} { allow read: if signedIn(); }
    match /{path=**}/proformaBills/{id} { allow read: if signedIn(); }
    match /{path=**}/subcontractors/{id} { allow read: if signedIn(); }
    match /{path=**}/jmcEntries/{id} { allow read: if signedIn(); }
    match /{path=**}/indents/{id} { allow read: if signedIn(); }
    match /{path=**}/poIssueApprovals/{id} { allow read: if signedIn(); }
    match /{path=**}/mcClearanceApprovals/{id} { allow read: if signedIn(); }
    match /{path=**}/rfqAwardApprovals/{id} { allow read: if signedIn(); }
    match /{path=**}/inspectionResultApprovals/{id} { allow read: if signedIn(); }
    match /{path=**}/surveyEntries/{id} { allow read: if signedIn(); }

    /* ── Windows Agent administration (src/lib/windows-agent-permissions.ts) ────────────────────
     *
     * The live board, enrolment codes, policies, the application catalogue, published builds and
     * the audit trail. Sessions, activity, devices, access and settings have their own block below.
     */
    function windowsAgentUser() {
      return holdsAnyOf([
        'Windows Agent', 'Windows Agent.Dashboard', 'Windows Agent.Live Users', 'Windows Agent.Devices',
        'Windows Agent.Enrollment Codes', 'Windows Agent.Sessions', 'Windows Agent.Activity',
        'Windows Agent.Attendance', 'Windows Agent.Applications', 'Windows Agent.Reports',
        'Windows Agent.Notifications', 'Windows Agent.Policies', 'Windows Agent.Agent Versions',
        'Windows Agent.Audit Logs', 'Windows Agent.Monitoring Policy'
      ]);
    }

    /** What every colleague has on screen right now. Its own permission and nothing else. */
    match /windowsHeartbeats/{deviceId} {
      allow read: if holds('Windows Agent.Live Users', 'View');
    }

    /*
     * A code is the one credential in the module a person types: anyone who could list them could
     * enrol a machine of their own. The registration count is the server's; lowering it would
     * reopen an exhausted code.
     */
    match /windowsEnrollmentCodes/{code} {
      allow read: if holds('Windows Agent.Enrollment Codes', 'Create');
      allow create: if holds('Windows Agent.Enrollment Codes', 'Create')
        && request.resource.data.get('registrationCount', 0) == 0;
      allow update: if holds('Windows Agent.Enrollment Codes', 'Create')
        && request.resource.data.get('registrationCount', 0) == resource.data.get('registrationCount', 0);
    }

    /** The thresholds activity is measured against: readable by anyone in the module. */
    match /windowsAgentPolicies/{policyId} {
      allow read: if windowsAgentUser();
      allow write: if holds('Windows Agent.Policies', 'Edit');
    }

    match /windowsAppCatalog/{processKey} {
      allow read: if windowsAgentUser();
      allow create, update: if holds('Windows Agent.Applications', 'Categorise');
    }

    /** Published builds: what every agent installs as SYSTEM. Publishing is a deployment right. */
    match /windowsAgentVersions/{version} {
      allow read: if windowsAgentUser();
      allow create, update: if holds('Windows Agent.Agent Versions', 'Publish');
    }

    /** Append-only for everybody: an audit trail an administrator can edit is not one. */
    match /windowsAuditLogs/{entryId} {
      allow read: if holds('Windows Agent.Audit Logs', 'View');
      allow create: if windowsAgentUser();
    }

    /* ── E-Approval (src/lib/permissions.ts, "E-Approval"; src/lib/e-approval-service.ts) ───────────
     *
     * Who may see a request is decided by the engine (`canViewEApproval`) from facts the rules
     * cannot reach: department and project membership come from this module's own routing
     * documents (not `userPermissions.departmentIds/projectIds`), designations are not in
     * `userPermissions` at all, a delegate's inbox queries the *delegator's* id, delegations have
     * auto ids, and past actors are recorded only on the steps. So the request, its steps, history,
     * comments, attachments and versions are readable by anyone in the module — every queue, the
     * registers, the reports and the escalation run read them that way — and closed to everyone
     * else. Writes are where the rules can say more: identities that are stamped, drafts that are
     * private to their requester, deletions that have their own grants, configuration that has its
     * own pages.
     *
     * Recurring Payments mirrors its obligations here (src/lib/recurring-payments-e-approval-service.ts)
     * from the browser of whoever opens a payment, with `requesterId` set to the obligation's owner.
     * Those people need not hold anything in E-Approval, so a request whose `source` points at an
     * obligation is also open to whoever may work that obligation: any Recurring Payments grant, or
     * being named on it (the same fields Recurring Payments' own rules accept).
     *
     * Names are `users` document ids (`userPermissions.userDocId`), never the auth uid. Budget: the
     * permissions document (1), the parent request for a child record (1), the linked obligation
     * (1) — 3 of 10; a transition transaction touches the same three paths for every document.
     */
    function eaUser() {
      return holdsAnyOf([
        'E-Approval', 'E-Approval.Dashboard', 'E-Approval.Requests', 'E-Approval.Inbox',
        'E-Approval.Comments', 'E-Approval.Attachments', 'E-Approval.Audit Trail', 'E-Approval.Reversals',
        'E-Approval.Reports', 'E-Approval.Delegations', 'E-Approval.Settings',
        'E-Approval.Settings.Approval Types', 'E-Approval.Settings.Workflow Templates',
        'E-Approval.Settings.Approval Matrix', 'E-Approval.Settings.Department Routing',
        'E-Approval.Settings.Project Routing', 'E-Approval.Settings.Policies'
      ]);
    }

    function eaHolds(page, actions) {
      return hasPermissions() && get(permissionsPath()).data.p.get('E-Approval.' + page, []).hasAny(actions);
    }

    /** The caller's `users` id; '' when unknown, which then matches no one. */
    function eaMe() {
      return hasPermissions() ? get(permissionsPath()).data.get('userDocId', '') : '';
    }

    function eaIsMe(userId) {
      return eaMe() != '' && userId == eaMe();
    }

    function eaRequest(approvalId) {
      return /databases/$(database)/documents/eApprovalRequests/$(approvalId);
    }

    /** A request raised by the Recurring Payments bridge for one obligation. */
    function eaIsMirror(data) {
      return data.get('source', null) is map
        && data.source.get('module', '') == 'Recurring Payments'
        && data.source.get('recordId', '') is string
        && data.source.get('recordId', '') != '';
    }

    function eaRpModuleUser() {
      return holdsAnyOf([
        'Recurring Payments', 'Recurring Payments.Dashboard', 'Recurring Payments.Payments',
        'Recurring Payments.Approvals', 'Recurring Payments.Payment Processing',
        'Recurring Payments.Recurring Masters', 'Recurring Payments.Vendors',
        'Recurring Payments.Categories', 'Recurring Payments.Reports', 'Recurring Payments.Settings'
      ]);
    }

    /** Named on the obligation: what lets someone with no Recurring Payments grant work it. */
    function eaRpNamed(obligation) {
      let me = eaMe();
      return me != '' && (
        obligation.get('assignees', []).hasAny([me])
        || obligation.get('assignedTo', '') == me
        || obligation.get('backupAssignedTo', '') == me
        || obligation.get('verifierId', '') == me
        || obligation.get('approverId', '') == me
        || obligation.get('accountsProcessorId', '') == me
        || obligation.get('approvalLevels', []).hasAny([me])
        || obligation.get('approvalCompletedBy', []).hasAny([me]));
    }

    /** May run the bridge for this mirrored request: works the obligation it mirrors. */
    function eaBridge(data) {
      return eaIsMirror(data) && (eaRpModuleUser() || eaWorksObligation(data.source.recordId));
    }

    function eaWorksObligation(paymentId) {
      let obligation = /databases/$(database)/documents/paymentObligations/$(paymentId);
      return hasPermissions() && exists(obligation) && eaRpNamed(get(obligation).data);
    }

    function eaBridgeForParent(approvalId) {
      return exists(eaRequest(approvalId)) && eaBridge(get(eaRequest(approvalId)).data);
    }

    /** Readers and writers of a request's steps, history and versions. */
    function eaChildAccess(approvalId) {
      return eaUser() || (hasPermissions() && eaBridgeForParent(approvalId));
    }

    /** The caller's own unsubmitted draft. */
    function eaOwnDraft(approvalId) {
      return exists(eaRequest(approvalId))
        && get(eaRequest(approvalId)).data.get('status', '') == 'Draft'
        && eaIsMe(get(eaRequest(approvalId)).data.get('requesterId', ''));
    }

    /**
     * Deleting a request takes its whole record with it (`deleteEApprovalRequest`), child records
     * first: Requests → Delete for any request, Delete Draft for your own draft.
     */
    function eaChildDelete(approvalId) {
      return eaHolds('Requests', ['Delete'])
        || (eaHolds('Requests', ['Delete Draft']) && eaOwnDraft(approvalId));
    }

    function eaUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    match /eApprovalRequests/{approvalId} {
      // Every register, inbox, report, the dashboards on / and /my-work (which also need View
      // Module), and the escalation run list requests across the organisation.
      allow read: if eaUser();
      // The bridge opens its own request by id, and learns that a deleted one has gone.
      allow get: if signedIn() && (resource == null || (hasPermissions() && eaBridge(resource.data)));

      // A draft from the form, as its requester; or the bridge's mirror, raised for the obligation's
      // owner and submitted in the same breath.
      allow create: if request.resource.data.get('status', '') == 'Draft' && (
        (eaHolds('Requests', ['Create']) && eaIsMe(request.resource.data.get('requesterId', '')))
        || (hasPermissions() && eaBridge(request.resource.data)));

      // Transitions are decided by step assignment, which the rules cannot see, so anyone in the
      // module may move a submitted request. Who raised it and where it belongs never change, a
      // draft is its requester's alone, and only the bridge repoints a mirror's source.
      allow update: if eaUnchanged(['requesterId', 'organizationId'])
        && (eaUser() || (hasPermissions() && eaBridge(resource.data)))
        && (resource.data.get('status', '') != 'Draft'
          || eaIsMe(resource.data.get('requesterId', ''))
          || eaBridge(resource.data))
        && (eaUnchanged(['source']) || eaBridge(resource.data));

      allow delete: if eaHolds('Requests', ['Delete'])
        || (eaHolds('Requests', ['Delete Draft']) && resource.data.get('status', '') == 'Draft'
          && eaIsMe(resource.data.get('requesterId', '')));
    }

    /*
     * The workflow. Steps are written by every transition and deleted by a recall, so anyone who may
     * move a request may write them; they never move to another request.
     */
    match /eApprovalSteps/{stepId} {
      allow read: if eaChildAccess(resource.data.approvalId);
      allow create: if eaChildAccess(request.resource.data.approvalId);
      allow update: if eaChildAccess(resource.data.approvalId) && eaUnchanged(['approvalId']);
      allow delete: if eaUser();
    }

    /** Append-only: a transition adds entries and nothing edits one. */
    match /eApprovalHistory/{entryId} {
      allow read: if eaChildAccess(resource.data.approvalId);
      allow create: if eaChildAccess(request.resource.data.approvalId);
      allow delete: if eaChildDelete(resource.data.approvalId);
    }

    /** Superseded content, written by a material-change resubmission. */
    match /eApprovalVersions/{versionId} {
      allow read: if eaChildAccess(resource.data.approvalId);
      allow create: if eaChildAccess(request.resource.data.approvalId);
      allow delete: if eaChildDelete(resource.data.approvalId);
    }

    /** Comments Add to post, as yourself; only the author edits or retracts, and only the text. */
    match /eApprovalComments/{commentId} {
      allow read: if eaChildAccess(resource.data.approvalId);
      allow create: if eaHolds('Comments', ['Add'])
        && eaIsMe(request.resource.data.get('authorId', ''));
      allow update: if eaIsMe(resource.data.get('authorId', ''))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'body', 'editHistory', 'retracted', 'retractedReason', 'updatedAt', 'updatedBy', 'updatedByName'
        ]);
      allow delete: if eaChildDelete(resource.data.approvalId);
    }

    /*
     * Files go up with the create form and with every action dialog, not only from the attachment
     * list, so anyone in the module may add one, as themselves. Never replaced; removed only from
     * the requester's own draft, or with the request.
     */
    match /eApprovalAttachments/{attachmentId} {
      allow read: if eaChildAccess(resource.data.approvalId);
      allow create: if eaUser() && eaIsMe(request.resource.data.get('uploadedById', ''));
      allow delete: if eaChildDelete(resource.data.approvalId) || eaOwnDraft(resource.data.approvalId);
    }

    /** One saved signature per person, keyed by their `users` id: their own, and nobody else's. */
    match /eApprovalSignatures/{userId} {
      allow get, create, update: if eaUser() && eaIsMe(userId);
    }

    /*
     * Reference numbers, allocated in a transaction on submission — by the requester, or by the
     * bridge before its mirror exists, so by whoever is signed in. Nothing secret; the sequence only
     * moves forward, which is what keeps two approvals from sharing a number.
     */
    match /eApprovalCounters/{counterId} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.get('nextSequence', 0) is int
        && request.resource.data.get('nextSequence', 0) > 1;
      allow update: if signedIn() && request.resource.data.get('nextSequence', 0) is int
        && request.resource.data.get('nextSequence', 0) > resource.data.get('nextSequence', 1);
    }

    /*
     * Configuration. Settings, routing and delegations are read by the engine for anyone who acts
     * (the bridge included) and by the work dashboard for every signed-in user; each is written
     * from its own settings page (`SettingsSection`: Edit or Add on `Settings.<page>`).
     */
    match /eApprovalSettings/{organizationId} {
      allow get: if signedIn();
      allow write: if eaHolds('Settings.Policies', ['Edit', 'Add']);
    }

    match /eApprovalDepartmentRouting/{departmentId} {
      allow read: if signedIn();
      allow write: if eaHolds('Settings.Department Routing', ['Edit', 'Add']);
    }

    match /eApprovalProjectRouting/{projectId} {
      allow read: if signedIn();
      allow write: if eaHolds('Settings.Project Routing', ['Edit', 'Add']);
    }

    /** Recurring Payments' bridge settings page lists the approval types too. */
    match /eApprovalTypes/{typeId} {
      allow read: if eaUser() || eaRpModuleUser();
      allow write: if eaHolds('Settings.Approval Types', ['Edit', 'Add', 'Delete']);
    }

    match /eApprovalTemplates/{templateId} {
      allow read: if eaUser() || eaRpModuleUser();
      allow write: if eaHolds('Settings.Workflow Templates', ['Edit', 'Add', 'Delete']);
    }

    match /eApprovalRules/{ruleId} {
      allow read: if eaUser() || eaRpModuleUser();
      allow write: if eaHolds('Settings.Approval Matrix', ['Edit', 'Add', 'Delete']);
    }

    /*
     * Your own cover with Delegations Add or Edit; somebody else's needs Manage Others as well
     * (`canManageEApprovalDelegationFor`), or anyone could route a colleague's approvals to themselves.
     */
    function eaMayDelegateFor(fromUserId) {
      return eaIsMe(fromUserId) || eaHolds('Delegations', ['Manage Others']);
    }

    match /eApprovalDelegations/{delegationId} {
      allow read: if signedIn();
      allow create: if eaHolds('Delegations', ['Add', 'Edit'])
        && eaMayDelegateFor(request.resource.data.get('fromUserId', ''))
        && request.resource.data.get('toUserId', '') != request.resource.data.get('fromUserId', '');
      allow update: if eaHolds('Delegations', ['Add', 'Edit'])
        && eaMayDelegateFor(resource.data.get('fromUserId', ''))
        && eaMayDelegateFor(request.resource.data.get('fromUserId', ''))
        && request.resource.data.get('toUserId', '') != request.resource.data.get('fromUserId', '');
      allow delete: if eaHolds('Delegations', ['Add', 'Edit', 'Delete'])
        && eaMayDelegateFor(resource.data.get('fromUserId', ''));
    }

    /* ── Recurring Payments (src/lib/permissions.ts, "Recurring Payments") ───────────────────────
     *
     * Three kinds of people work an obligation, and only the first holds a module permission:
     *
     *   - module users: any grant on a Recurring Payments page. They read the whole register, as
     *     every page in the module does (`where organizationId == org`), and write by the action
     *     their screen checks.
     *   - the people the obligation names: its current step `assignees`, the master's owner,
     *     backup, verifier, approver and processor, and the approvers of its approval rule. Being
     *     named is the authority to act (see use-assigned-workflow.ts), so they read their own
     *     obligations — by a query on the naming field — and the current assignees work the step.
     *   - E-Approval approvers acting on a request that mirrors an obligation: the bridge
     *     (src/lib/recurring-payments-e-approval-service.ts) moves the payment as them, with no
     *     Recurring Payments permission at all.
     *
     * Names are `users` document ids (`userPermissions.userDocId`), never the auth uid. Budget: the
     * permissions document (1), the parent obligation for a subcollection (1), the linked
     * E-Approval request (1) — 3 of 10 per request; a workflow transaction adds 2 per document.
     */
    function rpModuleUser() {
      return holdsAnyOf([
        'Recurring Payments', 'Recurring Payments.Dashboard', 'Recurring Payments.Payments',
        'Recurring Payments.Approvals', 'Recurring Payments.Payment Processing',
        'Recurring Payments.Recurring Masters', 'Recurring Payments.Vendors',
        'Recurring Payments.Categories', 'Recurring Payments.Reports', 'Recurring Payments.Settings'
      ]);
    }

    function rpHolds(page, actions) {
      return hasPermissions()
        && get(permissionsPath()).data.p.get('Recurring Payments.' + page, []).hasAny(actions);
    }

    /** The caller's `users` id; '' when unknown, which then matches no one (blank fields are ''). */
    function rpMe() {
      return hasPermissions() ? get(permissionsPath()).data.get('userDocId', '') : '';
    }

    /** Named on the obligation anywhere a workflow step can resolve its assignees from. */
    function rpNamed(data) {
      let me = rpMe();
      return me != '' && (
        data.get('assignees', []).hasAny([me])
        || data.get('assignedTo', '') == me
        || data.get('backupAssignedTo', '') == me
        || data.get('verifierId', '') == me
        || data.get('approverId', '') == me
        || data.get('accountsProcessorId', '') == me
        || data.get('approvalLevels', []).hasAny([me])
        || data.get('approvalCompletedBy', []).hasAny([me]));
    }

    /** On the obligation's current step: the one who may work it. */
    function rpAssignee(data) {
      let me = rpMe();
      return me != '' && data.get('assignees', []).hasAny([me]);
    }

    function rpObligation(paymentId) {
      return /databases/$(database)/documents/paymentObligations/$(paymentId);
    }

    /** Readers of an obligation's transactions, trail and comments. */
    function rpParentReader(paymentId) {
      return rpModuleUser()
        || (hasPermissions() && exists(rpObligation(paymentId)) && rpNamed(get(rpObligation(paymentId)).data));
    }

    /** May open E-Approval at all (useEApprovalPermissions().canViewModule). */
    function rpEApprovalUser() {
      return hasPermissions() && (
        get(permissionsPath()).data.p.get('E-Approval', []).hasAny(['View Module'])
        || get(permissionsPath()).data.p.get('E-Approval.Dashboard', []).hasAny(['View'])
        || get(permissionsPath()).data.p.get('E-Approval.Inbox', []).hasAny(['View']));
    }

    /**
     * Mirrored by a live E-Approval request that points back at this very obligation. The request
     * is the E-Approval module's record, so an obligation cannot vouch for itself.
     */
    function rpMirrored(paymentId, data) {
      let mirror = data.get('eApproval', {});
      let requestId = mirror.get('requestId', '');
      let request = /databases/$(database)/documents/eApprovalRequests/$(requestId);
      return requestId is string && requestId != '' && mirror.get('detachedAt', null) == null
        && exists(request)
        && get(request).data.get('source', {}).get('module', '') == 'Recurring Payments'
        && get(request).data.get('source', {}).get('recordId', '') == paymentId;
    }

    /* The changed fields are worked out once per write (`changed`): a diff walks the document. */

    /** What the bridge records about the mirror (`stampMirror`). */
    function rpMirrorStampOnly(changed) {
      return changed.hasOnly(['eApproval', 'updatedAt']);
    }

    /** What the bridge writes when it moves the payment one stage (`advancePayment`). */
    function rpMirrorAdvanceOnly(changed) {
      return changed.hasOnly([
        'workflowHistory', 'workflowStatus', 'status', 'stage', 'currentStepId', 'assignees',
        'currentApprovalLevel', 'approvalCompletedBy', 'stepEnteredAt', 'workflowDeadline', 'updatedAt'
      ]) && request.resource.data.get('workflowHistory', []).size()
        == resource.data.get('workflowHistory', []).size() + 1;
    }

    function rpObligationUpdate(paymentId, changed) {
      return !changed.hasAny(['organizationId', 'masterId', 'cycleKey', 'sourceType', 'createdAt']) && (
        // Hiding (`deleted`) has its own permission, whatever else the write carries.
        changed.hasAny(['deleted', 'deletedAt', 'deletedBy'])
          ? rpHolds('Payments', ['Delete'])
          : (rpPaymentEditor()
            // The step's own assignee working it (professional-workflow-stage.tsx).
            || rpAssignee(resource.data)
            // The bridge keeping the mirror current, from any screen that shows the payment.
            || ((rpModuleUser() || rpNamed(resource.data)) && (rpMirrorStampOnly(changed)
              || (rpMirrorAdvanceOnly(changed) && rpMirrored(paymentId, resource.data))))
            // The bridge acting for an E-Approval approver.
            || (rpEApprovalUser() && (rpMirrorStampOnly(changed) || rpMirrorAdvanceOnly(changed))
              && rpMirrored(paymentId, resource.data))));
    }

    /** Every action a payment screen gates a write to the obligation on. */
    function rpPaymentEditor() {
      return rpHolds('Payments', [
          'Edit', 'Cancel', 'Upload Bill', 'Verify', 'Submit', 'Reopen', 'Reassign', 'Bulk Assign',
          'Approve', 'Record Payment'
        ])
        || rpHolds('Payment Processing', [
          'Record Payment', 'Edit Transaction', 'Upload Receipt', 'Close Payment', 'Delete Transaction'
        ])
        || rpHolds('Approvals', ['Approve', 'Reject', 'Return', 'Delegate', 'Bulk Approve']);
    }

    function rpRecorder() {
      return rpHolds('Payments', ['Record Payment']) || rpHolds('Payment Processing', ['Record Payment']);
    }

    match /paymentObligations/{paymentId} {
      // A list is allowed when every result is provably the caller's: My Work's
      // `where assignedTo|verifierId|approverId|accountsProcessorId == me`, and the module's
      // `where assignees|approvalLevels|approvalCompletedBy array-contains me`.
      allow read: if rpModuleUser() || rpNamed(resource.data);
      // The bridge opens the payment by id for an approver who holds nothing here.
      allow get: if rpEApprovalUser() && rpMirrored(paymentId, resource.data);

      // "Generate now" / "Generate all" (Payments Add), the master form's "Save and generate"
      // (Recurring Masters Add or Edit), and a manual payment (Payments Add).
      allow create: if (rpHolds('Payments', ['Add']) || rpHolds('Recurring Masters', ['Add', 'Edit']))
        && request.resource.data.get('organizationId', '') is string
        && request.resource.data.get('organizationId', '') != '';

      allow update: if rpObligationUpdate(paymentId, request.resource.data.diff(resource.data).affectedKeys());
      // Obligations are soft-deleted (`deleted`); their history stays.
    }

    match /paymentObligations/{paymentId}/transactions/{transactionId} {
      allow read: if rpParentReader(paymentId);
      // Recorded from the register (Record Payment) or by the Payment Processing step's assignee,
      // in the same transaction that moves the payment, so `get` is the payment before it moved.
      allow create: if request.resource.data.get('paymentId', '') == paymentId && (
        rpRecorder()
        || (exists(rpObligation(paymentId)) && rpAssignee(get(rpObligation(paymentId)).data)));
      // Editing an instalment, or attaching its receipt (payment-detail-page.tsx).
      allow update: if request.resource.data.get('paymentId', '') == resource.data.get('paymentId', '')
        && (rpHolds('Payment Processing', ['Edit Transaction', 'Upload Receipt'])
          || rpHolds('Payments', ['Record Payment']));
    }

    /* Append-only. Written beside every change to the payment, by whoever was allowed to make it. */
    match /paymentObligations/{paymentId}/auditLogs/{entryId} {
      allow read: if rpParentReader(paymentId);
      allow create: if request.resource.data.get('paymentId', '') == paymentId && (
        rpParentReader(paymentId)
        || (rpEApprovalUser() && exists(rpObligation(paymentId))
          && rpMirrored(paymentId, get(rpObligation(paymentId)).data)));
    }

    match /paymentObligations/{paymentId}/comments/{commentId} {
      allow read: if rpParentReader(paymentId);
      allow create: if rpHolds('Payments', ['Add Comment'])
        && request.resource.data.get('paymentId', '') == paymentId;
    }

    /*
     * The register's searches across every obligation's instalments (payment-mode-report.tsx). Any
     * other `transactions` group would be matched too; there is none in the code.
     */
    match /{path=**}/transactions/{transactionId} {
      allow read: if rpModuleUser();
    }

    /*
     * Per-organization settings and field control. Every step form and the E-Approval bridge read
     * them, including for people who hold nothing in the module; nothing in them is sensitive.
     */
    match /recurringPaymentSettings/{settingsId} {
      allow read: if signedIn();
      allow create, update: if settingsId.matches('fieldControl_.*')
        ? rpHolds('Settings', ['Manage Field Control'])
        : rpHolds('Settings', ['Edit']);
    }

    match /recurringPaymentApprovalRules/{ruleId} {
      allow read: if rpModuleUser();
      allow create, update: if rpHolds('Settings', ['Edit', 'Manage Approval Rules']);
    }

    match /recurringPaymentCategories/{categoryId} {
      allow read: if rpModuleUser();
      allow create, update: if rpHolds('Categories', ['Add', 'Edit']) || rpHolds('Settings', ['Manage Categories']);
    }

    /* Letter of Credit's request form lists them as beneficiaries (new-lc-request-form.tsx). */
    match /recurringPaymentVendors/{vendorId} {
      allow read: if rpModuleUser()
        || (hasPermissions()
          && get(permissionsPath()).data.p.get('Letter of Credit Management.LC Requests', []).hasAny(['Add', 'Edit']));
      allow create, update: if rpHolds('Vendors', ['Add', 'Edit']);
    }
    match /recurringPaymentVendors/{vendorId}/auditLogs/{entryId} {
      allow read: if rpModuleUser();
      allow create: if rpHolds('Vendors', ['Add', 'Edit']);
    }

    /* Masters are archived, never deleted. */
    match /recurringPaymentMasters/{masterId} {
      allow read: if rpModuleUser();
      allow create, update: if rpHolds('Recurring Masters', ['Add', 'Edit', 'Delete', 'Import', 'Activate', 'Pause']);
    }
    match /recurringPaymentMasters/{masterId}/auditLogs/{entryId} {
      allow read: if rpModuleUser();
      allow create: if rpHolds('Recurring Masters', ['Add', 'Edit', 'Delete', 'Import', 'Activate', 'Pause']);
    }

    /* Written by the scheduler only (api/recurring-payments/generate). */
    match /recurringPaymentAutomationLogs/{entryId} {
      allow read: if rpModuleUser();
    }
    match /recurringPaymentNotificationQueue/{entryId} {
      allow read: if rpModuleUser();
    }
    /* Declared in RP_COLLECTIONS and used by nothing. */
    match /recurringPaymentNotificationRules/{ruleId} {
      allow read: if rpModuleUser();
    }

    /* ── Site Account Statement (src/lib/permissions.ts, "Site Account Statement") ────────────────
     *
     * A user is attached to a project when its siteAccountProjects document names their `users`
     * document id as assignedPersonId or altUserId (records transactions) or viewerId (reads only).
     * `Site Account Statement.All Projects` View lifts the project scope, as it does on every page;
     * no other grant does — the pages show a View Expenses or View Budget holder only the projects
     * they are attached to, so the rules do the same.
     *
     * Get budget: permissionsPath() costs 1, each distinct project 1. A list query filtered with
     * `projectId in [...]` is checked once per value, so a chunk may hold at most 9 projects
     * (SAS_IN_CHUNK, src/lib/site-account-statement-scope.ts); 10 is refused. Writes read at most
     * the old and new project: 3 calls.
     *
     * Month closure and the date window are still enforced only in the browser. The closure
     * calendar is resolved from manual entries, timed relocks and organisation/project auto-close
     * rules against the viewer's local day (src/lib/site-account-statement-month-closure.ts);
     * mirroring that here, in UTC, risks refusing an entry the screen allows.
     */
    function sasPage(page) {
      return 'Site Account Statement.' + page;
    }

    function sasHoldsAny(page, actions) {
      return hasPermissions() && get(permissionsPath()).data.p.get(sasPage(page), []).hasAny(actions);
    }

    function sasAllProjects() {
      return sasHoldsAny('All Projects', ['View']);
    }

    function sasProjectPath(projectId) {
      return /databases/$(database)/documents/siteAccountProjects/$(projectId);
    }

    /** The project document, when the id names one; guarded so a stray id refuses, not errors. */
    function sasProjectExists(projectId) {
      return projectId is string && projectId != '' && hasPermissions() && exists(sasProjectPath(projectId));
    }

    function sasMe() {
      return get(permissionsPath()).data.get('userDocId', '');
    }

    /** Primary or alt user on the project: may record its transactions. */
    function sasRecorder(projectId) {
      return sasProjectExists(projectId) && sasMe() != ''
        && [get(sasProjectPath(projectId)).data.get('assignedPersonId', ''),
            get(sasProjectPath(projectId)).data.get('altUserId', '')].hasAny([sasMe()]);
    }

    /** Attached in any role, the viewer included: may read the project's figures. */
    function sasMember(projectId) {
      return sasProjectExists(projectId) && sasMe() != ''
        && [get(sasProjectPath(projectId)).data.get('assignedPersonId', ''),
            get(sasProjectPath(projectId)).data.get('altUserId', ''),
            get(sasProjectPath(projectId)).data.get('viewerId', '')].hasAny([sasMe()]);
    }

    function sasSees(projectId) {
      return sasAllProjects() || sasMember(projectId);
    }

    /*
     * Month Closure counts every project's expenses, receipts and pending allocations for the year
     * it shows, for anyone the screen admits (month-closure-settings.tsx canView).
     */
    function sasMonthClosureReader() {
      return sasHoldsAny('Month Closure', ['View', 'Close', 'Reopen']) || sasHoldsAny('Project Settings', ['Edit']);
    }

    /** Renaming a category rewrites it on every project's expenses and category budgets. */
    function sasCategoryRename(fields) {
      return sasHoldsAny('Expense Categories', ['Edit'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    /** Expenses and Payments: what canWriteToProject allows on those pages. */
    function sasLedgerWriter(page, projectId) {
      return sasAllProjects() || sasHoldsAny(page, ['Add', 'Edit']) || sasRecorder(projectId);
    }

    function sasLedgerUpdate(page) {
      return sasLedgerWriter(page, resource.data.get('projectId', ''))
        && sasLedgerWriter(page, request.resource.data.get('projectId', ''));
    }

    /** Readable by any signed-in user: it carries assignments, no figures, and every page reads it whole. */
    match /siteAccountProjects/{projectId} {
      allow read: if signedIn();
      allow create: if sasHoldsAny('Project Settings', ['Add']);
      allow update: if sasHoldsAny('Project Settings', ['Edit']);
      allow delete: if sasHoldsAny('Project Settings', ['Delete']);
    }

    match /siteAccountCategories/{categoryId} {
      allow read: if signedIn();
      allow create: if sasHoldsAny('Expense Categories', ['Add']);
      allow update: if sasHoldsAny('Expense Categories', ['Edit']);
      allow delete: if sasHoldsAny('Expense Categories', ['Delete']);
    }

    match /siteAccountExpenses/{expenseId} {
      allow read: if sasAllProjects() || sasMonthClosureReader()
        || sasHoldsAny('Expense Categories', ['Edit', 'Delete'])
        || sasMember(resource.data.projectId);
      allow create: if sasLedgerWriter('Expenses', request.resource.data.get('projectId', ''));
      allow update: if sasCategoryRename(['expenseCategory', 'expenseSubCategory']) || sasLedgerUpdate('Expenses');
      allow delete: if sasHoldsAny('Expenses', ['Delete']) || sasLedgerWriter('Expenses', resource.data.get('projectId', ''));
    }

    match /siteAccountPayments/{paymentId} {
      allow read: if sasAllProjects() || sasMonthClosureReader() || sasMember(resource.data.projectId);
      allow create: if sasLedgerWriter('Payments', request.resource.data.get('projectId', ''));
      allow update: if sasLedgerUpdate('Payments');
      allow delete: if sasHoldsAny('Payments', ['Delete']) || sasLedgerWriter('Payments', resource.data.get('projectId', ''));
    }

    /* ── Budgets: Budget is the coarse grant, each level has its own (budget/page.tsx typePerm) ─ */

    function sasBudgetLevel(budgetType) {
      return budgetType == 'total' ? 'Total Budget' : (budgetType == 'fy' ? 'FY Budget' : 'Monthly Budget');
    }

    /** Add or Edit on Budget or the given level, or primary/alt on the project. */
    function sasBudgetWriter(level, projectId) {
      return sasHoldsAny('Budget', ['Add', 'Edit']) || sasHoldsAny(level, ['Add', 'Edit']) || sasRecorder(projectId);
    }

    function sasBudgetDeleter(level) {
      return sasHoldsAny('Budget', ['Delete']) || sasHoldsAny(level, ['Delete']);
    }

    match /siteAccountBudgets/{budgetId} {
      allow read: if sasSees(resource.data.projectId);
      allow create: if sasBudgetWriter(sasBudgetLevel(request.resource.data.get('budgetType', '')),
        request.resource.data.get('projectId', ''));
      allow update: if sasBudgetWriter(sasBudgetLevel(resource.data.get('budgetType', '')), resource.data.get('projectId', ''))
        && sasBudgetWriter(sasBudgetLevel(request.resource.data.get('budgetType', '')), request.resource.data.get('projectId', ''));
      allow delete: if sasBudgetDeleter(sasBudgetLevel(resource.data.get('budgetType', '')));
    }

    /** budget/category/page.tsx removes a row under Edit, so Edit deletes as well. */
    match /siteAccountCategoryBudgets/{budgetId} {
      allow read: if sasAllProjects() || sasHoldsAny('Expense Categories', ['Edit', 'Delete'])
        || sasMember(resource.data.projectId);
      allow create: if sasBudgetWriter('Category Budget', request.resource.data.get('projectId', ''));
      allow update: if sasCategoryRename(['categoryName'])
        || (sasBudgetWriter('Category Budget', resource.data.get('projectId', ''))
          && sasBudgetWriter('Category Budget', request.resource.data.get('projectId', '')));
      allow delete: if sasBudgetDeleter('Category Budget') || sasHoldsAny('Budget', ['Edit'])
        || sasHoldsAny('Category Budget', ['Edit']);
    }

    /** The signed approval copy behind a month's budget: the Monthly Budget level's. */
    match /siteAccountBudgetApprovals/{approvalId} {
      allow read: if sasSees(resource.data.projectId);
      allow create: if sasBudgetWriter('Monthly Budget', request.resource.data.get('projectId', ''));
      allow update: if sasBudgetWriter('Monthly Budget', resource.data.get('projectId', ''))
        && sasBudgetWriter('Monthly Budget', request.resource.data.get('projectId', ''));
      allow delete: if sasBudgetDeleter('Monthly Budget');
    }

    /*
     * Instalments of a month's budget. Recording one and verifying it are separate on purpose
     * (budget/page.tsx allocPerm): a project assignment records, only a role verifies. A new row is
     * always pending, and a verified one is never deleted — it is sent back for review first.
     */
    function sasAllocationVerifier() {
      return sasHoldsAny('Budget Allocation', ['Verify']) || sasHoldsAny('Budget', ['Edit'])
        || sasHoldsAny('Monthly Budget', ['Edit']);
    }

    match /siteAccountBudgetAllocations/{allocationId} {
      allow read: if sasAllProjects() || sasMonthClosureReader() || sasMember(resource.data.projectId);
      allow create: if request.resource.data.get('status', '') == 'pending'
        && (sasHoldsAny('Budget Allocation', ['Add']) || sasAllocationVerifier()
          || sasRecorder(request.resource.data.get('projectId', '')));
      allow update: if sasAllocationVerifier();
      allow delete: if resource.data.get('status', '') != 'approved'
        && (sasHoldsAny('Budget Allocation', ['Delete']) || sasHoldsAny('Budget', ['Delete']));
    }

    match /siteAccountTenderBudgets/{tenderBudgetId} {
      allow read: if sasSees(resource.data.projectId);
      allow create: if sasHoldsAny('Tender Budget', ['Add', 'Edit']) || sasRecorder(request.resource.data.get('projectId', ''));
      allow update: if sasHoldsAny('Tender Budget', ['Add', 'Edit'])
        || (sasRecorder(resource.data.get('projectId', '')) && sasRecorder(request.resource.data.get('projectId', '')));
      allow delete: if sasHoldsAny('Tender Budget', ['Delete']);
    }

    /*
     * Alert thresholds and recipients, keyed by project id or `_module_wide_`. Every expense writer
     * reads both documents after saving (src/lib/sas-budget-alerts.ts); the list is the Budget
     * Alerts screen's.
     */
    match /siteAccountBudgetAlertConfigs/{configId} {
      allow get: if signedIn();
      allow list: if sasHoldsAny('Budget Alerts', ['View', 'Edit']) || sasHoldsAny('Project Settings', ['Edit']);
      allow write: if sasHoldsAny('Budget Alerts', ['Edit']) || sasHoldsAny('Project Settings', ['Edit']);
    }

    /*
     * Which alert thresholds have already been sent, written in a transaction by whoever saved the
     * expense and cleared by whoever changed a budget. Document ids start with the project id
     * (`<projectId>_<period…>`; auto-ids hold no underscore), which is what a get of a document
     * that does not exist yet can be checked against.
     */
    function sasAlertActor(projectId) {
      return sasAllProjects()
        || holdsAnyOf([
          sasPage('Expenses'), sasPage('Payments'), sasPage('Budget'), sasPage('Total Budget'),
          sasPage('FY Budget'), sasPage('Monthly Budget'), sasPage('Category Budget'),
          sasPage('Budget Allocation')
        ])
        || sasMember(projectId);
    }

    match /siteAccountBudgetAlertState/{stateId} {
      allow get, write: if sasAlertActor(stateId.split('_')[0]);
      allow list: if sasAlertActor(resource.data.projectId);
    }

    /** Field, sort and date controls and the closure calendar: read on every page, set in Settings. */
    match /siteAccountSettings/{settingId} {
      allow read: if signedIn();
      allow write: if ((settingId == 'fieldControl' || settingId == 'sortControl')
          && sasHoldsAny('Field Control', ['Edit']))
        || (settingId == 'dateControl'
          && (sasHoldsAny('Date Control', ['Edit']) || sasHoldsAny('Field Control', ['Edit'])))
        || (settingId == 'monthClosure'
          && (sasHoldsAny('Month Closure', ['Close', 'Reopen']) || sasHoldsAny('Project Settings', ['Edit'])));
    }

    /* ── Site Fund Request (src/lib/site-fund-request.ts) ───────────────────────────────────────
     *
     * Project access rows are keyed by auto-ids and name the project by `centralProjectId`, so a
     * rule cannot look a request's project up, and membership cannot be checked here. Requests
     * therefore stay readable to any signed-in user (as the screens, which filter in the browser,
     * need); writes are narrowed to what the screens do.
     */
    match /siteFundRequestProjects/{rowId} {
      allow read: if signedIn();
      allow write: if holds('Site Fund Request.Settings', 'Edit');
    }

    match /siteFundRequests/{requestId} {
      allow read: if signedIn();
      /** Raised as yourself, at the start of the workflow. */
      allow create: if signedIn() && request.resource.data.get('status', '') == 'Pending'
        && (request.resource.data.get('raisedById', '') == get(permissionsPath()).data.get('userDocId', '')
          || holds('Site Fund Request.Requests', 'Add') || holds('Site Fund Request', 'Create Requisition'));
      /*
       * Workflow actions belong to the current step's assignees (ViewRequestDialog, stage page).
       * Before anyone has received it, the request's own details may still be corrected
       * (AllRequestsTab handleEditRequest, which has no permission check of its own).
       */
      allow update: if hasPermissions() && (
        resource.data.get('assignees', []).hasAny([get(permissionsPath()).data.get('userDocId', '')])
        || (resource.data.get('stage', '') == 'Request Receiving'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['projectId', 'departmentId', 'amount', 'partyName', 'description', 'date', 'attachments'])));
    }

    /* ── HR & Recruitment (src/lib/permissions.ts, "HR & Recruitment"; src/lib/hr-requirement-service.ts) ─
     *
     * Every screen in the module sits behind `View Module` on 'HR & Recruitment' (module-layout-shell
     * canViewModule) and reads its collections whole for the organisation (useHrCollection:
     * `where organizationId == org`), then filters in the browser. My Interviews and Referrals are open
     * to anyone in the module, and they subscribe to every interview, feedback entry, candidate and
     * referral. So every record here — candidates, CTCs, offers, joining records — is readable by
     * the module's users and by nobody else. The dashboard on / and /my-work (work-dashboard-sources.ts)
     * asks with `pendingApproverIds | interviewerIds array-contains me`, which a named person may
     * always do.
     *
     * Writes follow the action the screen checks, and three kinds of assignment stand on their own,
     * because the service treats them as the authority (hr-requirement-service.ts):
     *   - a requirement's, compensation approval's or offer's `pendingApproverIds`;
     *   - an interview's `interviewerIds` (feedback, and the panel summary it recomputes);
     *   - the cascades every step runs on records it does not own (requirement counters, the
     *     candidate's application count and talent-pool flags, a joining record's document state,
     *     an agency's performance counters) — narrowed to those fields.
     *
     * Names are `users` document ids (`userPermissions.userDocId`), never the auth uid. Organisation is
     * not checked: `userPermissions` does not carry it. Budget: the permissions document (1), plus at
     * most one of the requirement (an approval entry), the interview (feedback) or the compensation
     * approval (a proposal's decision) — 2 of 10.
     */
    function hrUser() {
      return hasPermissions() && get(permissionsPath()).data.p.get('HR & Recruitment', []).hasAny(['View Module']);
    }

    function hrHolds(page, actions) {
      return hasPermissions() && get(permissionsPath()).data.p.get('HR & Recruitment.' + page, []).hasAny(actions);
    }

    /** The caller's `users` id; '' when unknown, which then matches no one. */
    function hrMe() {
      return hasPermissions() ? get(permissionsPath()).data.get('userDocId', '') : '';
    }

    function hrIsMe(userId) {
      return hrMe() != '' && userId == hrMe();
    }

    function hrNamed(userIds) {
      return hrMe() != '' && userIds.hasAny([hrMe()]);
    }

    function hrChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function hrOnly(fields) {
      return hrChanged().hasOnly(fields.concat(['updatedAt', 'updatedBy', 'updatedByName']));
    }

    function hrUnchanged(fields) {
      return !hrChanged().hasAny(fields);
    }

    /** A new record stamped as its writer (withCreateAudit). */
    function hrCreatedByMe() {
      return hrIsMe(request.resource.data.get('createdBy', ''));
    }

    /** An edit leaves `updatedBy` alone or stamps the writer (withUpdateAudit). */
    function hrStamped() {
      return request.resource.data.get('updatedBy', null) == resource.data.get('updatedBy', null)
        || hrIsMe(request.resource.data.get('updatedBy', ''));
    }

    function hrStatus() {
      return request.resource.data.get('status', '');
    }

    function hrStatusField(field) {
      return request.resource.data.get(field, '');
    }

    function hrWas() {
      return resource.data.get('status', '');
    }

    /** Fields no edit moves: who made the record and what it belongs to. */
    function hrKeeps(fields) {
      return hrUnchanged(fields.concat(['organizationId', 'createdAt', 'createdBy']));
    }

    /*
     * Every step that moves an application: the pipeline itself, scheduling an interview, selection,
     * the offer stages, joining, and cancelling the requirement (which releases its pipeline).
     */
    function hrPipelineWriter() {
      return hrHolds('Pipeline', ['Add Candidate', 'Move Stage', 'Screen', 'Reject', 'Hold', 'Move To Talent Pool'])
        || hrHolds('Interviews', ['Schedule'])
        || hrHolds('Selection', ['Add', 'Edit', 'Withdraw'])
        || hrHolds('Offers', ['Add', 'Send', 'Record Response', 'Withdraw'])
        || hrHolds('Joining', ['Confirm Joining', 'Postpone', 'Mark Not Joined'])
        || hrHolds('Requirements', ['Cancel']);
    }

    /* ── Configuration and numbering ── */

    match /hrSettings/{organizationId} {
      allow get: if hrUser();
      allow create, update: if hrHolds('Settings', ['Edit']) && hrUser()
        && request.resource.data.get('organizationId', '') == organizationId
        && (resource == null || hrStamped());
    }

    /*
     * Document numbers, allocated in a transaction by whoever creates the record — a referral from
     * anyone in the module included. The sequence only moves forward.
     */
    match /hrCounters/{counterId} {
      allow get: if hrUser();
      allow create: if hrUser() && request.resource.data.get('nextSequence', 0) is int
        && request.resource.data.get('nextSequence', 0) > 1;
      allow update: if hrUser() && request.resource.data.get('nextSequence', 0) is int
        && request.resource.data.get('nextSequence', 0) > resource.data.get('nextSequence', 1);
    }

    /** Append-only: every step writes one as its actor, comments and JD notes included. */
    match /hrActivities/{entryId} {
      allow read: if hrUser();
      allow create: if hrUser() && hrIsMe(request.resource.data.get('userId', ''));
    }

    /* Written by the server only (api/hr/sla), or not at all yet; readable in the module. */
    match /hrEscalations/{entryId} {
      allow read: if hrUser();
    }
    match /hrRequirementTemplates/{templateId} {
      allow read: if hrUser();
    }
    match /jobDescriptions/{descriptionId} {
      allow read: if hrUser();
    }
    match /recruitmentSources/{sourceId} {
      allow read: if hrUser();
    }

    /* ── Requirements and their approval (spec sections 5–15) ── */

    function hrPendingApproval() {
      return ['SUBMITTED', 'PENDING_HOD_APPROVAL', 'PENDING_HR_APPROVAL', 'PENDING_BUDGET_APPROVAL',
        'PENDING_MANAGEMENT_APPROVAL'];
    }

    /** RECRUITING_REQUIREMENT_STATUSES, src/lib/hr-policy.ts. */
    function hrRecruiting() {
      return ['OPEN', 'SOURCING', 'SCREENING', 'INTERVIEWING', 'SELECTION_IN_PROGRESS', 'OFFER_IN_PROGRESS',
        'PARTIALLY_FILLED', 'REOPENED'];
    }

    function hrRequirementWriter() {
      return hrHolds('Requirements', [
        'Add', 'Edit', 'Submit', 'Assign Recruiter', 'Hold', 'Resume', 'Cancel', 'Close', 'Reopen', 'Manage Sourcing'
      ]);
    }

    /*
     * A requisition awaiting a decision is the approvers' (actOnRequirement): a register permission
     * may cancel it or edit around it, but not move its stage or change who decides.
     */
    function hrRequirementEdit() {
      return hrRequirementWriter() && (
        !(hrWas() in hrPendingApproval())
        || hrStatus() == 'CANCELLED'
        || hrUnchanged(['status', 'pendingApproverIds', 'approvalStages', 'approvalStageIndex',
          'currentApprovalStage', 'currentApprovalStageLabel']));
    }

    /** The decision of someone the chain names: approve, reject, send back, forward or delegate. */
    function hrRequirementDecision() {
      return hrNamed(resource.data.get('pendingApproverIds', [])) && hrWas() in hrPendingApproval()
        && hrStatus() in hrPendingApproval().concat(['RECRUITER_ASSIGNMENT_PENDING', 'REJECTED', 'DRAFT'])
        && hrOnly(['status', 'approvalStageIndex', 'currentApprovalStage', 'currentApprovalStageLabel',
          'pendingApproverIds', 'rejectedAt', 'rejectionReason', 'approvedAt', 'slaStartedAt', 'slaTargetDays',
          'slaState', 'slaConsumedPercent', 'targetClosureDate']);
    }

    /*
     * refreshRequirementCounters, run after every pipeline, interview, selection, offer and joining
     * step, and confirmJoining's `joinedCount`. The status it re-derives stays among the recruiting
     * ones (or FILLED), and only when the requirement was recruiting.
     */
    function hrRequirementCounters() {
      return hrOnly(['applicationCount', 'screeningCount', 'interviewingCount', 'selectedCount',
          'offeredCount', 'offerAcceptedCount', 'joinedCount', 'status'])
        && (hrUnchanged(['status'])
          || (hrWas() in hrRecruiting() && hrStatus() in hrRecruiting().concat(['FILLED'])));
    }

    function hrRequirementPath(requirementId) {
      return /databases/$(database)/documents/hrRequirements/$(requirementId);
    }

    function hrApproverOf(requirementId) {
      return requirementId is string && requirementId != '' && hasPermissions()
        && exists(hrRequirementPath(requirementId))
        && hrNamed(get(hrRequirementPath(requirementId)).data.get('pendingApproverIds', []));
    }

    match /hrRequirements/{requirementId} {
      allow read: if hrUser() || hrNamed(resource.data.get('pendingApproverIds', []));
      allow create: if hrUser() && hrHolds('Requirements', ['Add']) && hrCreatedByMe()
        && hrStatus() == 'DRAFT';
      allow update: if hrUser() && hrStamped() && hrKeeps(['requirementNumber'])
        && (hrRequirementEdit() || hrRequirementDecision() || hrRequirementCounters());
    }

    /** Append-only trail, written by the approver the requirement names, before it moves. */
    match /hrRequirementApprovals/{entryId} {
      allow read: if hrUser();
      allow create: if hrUser() && hrIsMe(request.resource.data.get('approverId', ''))
        && hrApproverOf(request.resource.data.get('requirementId', ''));
    }

    match /hrManpowerPlans/{planId} {
      allow read: if hrUser();
      allow create: if hrUser() && hrHolds('Manpower Planning', ['Add']) && hrCreatedByMe();
      allow update: if hrUser() && hrHolds('Manpower Planning', ['Edit']) && hrStamped() && hrKeeps([]);
    }

    /* ── Candidates and the pipeline (spec sections 19–23) ── */

    match /candidates/{candidateId} {
      allow read: if hrUser();
      allow create: if hrUser() && hrHolds('Candidates', ['Add']) && hrCreatedByMe();
      allow update: if hrUser() && hrStamped() && hrKeeps(['candidateNumber']) && (
        hrHolds('Candidates', ['Edit'])
        || (hrHolds('Candidates', ['Set Do Not Hire'])
          && hrOnly(['doNotHire', 'doNotHireReason', 'doNotHireBy', 'doNotHireAt']))
        // createApplication, addToTalentPool and confirmJoining keep the candidate in step.
        || ((hrPipelineWriter() || hrHolds('Talent Pool', ['Add']))
          && hrOnly(['applicationCount', 'lastApplicationAt', 'inTalentPool', 'talentPoolCategories', 'employeeId'])));
    }

    match /candidateApplications/{applicationId} {
      allow read: if hrUser();
      allow create: if hrUser() && hrHolds('Pipeline', ['Add Candidate']) && hrCreatedByMe()
        && hrStatusField('stage') == 'NEW';
      allow update: if hrUser() && hrStamped()
        && hrKeeps(['applicationNumber', 'requirementId', 'candidateId'])
        // The interviewer's feedback carries the panel's score across (recomputeInterviewSummary).
        && (hrPipelineWriter() || hrOnly(['latestInterviewScore', 'panelRecommendation']));
    }

    match /talentPools/{entryId} {
      allow read: if hrUser();
      allow create: if hrUser() && hrCreatedByMe()
        && (hrHolds('Talent Pool', ['Add']) || hrHolds('Pipeline', ['Move Stage', 'Move To Talent Pool']));
    }

    /* ── Interviews (spec sections 24–26) ── */

    function hrInterviewPath(interviewId) {
      return /databases/$(database)/documents/interviews/$(interviewId);
    }

    function hrInterviewerOf(interviewId) {
      return interviewId is string && interviewId != '' && hasPermissions()
        && exists(hrInterviewPath(interviewId))
        && hrNamed(get(hrInterviewPath(interviewId)).data.get('interviewerIds', []));
    }

    match /interviews/{interviewId} {
      allow read: if hrUser() || hrNamed(resource.data.get('interviewerIds', []));
      allow create: if hrUser() && hrHolds('Interviews', ['Schedule']) && hrCreatedByMe()
        && request.resource.data.get('interviewerIds', null) is list && hrStatus() == 'SCHEDULED';
      allow update: if hrUser() && hrStamped()
        && hrKeeps(['interviewNumber', 'applicationId', 'requirementId', 'candidateId']) && (
          hrHolds('Interviews', ['Schedule', 'Reschedule', 'Cancel'])
          // The panel's summary, recomputed by whoever just submitted feedback.
          || ((hrNamed(resource.data.get('interviewerIds', [])) || hrHolds('My Interviews', ['Revise Feedback']))
            && hrOnly(['averageScore', 'panelRecommendation', 'hasDissent', 'status', 'completedAt'])
            && hrStatus() in ['COMPLETED', 'FEEDBACK_PENDING']));
    }

    /*
     * Append-only (control rule 63.6): a revision is a new entry. A panel member's own, or a revision
     * authorised by Revise Feedback.
     */
    match /interviewFeedback/{feedbackId} {
      allow read: if hrUser();
      allow create: if hrUser() && hrIsMe(request.resource.data.get('interviewerId', ''))
        && request.resource.data.get('submitted', false) == true
        && (hrHolds('My Interviews', ['Revise Feedback'])
          || hrInterviewerOf(request.resource.data.get('interviewId', '')));
    }

    /* ── Selection and compensation approval (spec sections 27, 28) ── */

    function hrCompensationPath(approvalId) {
      return /databases/$(database)/documents/compensationApprovals/$(approvalId);
    }

    /*
     * actOnCompensationApproval decides the approval first, then carries the decision to the proposal.
     * So the proposal follows a decided approval this caller stamped, with its outcome and figure.
     */
    function hrCompensationOutcome() {
      let approvalId = resource.data.get('compensationApprovalId', '');
      return approvalId is string && approvalId != '' && hasPermissions()
        && exists(hrCompensationPath(approvalId))
        && hrCompensationMatches(get(hrCompensationPath(approvalId)).data);
    }

    function hrCompensationMatches(approval) {
      return hrIsMe(approval.get('updatedBy', ''))
        && approval.get('status', '') in ['APPROVED', 'REJECTED']
        && hrStatus() == approval.get('status', '')
        && hrStatusField('compensationApprovalStatus') == approval.get('status', '')
        && (approval.get('status', '') == 'REJECTED'
          || request.resource.data.get('approvedCtc', 0) == approval.get('approvedCtc', 0))
        && hrOnly(['compensationApprovalStatus', 'status', 'rejectionReason', 'approvedCtc', 'approvedAt']);
    }

    match /selectionProposals/{proposalId} {
      allow read: if hrUser();
      allow create: if hrUser() && hrHolds('Selection', ['Add']) && hrCreatedByMe();
      allow update: if hrUser() && hrStamped()
        && hrKeeps(['proposalNumber', 'applicationId', 'candidateId', 'requirementId']) && (
          hrHolds('Selection', ['Add', 'Edit', 'Withdraw'])
          // createOffer marks the proposal offered.
          || (hrHolds('Offers', ['Add']) && hrOnly(['status']) && hrStatus() == 'OFFERED')
          || hrCompensationOutcome());
    }

    /*
     * Raised with the proposal; decided only by the approvers its current stage names, who may
     * approve a lower figure than proposed but never a higher one.
     */
    match /compensationApprovals/{approvalId} {
      allow read: if hrUser() || hrNamed(resource.data.get('pendingApproverIds', []));
      allow create: if hrUser() && hrHolds('Selection', ['Add']) && hrCreatedByMe() && hrStatus() == 'PENDING';
      allow update: if hrUser() && hrStamped() && hrWas() == 'PENDING'
        && hrNamed(resource.data.get('pendingApproverIds', []))
        && hrKeeps(['selectionProposalId', 'requirementId', 'candidateId', 'proposedCtc', 'stages'])
        && hrStatus() in ['PENDING', 'APPROVED', 'REJECTED']
        && request.resource.data.get('approvedCtc', 0) <= resource.data.get('proposedCtc', 0);
    }

    /* ── Offers, pre-joining and joining (spec sections 29–36) ── */

    /*
     * An offer awaiting approval goes on only by approval or withdrawal, and approval belongs to the
     * approvers it names — or, when it names none, to Offers Approve (approveOffer).
     */
    function hrOfferStepOk() {
      return hrWas() != 'PENDING_APPROVAL'
        || hrStatus() in ['PENDING_APPROVAL', 'WITHDRAWN']
        || (hrStatus() == 'APPROVED' && (hrNamed(resource.data.get('pendingApproverIds', []))
          || (resource.data.get('pendingApproverIds', []).size() == 0 && hrHolds('Offers', ['Approve']))));
    }

    match /offers/{offerId} {
      allow read: if hrUser() || hrNamed(resource.data.get('pendingApproverIds', []));
      allow create: if hrUser() && hrHolds('Offers', ['Add']) && hrCreatedByMe()
        && hrStatus() in ['PENDING_APPROVAL', 'APPROVED']
        && request.resource.data.get('portalToken', '') == '';
      allow update: if hrUser() && hrStamped() && hrOfferStepOk()
        && hrKeeps(['offerNumber', 'applicationId', 'candidateId', 'requirementId', 'selectionProposalId']) && (
          hrHolds('Offers', ['Add', 'Edit', 'Approve', 'Send', 'Withdraw', 'Record Response'])
          || (hrNamed(resource.data.get('pendingApproverIds', []))
            && hrOnly(['status', 'approvedBy', 'approvedByName', 'approvedAt', 'pendingApproverIds']))
          // markNotJoined, from the joining screen's Postpone menu.
          || (hrHolds('Joining', ['Postpone', 'Mark Not Joined']) && hrOnly(['status', 'withdrawalReason'])
            && hrStatus() == 'WITHDRAWN'));
    }

    /** The checklist is raised by recording the acceptance; each status has its own action. */
    match /preJoining/{documentId} {
      allow read: if hrUser();
      allow create: if hrUser() && hrHolds('Offers', ['Record Response']) && hrCreatedByMe()
        && hrStatus() == 'PENDING';
      allow update: if hrUser() && hrStamped()
        && hrKeeps(['joiningRecordId', 'offerId', 'candidateId', 'documentType']) && (
          (hrHolds('Pre-Joining', ['Upload']) && hrStatus() == 'UPLOADED')
          || (hrHolds('Pre-Joining', ['Verify'])
            && hrStatus() in ['VERIFIED', 'UNDER_VERIFICATION', 'REUPLOAD_REQUIRED', 'REJECTED'])
          || (hrHolds('Pre-Joining', ['Waive']) && hrStatus() == 'WAIVED'));
    }

    /* Marking a candidate joined is Confirm Joining's alone: it is what creates the employee. */
    match /joiningRecords/{joiningRecordId} {
      allow read: if hrUser();
      allow create: if hrUser() && hrHolds('Offers', ['Record Response']) && hrCreatedByMe()
        && hrStatus() == 'DOCUMENTS_PENDING';
      allow update: if hrUser() && hrStamped()
        && hrKeeps(['joiningNumber', 'offerId', 'candidateId', 'applicationId', 'requirementId'])
        && (hrStatus() != 'JOINED' || hrWas() == 'JOINED' || hrHolds('Joining', ['Confirm Joining'])) && (
          hrHolds('Joining', ['Confirm Joining', 'Postpone', 'Mark Not Joined', 'Manage Onboarding', 'Create Employee'])
          // refreshJoiningDocumentState, after a document is uploaded or verified.
          || (hrHolds('Pre-Joining', ['Upload', 'Verify', 'Waive'])
            && hrOnly(['documentsReady', 'documentCompletionPercent', 'status'])
            && hrStatus() in ['DOCUMENTS_PENDING', 'CONFIRMATION_PENDING', 'CONFIRMED']));
    }

    /* ── Referrals, agencies and costs (spec sections 46, 47, 52) ── */

    /** Open to anyone in the module (/hr/referrals), as themselves. */
    match /hrReferrals/{referralId} {
      allow read: if hrUser();
      allow create: if hrUser() && hrIsMe(request.resource.data.get('referredByUserId', ''))
        && hrCreatedByMe() && hrStatus() == 'SUBMITTED';
    }

    match /recruitmentAgencies/{agencyId} {
      allow read: if hrUser();
      allow create: if hrUser() && hrHolds('Agencies', ['Add']) && hrCreatedByMe();
      allow update: if hrUser() && hrStamped() && hrKeeps([]) && (
        hrHolds('Agencies', ['Edit', 'Deactivate'])
        || (hrHolds('Agencies', ['View Performance'])
          && hrOnly(['submittedCount', 'shortlistedCount', 'interviewedCount', 'offeredCount', 'joinedCount'])));
    }

    match /hrRecruitmentCosts/{costId} {
      allow read: if hrUser();
      allow create: if hrUser() && hrHolds('Recruitment Cost', ['Add']) && hrCreatedByMe();
    }

    /* ── Bank Balance (src/lib/permissions.ts, "Bank Balance") ──────────────────────────────────
     *
     * Every screen checks a page permission, `Bank Balance.<Page>` (the legacy "Expenses Log",
     * "Receipts Log" and "Internal Transaction Log" grants are filed under the current names in
     * `p`), and no record names a person who may work it, so the rules follow the page permissions
     * alone. The ledger (`bankExpenses`) is read whole by every screen that works out a balance:
     * the dashboard (View Module), Daily Log, Interest Rate, Monthly Interest, the reports,
     * Transfers and New Payment. The Payments and Receipts registers read only their own side
     * (`where type == … && isContra == false`), so a register alone opens only that side.
     *
     * Payments, receipts and transfer legs are all `bankExpenses` rows; which page's permission
     * writes one is told by the row itself (`bbEntryPage`). Bill Tracking's verified receipts post
     * their Credits from the server; the Daily Requisitions a voucher pays are updated in the same
     * transaction under that module's own rules.
     *
     * Budget: the permissions document (1), cached for the request and for every document of a
     * voucher's transaction.
     */
    function bbHolds(page, actions) {
      return hasPermissions() && get(permissionsPath()).data.p.get('Bank Balance.' + page, []).hasAny(actions);
    }

    /** Every screen that reads the whole ledger to work out a balance (see above). */
    function bbLedgerReader() {
      return hasPermissions() && (
        get(permissionsPath()).data.p.get('Bank Balance', []).hasAny(['View Module'])
        || bbHolds('Daily Log', ['View']) || bbHolds('Interest Rate', ['View'])
        || bbHolds('Monthly Interest', ['View']) || bbHolds('Reports', ['View'])
        || bbHolds('Internal Transaction', ['View', 'Add']) || bbHolds('Expenses', ['Add']));
    }

    /** The caller's `users` id; '' when unknown, which then matches no one. */
    function bbMe() {
      return hasPermissions() ? get(permissionsPath()).data.get('userDocId', '') : '';
    }

    function bbIsMe(userId) {
      return bbMe() != '' && userId == bbMe();
    }

    /** The page a ledger row belongs to: a transfer leg, a payment, a receipt, or none. */
    function bbEntryPage(data) {
      return data.get('isContra', false) == true ? 'Internal Transaction'
        : (data.get('type', '') == 'Debit' ? 'Expenses'
          : (data.get('type', '') == 'Credit' ? 'Receipts' : ''));
    }

    function bbChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /*
     * The account master. It is also the account picker in Loan, Bill Tracking's receipt form and
     * the Fixed Deposit, Bank Guarantee and Letter of Credit forms, each reading the whole
     * collection under its own module's checks, so any signed-in user may read it. It holds the
     * opening figure, limits and rates; balances come from the ledger. DP Management and Interest
     * Rate each edit their own log and nothing else; the Accounts page edits everything but those.
     */
    match /bankAccounts/{accountId} {
      allow read: if signedIn();
      allow create: if bbHolds('Accounts', ['Add']);
      allow update: if (bbHolds('Accounts', ['Edit']) && !bbChanged().hasAny(['drawingPower', 'interestRateLog']))
        || (bbHolds('DP Management', ['Add', 'Delete']) && bbChanged().hasOnly(['drawingPower']))
        || (bbHolds('Interest Rate', ['Add', 'Delete']) && bbChanged().hasOnly(['interestRateLog']));
      allow delete: if bbHolds('Accounts', ['Delete']);
    }

    /*
     * The ledger. A payment is written only with its voucher (New Payment: Expenses Add), a receipt
     * by Receipts Add, a transfer's two legs by Internal Transaction Add — or Edit, which rewrites
     * them. Clearing a cheque stamps its date on the voucher's rows (Expenses Add); cancelling or
     * bouncing removes them (Expenses Delete). Only the server posts Bill Tracking's Credits.
     */
    match /bankExpenses/{entryId} {
      allow read: if bbLedgerReader()
        || (bbHolds('Expenses', ['View']) && resource.data.type == 'Debit' && resource.data.isContra == false)
        || (bbHolds('Receipts', ['View']) && resource.data.type == 'Credit' && resource.data.isContra == false);
      allow create: if !request.resource.data.keys().hasAny(['billCollectionId'])
        && request.resource.data.get('type', '') in ['Debit', 'Credit']
        && (bbEntryPage(request.resource.data) == 'Internal Transaction'
          ? bbHolds('Internal Transaction', ['Add', 'Edit'])
            && request.resource.data.get('contraId', '') is string && request.resource.data.get('contraId', '') != ''
          : bbEntryPage(request.resource.data) != '' && bbHolds(bbEntryPage(request.resource.data), ['Add']));
      allow update: if bbEntryPage(resource.data) == 'Expenses' && bbHolds('Expenses', ['Add'])
        && bbChanged().hasOnly(['clearedDate']);
      allow delete: if bbEntryPage(resource.data) == 'Internal Transaction'
        ? bbHolds('Internal Transaction', ['Add', 'Edit', 'Delete'])
        : bbEntryPage(resource.data) != '' && bbHolds(bbEntryPage(resource.data), ['Delete']);
    }

    /*
     * Payment vouchers: issued by New Payment, as yourself; then cleared (Expenses Add) or cancelled
     * or bounced (Expenses Delete), once, from Issued, by whoever is recorded as doing it. The
     * Cheque Register, the voucher print and the dashboard's cheque tiles read them on Expenses View.
     */
    match /bankPayments/{voucherId} {
      allow read: if bbHolds('Expenses', ['View', 'Add']);
      allow create: if bbHolds('Expenses', ['Add']) && request.resource.data.get('status', '') == 'Issued'
        && bbIsMe(request.resource.data.get('createdById', ''));
      allow update: if resource.data.get('status', '') == 'Issued' && (
        (request.resource.data.get('status', '') == 'Cleared' && bbHolds('Expenses', ['Add'])
          && bbChanged().hasOnly(['status', 'clearedDate', 'clearedById', 'clearedByName'])
          && bbIsMe(request.resource.data.get('clearedById', '')))
        || (request.resource.data.get('status', '') in ['Cancelled', 'Bounced'] && bbHolds('Expenses', ['Delete'])
          && bbChanged().hasOnly(['status', 'closedReason', 'closedAt', 'closedAtTs', 'closedById', 'closedByName'])
          && bbIsMe(request.resource.data.get('closedById', ''))));
    }

    /*
     * The voucher number series (`paymentVoucher`: { fy, next }), moved in the voucher's own
     * transaction. It restarts each financial year and never runs backwards (nextVoucherNo).
     */
    match /bankBalanceCounters/{counterId} {
      allow get: if bbHolds('Expenses', ['Add']);
      allow create: if bbHolds('Expenses', ['Add'])
        && request.resource.data.get('fy', '') is string && request.resource.data.get('next', 0) is int
        && request.resource.data.get('next', 0) > 1;
      allow update: if bbHolds('Expenses', ['Add'])
        && request.resource.data.get('fy', '') is string && request.resource.data.get('next', 0) is int
        && request.resource.data.get('next', 0) > 1
        && (request.resource.data.get('fy', '') > resource.data.get('fy', '')
          || (request.resource.data.get('fy', '') == resource.data.get('fy', '')
            && request.resource.data.get('next', 0) > resource.data.get('next', 0)));
    }

    /*
     * One document per cheque / DD number used on an account, so a number is never issued twice.
     * Taken with the voucher; freed only when that voucher is cancelled.
     */
    match /bankInstrumentNos/{instrumentKey} {
      allow get: if bbHolds('Expenses', ['Add', 'Delete']);
      allow create: if bbHolds('Expenses', ['Add']) && request.resource.data.get('voucherId', '') is string
        && request.resource.data.get('voucherId', '') != '';
      allow delete: if bbHolds('Expenses', ['Delete']);
    }

    /* Payment Entry settings and the payment-mode list; New Payment reads and adds to both. */
    function bbPaymentEntryReader() {
      return bbHolds('Payment Entry Settings', ['View', 'Edit']) || bbHolds('Expenses', ['Add']);
    }

    function bbPaymentEntryEditor() {
      return bbHolds('Payment Entry Settings', ['Edit']) || bbHolds('Expenses', ['Add']);
    }

    match /bankBalanceSettings/{settingId} {
      allow get: if bbPaymentEntryReader();
      allow create, update: if bbPaymentEntryEditor();
    }

    match /paymentMethods/{methodId} {
      allow read: if bbPaymentEntryReader();
      allow create, delete: if bbPaymentEntryEditor();
    }

    /* Actual interest per Cash Credit account, a document per month: entered on Monthly Interest. */
    match /monthlyInterest/{monthId} {
      allow read: if bbHolds('Monthly Interest', ['View', 'Edit']) || bbHolds('Reports', ['View']);
      allow create, update: if bbHolds('Monthly Interest', ['Edit']);
    }

    /* ── Loan (src/lib/permissions.ts, "Loan") ──────────────────────────────────────────────────
     *
     * The module's pages check nothing themselves beyond the reports' `Loan.Reports` View; the
     * sidebar shows Dashboard, Manage Loans and the EMI Tracker on `Loan.Dashboard` View, and the
     * module hub opens it on `Loan` View Module. So the rules take any Loan grant as the module's
     * reader, and any grant other than reports alone as its writer: creating a loan, closing one,
     * recording an EMI and rewriting a schedule are done from those pages by whoever reaches them.
     * Loans are never deleted; a schedule rewrite deletes and re-creates the EMIs.
     *
     * Budget: the permissions document (1).
     */
    function loanUser() {
      return holdsAnyOf(['Loan', 'Loan.Dashboard', 'Loan.Add Loan', 'Loan.Loan Details', 'Loan.Reports']);
    }

    function loanWriter() {
      return holdsAnyOf(['Loan', 'Loan.Dashboard', 'Loan.Add Loan', 'Loan.Loan Details']);
    }

    match /loans/{loanId} {
      allow read: if loanUser();
      allow create, update: if loanWriter();
    }

    match /loans/{loanId}/emis/{emiId} {
      allow read: if loanUser();
      allow write: if loanWriter();
    }

    /* ── Insurance (src/lib/permissions.ts, "Insurance"; src/lib/insurance-service.ts) ──────────────
     *
     * One book for the whole company, with no organisation or project scope: every screen reads a
     * collection whole and filters in the browser, so each collection is readable by whoever holds
     * a page that reads it, and written by the action that page checks. Personal policies (and their
     * holders, with dates of birth) stay closed to people who only work project insurance.
     *
     * My Tasks raises the workflow's tasks from the browser of whoever opens it (`syncInsuranceTasks`
     * reads every policy, asset and task), so My Tasks View reads both books. A task is worked by its
     * current `assignees` (users document ids from the workflow configuration, resolved by the
     * server's `getAssigneeForStep`); being assigned is the authority, so they read and move their own
     * task holding nothing else — My Work's `where assignees array-contains me` relies on that. Paying
     * a premium or settling a policy closes its open task (`completeTasksForDue`, a query on
     * `uniqueCheckId`), so the people who may do that read and close tasks too.
     *
     * Store & Stock lists the asset register's properties (`where type == 'Property'`) as stock
     * locations. The `workflows/insurance-workflow` document is not covered here.
     *
     * Budget: the permissions document only — 1 of 10.
     */
    function insHolds(page, actions) {
      return hasPermissions() && get(permissionsPath()).data.p.get('Insurance.' + page, []).hasAny(actions);
    }

    /** The caller's `users` id; '' when unknown, which then matches no one. */
    function insMe() {
      return hasPermissions() ? get(permissionsPath()).data.get('userDocId', '') : '';
    }

    function insModuleUser() {
      return holdsAnyOf([
        'Insurance', 'Insurance.Personal Insurance', 'Insurance.Project Insurance', 'Insurance.Premium Due',
        'Insurance.Maturity Due', 'Insurance.My Tasks', 'Insurance.Reports', 'Insurance.Settings',
        'Insurance.Settings.Holders', 'Insurance.Settings.Companies', 'Insurance.Settings.Categories',
        'Insurance.Settings.Assets'
      ]);
    }

    /*
     * Every page and form that reads personal policies, the task sync, the holder rename that
     * follows a holder's name onto its policies, and the in-use counts before a master is deleted.
     */
    function insPersonalReader() {
      return holdsAnyOf([
          'Insurance.Personal Insurance', 'Insurance.Premium Due', 'Insurance.Maturity Due', 'Insurance.My Tasks'
        ])
        || insHolds('Settings.Holders', ['Edit', 'Delete'])
        || insHolds('Settings.Companies', ['Delete'])
        || insHolds('Settings.Categories', ['Delete']);
    }

    function insProjectReader() {
      return holdsAnyOf(['Insurance.Project Insurance', 'Insurance.My Tasks'])
        || insHolds('Settings.Assets', ['Delete'])
        || insHolds('Settings.Companies', ['Delete'])
        || insHolds('Settings.Categories', ['Delete']);
    }

    /** Recording or editing a premium payment (`canManagePayments`), or settling the policy. */
    function insPersonalPayer() {
      return insHolds('Personal Insurance', ['Renew', 'Edit']);
    }

    function insChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /insurance_policies/{policyId} {
      allow read: if insPersonalReader();
      allow create: if insHolds('Personal Insurance', ['Add']);
      allow update: if insHolds('Personal Insurance', ['Edit'])
        // Recording the premium due moves the policy to its next due date (RenewalDialog).
        || (insHolds('Personal Insurance', ['Renew']) && insChanged().hasOnly([
          'due_date', 'last_renewed_at', 'last_payment_type', 'updatedAt', 'updatedBy', 'updatedByName'
        ]))
        // Renaming a holder renames them on their policies (policy-holders/page.tsx).
        || (insHolds('Settings.Holders', ['Edit']) && insChanged().hasOnly(['insured_person']));
      allow delete: if insHolds('Personal Insurance', ['Delete']);
    }

    /* Premiums paid. Deleted with the policy. */
    match /insurance_policies/{policyId}/renewals/{renewalId} {
      allow read: if insPersonalReader();
      allow create, update: if insPersonalPayer();
      allow delete: if insHolds('Personal Insurance', ['Delete']);
    }

    match /project_insurance_policies/{policyId} {
      allow read: if insProjectReader();
      allow create: if insHolds('Project Insurance', ['Add']);
      allow update: if insHolds('Project Insurance', ['Edit'])
        // A renewal replaces the cover's terms (ProjectRenewalDialog).
        || (insHolds('Project Insurance', ['Renew']) && insChanged().hasOnly([
          'policy_no', 'insurance_company', 'premium', 'sum_insured', 'insurance_start_date', 'insured_until',
          'tenure_years', 'tenure_months', 'status', 'attachments', 'updatedAt', 'updatedBy', 'updatedByName'
        ]))
        || (insHolds('Project Insurance', ['Mark as Not Required']) && insChanged().hasOnly(['status'])
          && request.resource.data.status == 'Not Required');
      allow delete: if insHolds('Project Insurance', ['Delete']);
    }

    /* The cover each renewal replaced. Append-only; deleted with the policy. */
    match /project_insurance_policies/{policyId}/history/{entryId} {
      allow read: if insProjectReader();
      allow create: if insHolds('Project Insurance', ['Renew']);
      allow delete: if insHolds('Project Insurance', ['Delete']);
    }

    /* ── The workflow's tasks ── */

    function insAssignee(data) {
      let me = insMe();
      return me != '' && data.get('assignees', []).hasAny([me]);
    }

    /** What a step action and a closing write touch; each adds one entry to the history. */
    function insTaskMove() {
      return insChanged().hasOnly(['status', 'currentStage', 'currentStepId', 'assignees', 'deadline', 'history'])
        && request.resource.data.get('history', []).size() == resource.data.get('history', []).size() + 1;
    }

    match /insuranceTasks/{taskId} {
      allow read: if insHolds('My Tasks', ['View'])
        || insPersonalPayer() || insHolds('Project Insurance', ['Renew'])
        || insAssignee(resource.data);
      // Raised by the sync on My Tasks, at the workflow's first step, for somebody.
      allow create: if insHolds('My Tasks', ['View'])
        && request.resource.data.get('status', '') == 'Pending'
        && request.resource.data.get('uniqueCheckId', '') is string
        && request.resource.data.get('uniqueCheckId', '') != ''
        && request.resource.data.get('assignees', []) is list
        && request.resource.data.get('assignees', []).size() > 0
        && request.resource.data.get('history', []).size() == 0;
      allow update: if insTaskMove() && (
        // The current step's assignee acting on it (my-tasks/page.tsx handleAction).
        insAssignee(resource.data)
        // Paying, renewing or settling closes the open task for that due date.
        || ((insPersonalPayer() || insHolds('Project Insurance', ['Renew']))
          && request.resource.data.status == 'Completed'
          && request.resource.data.assignees.size() == 0));
      // The escalation run (api/workflow/check-escalations) reassigns on the Admin SDK.
    }

    /* ── Masters ── */

    /* Insurer names and policy categories: nothing private, offered on every policy form. */
    match /insuranceCompanies/{companyId} {
      allow read: if insModuleUser();
      allow create: if insHolds('Settings.Companies', ['Add']);
      allow update: if insHolds('Settings.Companies', ['Edit']);
      allow delete: if insHolds('Settings.Companies', ['Delete']);
    }

    match /policyCategories/{categoryId} {
      allow read: if insModuleUser();
      allow create: if insHolds('Settings.Categories', ['Add']);
      allow update: if insHolds('Settings.Categories', ['Edit']);
      allow delete: if insHolds('Settings.Categories', ['Delete']);
    }

    /* The people personal policies cover, with their dates of birth. */
    match /policyHolders/{holderId} {
      allow read: if holdsAnyOf(['Insurance.Settings.Holders', 'Insurance.Personal Insurance']);
      allow create: if insHolds('Settings.Holders', ['Add']);
      allow update: if insHolds('Settings.Holders', ['Edit']);
      allow delete: if insHolds('Settings.Holders', ['Delete']);
    }

    /*
     * Projects and properties that project policies cover. Store & Stock treats the properties as
     * stock locations (store-stock-management/page.tsx, settings/stock-status) and switches their
     * stock on through api/inventory, on the Admin SDK.
     */
    match /insuredAssets/{assetId} {
      allow read: if holdsAnyOf(['Insurance.Settings.Assets', 'Insurance.Project Insurance', 'Insurance.My Tasks'])
        || (resource.data.get('type', '') == 'Property' && holdsAnyOf([
          'Store & Stock Management', 'Store & Stock Management.Inventory', 'Store & Stock Management.Projects',
          'Store & Stock Management.Settings'
        ]));
      allow create: if insHolds('Settings.Assets', ['Add']);
      allow update: if insHolds('Settings.Assets', ['Edit']);
      allow delete: if insHolds('Settings.Assets', ['Delete']);
    }

    /* ── Office Hub (src/lib/permissions.ts, "Office Hub"; src/lib/office-hub-permissions.ts) ─────
     *
     * Who may *see* a meeting or a task is decided in the browser from facts the rules cannot reach:
     * team membership is the `memberUserIds` of every team, department membership comes from the
     * employee directory (not `userPermissions.departmentIds`), and "leads a team" or "heads a
     * department" widens the view without any grant. The registers, the reports, a team's page, the
     * prepare page and search all read the module's collections whole. So everything is readable by
     * whoever may open the module (`canViewModule`), and closed to everyone else — except their own
     * rows, which the home dashboard and My Work read for anyone signed in: meetings they are invited
     * to, their invitations, and the tasks, decisions, action items and reminders that name them.
     *
     * Writes are where the rules say more. Organising or scheduling a meeting is the authority over it
     * (no grant needed); a task's assignee and creator, its team's leader and its department's head
     * work it; a decision's owner and an action item's responsible person work theirs; a participant
     * answers their own invitation, and while a meeting is In Progress its participants add agenda
     * items and notes; a team's leader manages the team. Beyond that each write needs the action its
     * screen checks. Identities that are stamped (`createdBy`, `updatedBy`, signatures) name the
     * caller. Nothing is hard-deleted except a participant row and an agenda item.
     *
     * Names are `users` document ids (`userPermissions.userDocId`), never the auth uid. Budget: the
     * permissions document (1), the parent meeting (1), the linked task (1), a team (1) and a
     * department (1) — at most 5 of 10. A series batch of ten new instances reads the permissions,
     * the series' first meeting and the ten instances: 12 of 20.
     */
    function ohHolds(page, actions) {
      return hasPermissions() && get(permissionsPath()).data.p.get('Office Hub.' + page, []).hasAny(actions);
    }

    /** May open the module at all: `canViewModule`, the layout's gate on every Office Hub screen. */
    function ohViewer() {
      return hasPermissions() && (
        get(permissionsPath()).data.p.get('Office Hub', []).hasAny(['View Module'])
        || ohHolds('Meetings', ['View', 'View All'])
        || ohHolds('Tasks', ['View', 'View All'])
        || ohHolds('Dashboard', ['View'])
        || ohHolds('Calendar', ['View']));
    }

    /**
     * Any Office Hub grant. What a write's side effects need — reference numbers, reminders, the task
     * trail, the recipients' preferences — including Mail Hub's "also create a task" on Tasks Create.
     */
    function ohAny() {
      return holdsAnyOf([
        'Office Hub', 'Office Hub.Dashboard', 'Office Hub.Calendar', 'Office Hub.Meetings', 'Office Hub.Agenda',
        'Office Hub.Attendance', 'Office Hub.Minutes', 'Office Hub.Decisions', 'Office Hub.Action Items',
        'Office Hub.Tasks', 'Office Hub.Teams', 'Office Hub.Employees', 'Office Hub.Documents',
        'Office Hub.Reports', 'Office Hub.Workload', 'Office Hub.Management Overview', 'Office Hub.Templates',
        'Office Hub.Settings'
      ]);
    }

    /** The caller's `users` id; '' when unknown, which then matches no one. */
    function ohMe() {
      return hasPermissions() ? get(permissionsPath()).data.get('userDocId', '') : '';
    }

    function ohIsMe(userId) {
      return ohMe() != '' && userId == ohMe();
    }

    function ohChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function ohUnchanged(fields) {
      return !ohChanged().hasAny(fields);
    }

    /** Every audited write restamps `updatedAt` (a server timestamp) with `updatedBy` = the actor. */
    function ohStamped() {
      return !ohChanged().hasAny(['updatedAt', 'updatedBy']) || ohIsMe(request.resource.data.get('updatedBy', null));
    }

    function ohCreatedByMe() {
      return ohIsMe(request.resource.data.get('createdBy', null));
    }

    /* ── Meetings ── */

    function ohMeetingPath(meetingId) {
      return /databases/$(database)/documents/officeHubMeetings/$(meetingId);
    }

    /** `isMeetingOrganizer`: the organiser, or whoever scheduled it in their name. */
    function ohOrganises(meeting) {
      return ohIsMe(meeting.get('organizerId', null)) || ohIsMe(meeting.get('scheduledById', null));
    }

    /** Runs the meeting: its organiser, or Meetings Edit over anyone's (`canEditMeeting`, `canRunMeeting`). */
    function ohRunsMeeting(meeting) {
      return ohOrganises(meeting) || ohHolds('Meetings', ['Edit']);
    }

    function ohInvited(meeting) {
      return ohMe() != '' && meeting.get('participantUserIds', []).hasAny([ohMe()]);
    }

    /**
     * The meeting a row belongs to, as it will stand after this write: a meeting, its participants
     * and its agenda are created in one batch. Guarded, so a stray id refuses rather than errors.
     */
    function ohMeetingAfter(meetingId) {
      return meetingId is string && meetingId != '' && hasPermissions() && existsAfter(ohMeetingPath(meetingId));
    }

    function ohMeetingExists(meetingId) {
      return meetingId is string && meetingId != '' && hasPermissions() && exists(ohMeetingPath(meetingId));
    }

    function ohRunsMeetingId(meetingId) {
      return ohMeetingExists(meetingId) && ohRunsMeeting(get(ohMeetingPath(meetingId)).data);
    }

    /** Agenda and notes: whoever runs the meeting, and its participants while it is In Progress (§18). */
    function ohShapesMeeting(meeting) {
      return ohRunsMeeting(meeting) || (meeting.get('status', '') == 'In Progress' && ohInvited(meeting));
    }

    /** A later occurrence of a series, raised by whoever may run its first meeting (`materializeSeriesInstances`). */
    function ohSeriesInstance(data) {
      return data.get('isSeriesParent', false) == false && ohMeetingExists(data.get('seriesId', null))
        && get(ohMeetingPath(data.seriesId)).data.get('organizerId', null) == data.get('organizerId', null)
        && (ohRunsMeeting(get(ohMeetingPath(data.seriesId)).data) || ohHolds('Meetings', ['Create']));
    }

    function ohMeetingUpdate(meetingId, changed) {
      return ohRunsMeeting(resource.data)
        // Cancelling, the occurrence or the series (`canCancelMeeting`).
        || (ohHolds('Meetings', ['Cancel']) && request.resource.data.get('status', '') == 'Cancelled'
          && changed.hasOnly(['status', 'cancellationReason', 'updatedAt', 'updatedBy', 'updatedByName']))
        // A cancelled occurrence becomes an exception on its series' first meeting.
        || (ohHolds('Meetings', ['Cancel']) && changed.hasOnly(['recurrence'])
          && resource.data.get('recurrence', null) is map && request.resource.data.get('recurrence', null) is map
          && request.resource.data.recurrence.diff(resource.data.recurrence).affectedKeys().hasOnly(['exceptions']))
        // Dragging it to another day on the calendar (`canRescheduleFromCalendar`).
        || ((ohHolds('Calendar', ['Reschedule']) || ohHolds('Meetings', ['Reschedule']))
          && changed.hasOnly(['date', 'startTime', 'endTime', 'timeZone', 'startAt', 'endAt',
            'updatedAt', 'updatedBy', 'updatedByName']))
        // A participant's answer recounts the meeting's tally (`respondToInvitation`).
        || (changed.hasOnly(['responseSummary']) && ohInvited(resource.data))
        // The minutes' stage, mirrored from the minutes written in the same batch (`advanceMom`).
        || (changed.hasOnly(['momStage'])
          && existsAfter(/databases/$(database)/documents/officeHubMom/$(meetingId))
          && getAfter(/databases/$(database)/documents/officeHubMom/$(meetingId)).data.get('stage', null)
            == request.resource.data.get('momStage', null));
    }

    match /officeHubMeetings/{meetingId} {
      // The registers, calendar, reports and search read every meeting; the dashboards ask
      // `participantUserIds array-contains me`, with no grant at all on the calendar tab.
      allow read: if ohViewer() || ohOrganises(resource.data) || ohInvited(resource.data);

      // From the form, by its scheduler, organised by themselves unless they may name somebody else.
      allow create: if ohCreatedByMe() && (
        (ohHolds('Meetings', ['Create']) && ohIsMe(request.resource.data.get('scheduledById', null))
          && (ohIsMe(request.resource.data.get('organizerId', null)) || ohHolds('Meetings', ['Change Organizer'])))
        || ohSeriesInstance(request.resource.data));

      allow update: if ohUnchanged(['createdBy', 'createdAt', 'scheduledById', 'organizationId'])
        && (ohUnchanged(['organizerId']) || ohHolds('Meetings', ['Change Organizer']))
        && ohStamped()
        && ohMeetingUpdate(meetingId, ohChanged());
      // Soft-deleted (`isDeleted`), never removed.
    }

    /* Invitations: `{meetingId}_{userId}`. Written with the meeting by whoever manages its list. */
    function ohManagesInvitations(meetingId) {
      return ohMeetingAfter(meetingId) && (
        ohRunsMeeting(getAfter(ohMeetingPath(meetingId)).data) || ohHolds('Meetings', ['Manage Participants']));
    }

    match /officeHubParticipants/{participantId} {
      allow read: if ohViewer() || ohIsMe(resource.data.get('userId', null));
      allow create: if ohCreatedByMe()
        && participantId == request.resource.data.get('meetingId', '') + '_' + request.resource.data.get('userId', '')
        && ohManagesInvitations(request.resource.data.get('meetingId', null));
      allow update: if ohUnchanged(['meetingId', 'userId', 'createdBy', 'createdAt']) && ohStamped() && (
        ohManagesInvitations(resource.data.get('meetingId', null))
        // Answering your own invitation, and only yours (`canRespondToInvitation`).
        || (ohIsMe(resource.data.get('userId', null)) && ohChanged().hasOnly([
          'response', 'responseMessage', 'respondedAt', 'updatedAt', 'updatedBy', 'updatedByName']))
        // Attendance Record over anyone's meeting (`canRecordAttendance`).
        || (ohHolds('Attendance', ['Record']) && ohIsMe(request.resource.data.get('attendanceMarkedById', null))
          && ohChanged().hasOnly(['attendance', 'attendanceNote', 'checkInAt', 'attendanceMarkedById',
            'attendanceMarkedByName', 'updatedAt', 'updatedBy', 'updatedByName'])));
      // Taking somebody off the list removes their invitation.
      allow delete: if ohManagesInvitations(resource.data.get('meetingId', null));
    }

    function ohAgendaWriter(meetingId) {
      return ohHolds('Agenda', ['Add', 'Edit', 'Delete'])
        || (ohMeetingAfter(meetingId) && ohShapesMeeting(getAfter(ohMeetingPath(meetingId)).data));
    }

    match /officeHubAgenda/{itemId} {
      allow read: if ohViewer();
      allow create: if ohCreatedByMe() && ohAgendaWriter(request.resource.data.get('meetingId', null));
      // Renumbering after a delete or a drag writes `order` alone.
      allow update: if ohUnchanged(['meetingId', 'createdBy', 'createdAt']) && ohStamped()
        && ohAgendaWriter(resource.data.get('meetingId', null));
      allow delete: if ohAgendaWriter(resource.data.get('meetingId', null));
    }

    /** One notes document per meeting, keyed by its id, auto-saved as it is typed. */
    match /officeHubNotes/{meetingId} {
      allow read: if ohViewer();
      allow create, update: if request.resource.data.get('meetingId', null) == meetingId
        && ohIsMe(request.resource.data.get('updatedBy', null))
        && (ohHolds('Minutes', ['Prepare'])
          || (ohMeetingAfter(meetingId) && ohShapesMeeting(getAfter(ohMeetingPath(meetingId)).data)));
    }

    /*
     * The minutes, keyed by the meeting id (§46, `canAdvanceMinutes`). The organiser or Minutes
     * Prepare writes them; each stage is signed by the caller, with its own grant: Review, Approve
     * (never by the preparer when approval is required), Publish or the organiser. The stage history
     * only grows, one entry per step.
     */
    function ohOrganisesId(meetingId) {
      return ohMeetingExists(meetingId) && ohOrganises(get(ohMeetingPath(meetingId)).data);
    }

    function ohMinuteTaker(meetingId) {
      return ohHolds('Minutes', ['Prepare']) || ohOrganisesId(meetingId);
    }

    function ohMomStageSigned(meetingId, after) {
      return (after.get('stage', '') == 'Prepared' && ohMinuteTaker(meetingId)
          && ohIsMe(after.get('preparedById', null)))
        || (after.get('stage', '') == 'Reviewed' && ohHolds('Minutes', ['Review'])
          && ohIsMe(after.get('reviewedById', null)))
        || (after.get('stage', '') == 'Approved' && ohHolds('Minutes', ['Approve'])
          && ohIsMe(after.get('approvedById', null))
          && (after.get('approvalRequired', false) != true || !ohIsMe(after.get('preparedById', null))))
        || (after.get('stage', '') == 'Published'
          && (ohHolds('Minutes', ['Publish']) || ohOrganisesId(meetingId)));
    }

    function ohMomAdvanceFields() {
      return [
        'stage', 'preparedById', 'preparedByName', 'preparedAt', 'reviewedById', 'reviewedByName', 'reviewedAt',
        'approvedById', 'approvedByName', 'approvedAt', 'publishedAt', 'history',
        'updatedAt', 'updatedBy', 'updatedByName'
      ];
    }

    match /officeHubMom/{meetingId} {
      allow read: if ohViewer();
      allow create: if request.resource.data.get('meetingId', meetingId) == meetingId && (
        // `saveMom` on a meeting with no minutes yet.
        (request.resource.data.get('stage', '') == 'Draft' && ohCreatedByMe() && ohMinuteTaker(meetingId))
        // `advanceMom` before anything was saved.
        || (request.resource.data.keys().hasOnly(ohMomAdvanceFields())
          && request.resource.data.get('history', []).size() == 1
          && ohIsMe(request.resource.data.get('updatedBy', null))
          && ohMomStageSigned(meetingId, request.resource.data)));
      allow update: if ohUnchanged(['meetingId', 'reference', 'createdBy', 'createdAt']) && ohStamped() && (
        (ohUnchanged(ohMomAdvanceFields().removeAll(['updatedAt', 'updatedBy', 'updatedByName']))
          && ohMinuteTaker(meetingId))
        || (ohChanged().hasOnly(ohMomAdvanceFields())
          && request.resource.data.get('history', []).size() == resource.data.get('history', []).size() + 1
          && ohMomStageSigned(meetingId, request.resource.data))
        // Publishing records who the minutes went to.
        || (ohChanged().hasOnly(['circulatedToUserIds', 'circulatedAt'])
          && resource.data.get('stage', '') == 'Published'
          && (ohHolds('Minutes', ['Publish']) || ohOrganisesId(meetingId))));
    }

    /* ── Decisions and action items ── */

    function ohTeamPath(teamId) {
      return /databases/$(database)/documents/officeHubTeams/$(teamId);
    }

    function ohLeadsTeam(teamId) {
      return teamId is string && teamId != '' && hasPermissions() && exists(ohTeamPath(teamId))
        && ohIsMe(get(ohTeamPath(teamId)).data.get('leaderId', null));
    }

    /** `departments.head` holds a `users` id when it names anybody (the settings page offers only N/A). */
    function ohHeadsDepartment(departmentId) {
      return departmentId is string && departmentId != '' && hasPermissions()
        && exists(/databases/$(database)/documents/departments/$(departmentId))
        && ohIsMe(get(/databases/$(database)/documents/departments/$(departmentId)).data.get('head', null));
    }

    function ohDecisionEditor(decision) {
      return ohIsMe(decision.get('ownerId', null)) || ohIsMe(decision.get('createdBy', null))
        || ohHolds('Decisions', ['Edit']);
    }

    match /officeHubDecisions/{decisionId} {
      allow read: if ohViewer() || ohIsMe(resource.data.get('ownerId', null));
      allow create: if ohHolds('Decisions', ['Create']) && ohCreatedByMe();
      allow update: if ohUnchanged(['createdBy', 'createdAt', 'reference', 'organizationId']) && ohStamped() && (
        ohDecisionEditor(resource.data)
        // The meeting's organiser edits the decisions recorded in it (the meeting and live pages).
        || ohRunsMeetingId(resource.data.get('meetingId', null))
        || (ohHolds('Decisions', ['Close']) && request.resource.data.get('status', '') == 'Completed'
          && ohChanged().hasOnly(['status', 'closedAt', 'updatedAt', 'updatedBy', 'updatedByName'])));
      // Soft-deleted (`isDeleted`), never removed.
    }

    function ohTaskPath(taskId) {
      return /databases/$(database)/documents/officeHubTasks/$(taskId);
    }

    function ohTaskExists(taskId) {
      return taskId is string && taskId != '' && hasPermissions() && exists(ohTaskPath(taskId));
    }

    function ohStamps() {
      return ['updatedAt', 'updatedBy', 'updatedByName'];
    }

    function ohActionItemUpdate(itemId, changed) {
      return ohIsMe(resource.data.get('responsibleUserId', null)) || ohIsMe(resource.data.get('createdBy', null))
        || ohHolds('Action Items', ['Edit', 'Complete'])
        || ohLeadsTeam(resource.data.get('responsibleTeamId', null))
        || ohRunsMeetingId(resource.data.get('meetingId', null))
        // Carried into a later meeting by whoever prepares it (prepare page, or a follow-up's creation).
        || (changed.hasOnly(['carriedToMeetingId'].concat(ohStamps()))
          && (ohHolds('Agenda', ['Add', 'Edit'])
            || ohRunsMeetingId(request.resource.data.get('carriedToMeetingId', null))))
        // Linked to the task raised from it (`canConvertActionItem`).
        || (changed.hasOnly(['taskId'].concat(ohStamps()))
          && (ohHolds('Action Items', ['Convert to Task']) || ohHolds('Tasks', ['Create']))
          && ohTaskExists(request.resource.data.get('taskId', null))
          && get(ohTaskPath(request.resource.data.taskId)).data.get('actionItemId', null) == itemId)
        // Closed by whoever completes the task raised from it.
        || (changed.hasOnly(['status', 'completedAt'].concat(ohStamps()))
          && request.resource.data.get('status', '') == 'Completed'
          && ohTaskExists(resource.data.get('taskId', null))
          && get(ohTaskPath(resource.data.taskId)).data.get('actionItemId', null) == itemId
          && get(ohTaskPath(resource.data.taskId)).data.get('status', '') == 'Completed');
    }

    match /officeHubActionItems/{itemId} {
      allow read: if ohViewer() || ohIsMe(resource.data.get('responsibleUserId', null));
      allow create: if ohHolds('Action Items', ['Create']) && ohCreatedByMe();
      allow update: if ohUnchanged(['createdBy', 'createdAt', 'reference', 'organizationId']) && ohStamped()
        && ohActionItemUpdate(itemId, ohChanged());
    }

    /* ── Tasks ── */

    /** `canEditTask`: the assignee, the creator, the team's leader, the department's head, or Tasks Edit. */
    function ohTaskEditor(task) {
      return ohIsMe(task.get('assigneeId', null)) || ohIsMe(task.get('createdBy', null))
        || ohHolds('Tasks', ['Edit'])
        || ohLeadsTeam(task.get('teamId', null))
        || ohHeadsDepartment(task.get('departmentId', null));
    }

    function ohTaskUpdate(changed) {
      return ohTaskEditor(resource.data)
        // Reassigning (`canAssignTask`) and completing (`canCompleteTaskAs`) on their own grants.
        || (ohHolds('Tasks', ['Assign']) && changed.hasOnly([
          'assigneeId', 'assigneeName', 'teamId', 'teamName', 'watcherUserIds', 'progress'].concat(ohStamps())))
        || (ohHolds('Tasks', ['Complete']) && changed.hasOnly([
          'status', 'progress', 'completedAt', 'completedById', 'completedByName', 'reopenedAt'].concat(ohStamps())))
        // A comment counts itself and makes its author (and whoever it mentions) a watcher.
        || (ohHolds('Tasks', ['Comment', 'View', 'View All'])
          && changed.hasOnly(['commentCount', 'watcherUserIds'].concat(ohStamps()))
          && request.resource.data.get('commentCount', 0) == resource.data.get('commentCount', 0) + 1
          && request.resource.data.get('watcherUserIds', []).hasAll(resource.data.get('watcherUserIds', [])))
        // The far end of a dependency mirrors the link (`addTaskDependency`, `removeTaskDependency`).
        || (ohViewer() && changed.hasOnly(['dependencies']))
        // An attachment uploaded on the task (`uploadOfficeHubDocument`).
        || (ohHolds('Documents', ['Upload']) && changed.hasOnly(['documentIds'])
          && request.resource.data.get('documentIds', []).hasAll(resource.data.get('documentIds', [])));
    }

    match /officeHubTasks/{taskId} {
      // My Work asks `assigneeId == me` and `watcherUserIds array-contains me`.
      allow read: if ohViewer() || ohIsMe(resource.data.get('assigneeId', null))
        || ohIsMe(resource.data.get('createdBy', null))
        || (ohMe() != '' && resource.data.get('watcherUserIds', []).hasAny([ohMe()]));
      // Raised from the form, from an action item (`canConvertActionItem`), or from Mail Hub.
      allow create: if (ohHolds('Tasks', ['Create']) || ohHolds('Action Items', ['Convert to Task']))
        && ohCreatedByMe();
      allow update: if ohUnchanged(['createdBy', 'createdAt', 'reference', 'organizationId']) && ohStamped() && (
        // A soft delete (`archiveTask`) has its own grant.
        ohChanged().hasAny(['isDeleted', 'deletedAt', 'deletedBy', 'deletedByName'])
          ? ohHolds('Tasks', ['Delete'])
          : ohTaskUpdate(ohChanged()));
    }

    /** Posted as yourself; never edited. */
    match /officeHubTaskComments/{commentId} {
      allow read: if ohViewer();
      allow create: if ohHolds('Tasks', ['Comment', 'View', 'View All']) && ohCreatedByMe()
        && request.resource.data.get('taskId', null) is string;
    }

    /** Append-only: written beside every change to a task, by whoever made it. */
    match /officeHubTaskActivity/{entryId} {
      allow read: if ohViewer();
      allow create: if ohAny() && ohIsMe(request.resource.data.get('actorId', null)) && ohCreatedByMe();
    }

    /* ── Teams ── */

    /*
     * The directory's active teams are read on every Office Hub screen. A team's leader manages it;
     * changing the leader is the leader's or Change Leader's, archiving is Archive's.
     */
    match /officeHubTeams/{teamId} {
      allow read: if ohAny();
      allow create: if ohHolds('Teams', ['Create']) && ohCreatedByMe();
      allow update: if ohUnchanged(['createdBy', 'createdAt', 'organizationId']) && ohStamped() && (
        ohChanged().hasAny(['status', 'archivedAt', 'archivedReason'])
          ? ohHolds('Teams', ['Archive'])
          : ((ohIsMe(resource.data.get('leaderId', null)) || ohIsMe(resource.data.get('createdBy', null))
              || ohHolds('Teams', ['Edit', 'Manage Members', 'Change Leader']))
            && (ohUnchanged(['leaderId']) || ohIsMe(resource.data.get('leaderId', null))
              || ohHolds('Teams', ['Change Leader']))
            && (ohUnchanged(['memberUserIds']) || ohIsMe(resource.data.get('leaderId', null))
              || ohHolds('Teams', ['Edit', 'Manage Members', 'Change Leader']))));
    }

    /* ── Files, reminders, templates and settings ── */

    function ohMayRemoveDocument(document) {
      return ohHolds('Documents', ['Delete']) || ohIsMe(document.get('uploadedById', null))
        || ohRunsMeetingId(document.get('meetingId', null))
        || (document.get('entityType', '') == 'task' && ohTaskExists(document.get('entityId', null))
          && ohTaskEditor(get(ohTaskPath(document.entityId)).data))
        || (document.get('entityType', '') == 'decision' && document.get('entityId', '') is string
          && document.get('entityId', '') != ''
          && exists(/databases/$(database)/documents/officeHubDecisions/$(document.entityId))
          && ohDecisionEditor(get(/databases/$(database)/documents/officeHubDecisions/$(document.entityId)).data));
    }

    /** Uploaded as yourself; removed by a soft delete, so published minutes keep their files. */
    match /officeHubDocuments/{documentId} {
      allow read: if ohViewer();
      allow create: if ohHolds('Documents', ['Upload']) && ohCreatedByMe()
        && ohIsMe(request.resource.data.get('uploadedById', null));
      allow update: if ohChanged().hasOnly(['isDeleted', 'deletedAt', 'deletedBy', 'deletedByName'].concat(ohStamps()))
        && request.resource.data.get('isDeleted', false) == true
        && ohIsMe(request.resource.data.get('deletedBy', null))
        && ohMayRemoveDocument(resource.data);
    }

    /*
     * Reminder rows for every participant or assignee, written and cancelled by whoever saves the
     * meeting or task (deterministic ids, so a reschedule overwrites them). The cancel query has no
     * user filter. The server's sweep marks them sent.
     */
    match /officeHubReminders/{reminderId} {
      allow read: if ohAny() || ohIsMe(resource.data.get('userId', null));
      allow create: if ohAny() && request.resource.data.get('status', '') == 'Scheduled'
        && request.resource.data.get('userId', null) is string;
      allow update: if ohAny() && request.resource.data.get('status', '') in ['Scheduled', 'Cancelled']
        && request.resource.data.get('userId', null) == resource.data.get('userId', null);
    }

    match /officeHubMeetingTemplates/{templateId} {
      allow read: if ohAny();
      allow create, update: if ohHolds('Templates', ['Add', 'Edit']);
      // Using a template counts it (`createMeeting`).
      allow update: if ohHolds('Meetings', ['Create']) && ohChanged().hasOnly(['usageCount'])
        && request.resource.data.get('usageCount', 0) == resource.data.get('usageCount', 0) + 1;
    }

    match /officeHubAgendaTemplates/{templateId} {
      allow read: if ohAny();
      allow create, update: if ohHolds('Templates', ['Add', 'Edit']);
    }

    match /officeHubSettings/{settingsId} {
      allow get: if ohAny();
      allow create, update: if ohHolds('Settings', ['Edit']);
    }

    /* A person's own preferences; every notification reads its recipients'. */
    match /officeHubUserSettings/{userId} {
      allow get: if ohIsMe(userId) || ohAny();
      allow create, update: if ohIsMe(userId);
    }

    /*
     * Reference numbers (TSK, DEC, ACT, MOM per financial year), allocated in a transaction by
     * whoever raises the record. Nothing secret; a counter only ever moves on by one.
     */
    match /officeHubCounters/{counterId} {
      allow get: if ohAny();
      allow create: if ohAny() && request.resource.data.get('value', 0) == 1;
      allow update: if ohAny() && request.resource.data.get('value', 0) is int
        && request.resource.data.get('value', 0) == resource.data.get('value', 0) + 1;
    }

    /* ── Expenses (src/lib/permissions.ts, "Expenses"; src/lib/expenses-roles.ts) ───────────────
     *
     * Two answers decide who acts, as on every screen (useExpensesActor):
     *   - the permission map: `Expenses.<Page>` and, per department, `Expenses.Departments.<id>`
     *     (Create raises, Edit edits) and `Expenses.Settings.<id>` (Edit Serial Nos) — the scoped
     *     key or the unscoped page, as `can(action, page, departmentId)` reads them;
     *   - Settings › User Roles (`expensesSettings/user-roles`): an action set to `assigned-too` or
     *     `assigned-only` lets the people it names act holding nothing. Named means a users id in
     *     the pair for the action (its department's, for a by-department assignment; any of the
     *     first four amount bands that covers the amount), or holding one of its roles — by name,
     *     or for a write by role document id (the first two). `assigned-only` also narrows who may
     *     act; that half stays with the screens, so a role permission still passes here.
     *
     * Expense requests are read whole by the module's own pages — the create form and the import
     * check every request number and party in the module, whatever the department — and by Daily
     * Requisition (linking and receiving, the entry sheet's print), Site Fund Request / Requisition
     * (their registers show each request's expense request) and Loan (the EMI's request), so
     * department scope is not a read boundary. `expRequestReader` is everyone those screens admit
     * by a grant or a User Roles assignment — except Site Fund Request's project-access members, who
     * hold no grant at all and whose register reads every request in the same Promise.all as its
     * own. Until that register stops failing without them, any signed-in user reads requests.
     * Daily Requisition writes only the reception link, from any of its screens.
     * Account heads, serial configurations and the settings documents are masters every one of
     * those screens (and Recurring Payments' step form) reads: open to any signed-in user.
     *
     * Names are `users` document ids (`userPermissions.userDocId`), never the auth uid. Budget: the
     * permissions document (1), the User Roles document (1), and for a write up to two role
     * documents per action consulted (raise and import: 4) — 6 of 10; a request raised with its
     * serial number touches the same paths for both documents.
     */
    function expP() {
      return get(permissionsPath()).data.p;
    }

    /** Any grant at all in one of these modules (`canAccessModule`: the module key or a page under it). */
    function expInModules(modules) {
      return hasPermissions()
        && expP().keys().join('|').matches('(.*[|])?(' + modules + ')([.][^|]*)?([|].*)?');
    }

    function expHolds(page, action) {
      return hasPermissions() && expP().get('Expenses.' + page, []).hasAny([action]);
    }

    /** `can(action, 'Expenses.<page>', scope)`: the scoped grant, or the page's own. */
    function expHoldsFor(page, scope, action) {
      return hasPermissions() && scope is string
        && (expP().get('Expenses.' + page + '.' + scope, []).hasAny([action])
          || expP().get('Expenses.' + page, []).hasAny([action]));
    }

    /** The caller's `users` id; '' when unknown, which then matches no one. */
    function expMe() {
      return hasPermissions() ? get(permissionsPath()).data.get('userDocId', '') : '';
    }

    function expIsMe(userId) {
      return expMe() != '' && userId == expMe();
    }

    function expRolesPath() {
      return /databases/$(database)/documents/expensesSettings/user-roles;
    }

    /** The stored assignment for one action; {} (nobody, roles decide) when there is none. */
    function expAssignment(key) {
      return exists(expRolesPath()) ? get(expRolesPath()).data.get('actions', {}).get(key, {}) : {};
    }

    function expInPair(pair, me) {
      return pair is map && (pair.get('primary', []).hasAny([me]) || pair.get('alternates', []).hasAny([me]));
    }

    /** Band `i` names the caller and, when an amount is known, covers it. */
    function expInBand(bands, i, amount, me) {
      return bands.size() > i && expInPair(bands[i], me)
        && (amount == null
          || ((bands[i].get('from', null) == null || amount >= bands[i].get('from', null))
            && (bands[i].get('to', null) == null || amount <= bands[i].get('to', null))));
    }

    function expRoleIdHeld(ids, i) {
      return ids.size() > i && ids[i] is string && ids[i] != ''
        && exists(/databases/$(database)/documents/roles/$(ids[i]))
        && get(/databases/$(database)/documents/roles/$(ids[i])).data.get('name', '')
          in get(permissionsPath()).data.get('roleNames', []);
    }

    function expInRoles(pair, me, lookupRoles) {
      return pair is map && (pair.get('alternates', []).hasAny([me])
        || pair.get('primary', []).hasAny(get(permissionsPath()).data.get('roleNames', []))
        || (lookupRoles && (expRoleIdHeld(pair.get('primary', []), 0) || expRoleIdHeld(pair.get('primary', []), 1))));
    }

    /*
     * Named on this action in User Roles, with the assignment carrying authority (resolveExpensesRolesDoc
     * and mayAct). `departmentId` null asks about no department (a by-department assignment then
     * names no one); `amount` null asks about any band.
     */
    function expNamed(key, scoped, banded, departmentId, amount, lookupRoles) {
      let a = expAssignment(key);
      let me = expMe();
      let stored = a.get('type', 'users');
      let type = (stored == 'department' && !scoped) || (stored == 'amount' && !banded) ? 'users' : stored;
      return me != '' && a.get('mode', 'roles-only') in ['assigned-too', 'assigned-only'] && (
        type == 'roles' ? expInRoles(a.get('roles', {}), me, lookupRoles)
        : type == 'department' ? (departmentId is string && expInPair(a.get('byDepartment', {}).get(departmentId, {}), me))
        : type == 'amount' ? (expInBand(a.get('bands', []), 0, amount, me) || expInBand(a.get('bands', []), 1, amount, me)
          || expInBand(a.get('bands', []), 2, amount, me) || expInBand(a.get('bands', []), 3, amount, me))
        : expInPair(a.get('users', {}), me));
    }

    /** Everyone who reads the request register whole (see above). */
    function expRequestReader() {
      return expInModules('Expenses|Daily Requisition|Site Fund Request|Site Fund Requisition|Site Fund Requisition 2|Loan')
        || expNamed('raise-request', true, true, null, null, false)
        || expNamed('edit-request', true, true, null, null, false)
        || expNamed('import-requests', true, false, null, null, false)
        || expNamed('view-reports', false, false, null, null, false);
    }

    /** May raise (the create form, `raise-request`) or import (`import-requests`) into this department. */
    function expRaiser(departmentId, amount) {
      return expHoldsFor('Departments', departmentId, 'Create')
        || expNamed('raise-request', true, true, departmentId, amount, true)
        || expNamed('import-requests', true, false, departmentId, null, true);
    }

    function expChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /expenseRequests/{requestId} {
      // Becomes `expRequestReader()` once Site Fund Request's registers survive a refusal (see above).
      allow read: if signedIn();

      // Raised or imported as yourself, into a department you may raise in. The Admin SDK raises
      // the requests Loan, Recurring Payments and Site Fund Request create (createExpenseRequest).
      allow create: if request.resource.data.get('departmentId', '') is string
        && request.resource.data.get('departmentId', '') != ''
        && expIsMe(request.resource.data.get('generatedByUserId', ''))
        && expRaiser(request.resource.data.departmentId, request.resource.data.get('amount', 0));

      // The department register's edit (Edit on the department, or `edit-request` at the amount
      // saved), which never moves a request, renumbers it or touches its reception; and Daily
      // Requisition receiving, releasing or relinking it, which touches nothing else.
      allow update: if (expChanged().hasOnly([
            'projectId', 'amount', 'partyName', 'headOfAccount', 'subHeadOfAccount', 'description', 'remarks', 'statutory',
            'gstRegistrationId'
          ])
          && (expHoldsFor('Departments', resource.data.get('departmentId', ''), 'Edit')
            || expNamed('edit-request', true, true, resource.data.get('departmentId', ''),
              request.resource.data.get('amount', 0), true)))
        || (expChanged().hasOnly(['receptionNo', 'receptionDate']) && expInModules('Daily Requisition'));
      // Requests are never deleted from the browser.
    }

    /*
     * Each department's request-number series, keyed by department id. Set on Settings (Edit Serial
     * Nos for the department, or `manage-serials`); moved on, and only forward, by the transaction
     * that raises or imports a request in that department.
     */
    match /departmentSerialConfigs/{departmentId} {
      allow get: if signedIn();
      allow create: if (expHoldsFor('Settings', departmentId, 'Edit Serial Nos')
          || expNamed('manage-serials', true, false, departmentId, null, true))
        && request.resource.data.get('startingIndex', 0) is int && request.resource.data.get('startingIndex', 0) >= 1;
      allow update: if ((expHoldsFor('Settings', departmentId, 'Edit Serial Nos')
          || expNamed('manage-serials', true, false, departmentId, null, true))
          && request.resource.data.get('startingIndex', 0) is int && request.resource.data.get('startingIndex', 0) >= 1)
        || (expChanged().hasOnly(['startingIndex']) && expRaiser(departmentId, null)
          && request.resource.data.get('startingIndex', 0) is int
          && (!(resource.data.get('startingIndex', 0) is int)
            || request.resource.data.get('startingIndex', 0) > resource.data.get('startingIndex', 0)));
    }

    /* Head and Sub-Head of A/c: every request is booked under them; Manage Accounts keeps the list. */
    function expAccountsManager() {
      return expHolds('Settings', 'Manage Accounts') || expNamed('manage-accounts', false, false, null, null, true);
    }

    match /accountHeads/{headId} {
      allow read: if signedIn();
      allow write: if expAccountsManager();
    }

    match /subAccountHeads/{subHeadId} {
      allow read: if signedIn();
      allow write: if expAccountsManager();
    }

    /*
     * `module-config` (Field and Data Control), `gst-registrations` (the company's GSTINs and how a
     * bill is attributed to one; Daily Requisition and Bill Tracking read it too) and `user-roles`.
     * Each is written whole by its own page, stamped with the writer. Field and Data Control share
     * one document, so either page's editors write it (useExpensesControlAccess). Who acts is not
     * itself assignable: User Roles is written on its permission alone.
     */
    function expControlEditor() {
      return expHolds('Field Control', 'Edit') || expHolds('Data Control', 'Edit')
        || expHolds('Settings', 'Manage Accounts') || expHolds('Settings', 'Edit Serial Nos')
        || expNamed('field-control', false, false, null, null, true)
        || expNamed('data-control', false, false, null, null, true);
    }

    match /expensesSettings/{settingId} {
      allow get: if signedIn();
      allow create, update: if (settingId == 'module-config' && expControlEditor()
          && expIsMe(request.resource.data.get('updatedBy', '')))
        || (settingId == 'gst-registrations'
          && (expHolds('GST Registrations', 'Edit') || expHolds('Settings', 'Manage Accounts')
            || expNamed('gst-registrations', false, false, null, null, true))
          && expIsMe(request.resource.data.get('updatedById', '')))
        || (settingId == 'user-roles'
          && (expHolds('User Roles', 'Edit') || expHolds('Settings', 'Manage Accounts'))
          && expIsMe(request.resource.data.get('updatedById', '')));
    }

    /* ── Daily Requisition (src/lib/permissions.ts, "Daily Requisition") ────────────────────────
     *
     * A requisition names nobody who may work it (no owner, no assignee, no project): every screen
     * checks a page permission, so the rules follow those alone. Each page reads the register
     * whole — the dashboard, Entry Sheet, Manage Documents, the reports, the checklist print and
     * each workflow stage (`where status in […]`) — so anyone holding a grant on one of those pages
     * reads every requisition. The stages are Workflow Configuration's, gated as
     * `Daily Requisition.<stage name>`; the three names here are the shipped ones the permission
     * tree and the work dashboard use. A renamed stage's grant is not recognised.
     *
     * Readers outside the module: the Expenses pages (the register's progress column, the raise
     * form's party list, the import's duplicate check, the reports' payments), which anyone with an
     * Expenses grant or named in Expenses › User Roles opens — the same test Expenses' own rules
     * use (`expRequestReader`); and Bank Balance, which lists what is awaiting payment for New
     * Payment (Expenses Add) and re-reads by id the requisitions a voucher pays or a cancel or
     * bounce reverses (Expenses Add / Delete).
     *
     * Writes follow the screen: Entry Sheet adds, edits the form's own fields and deletes; a stage
     * moves a requisition to the status its action sets; Manage Documents keeps the attachments
     * and their status; a Bank Balance voucher records a payment, and its cancel takes it back.
     * Once money is recorded against a requisition (`isPaymentLocked`) only its description, its
     * documents and Bank Balance may touch it, and it is never deleted.
     *
     * Stamps (`receivedById`, `paidById`, `documentStatusUpdatedById`) are not checked: Switch User
     * writes the impersonated user's id under the administrator's sign-in.
     *
     * Budget: the permissions document (1) and, for a read, Expenses' User Roles document (1) —
     * 2 of 10. A voucher's or a stage's transaction touches the same paths for every requisition.
     */
    function drHolds(resource, actions) {
      return hasPermissions() && get(permissionsPath()).data.p.get(resource, []).hasAny(actions);
    }

    function drPage(page, actions) {
      return drHolds('Daily Requisition.' + page, actions);
    }

    /** The shipped workflow stages (workflow-configuration/page.tsx DEFAULT steps). */
    function drReceiving(actions) {
      return drPage('Receiving at Finance', actions);
    }

    function drVerification(actions) {
      return drPage('GST & TDS Verification', actions);
    }

    function drPayment(actions) {
      return drPage('Processed for Payment', actions);
    }

    /** Any grant on a page that shows the register (dailyRequisitionAccess, the dashboard's canView). */
    function drModuleReader() {
      return holdsAnyOf([
        'Daily Requisition.Entry Sheet', 'Daily Requisition.Receiving at Finance',
        'Daily Requisition.GST & TDS Verification', 'Daily Requisition.Processed for Payment',
        'Daily Requisition.Manage Documents', 'Daily Requisition.Reports'
      ])
        // GST & TDS by Registration also opens for the Expenses registrations page's viewers.
        || drHolds('Expenses.GST Registrations', ['View']);
    }

    /* ── Expenses' readers: the same answer as expRequestReader, for the requests' register ── */

    function drMe() {
      return hasPermissions() ? get(permissionsPath()).data.get('userDocId', '') : '';
    }

    function drExpRolesPath() {
      return /databases/$(database)/documents/expensesSettings/user-roles;
    }

    function drExpInPair(pair, me) {
      return pair is map && (pair.get('primary', []).hasAny([me]) || pair.get('alternates', []).hasAny([me]));
    }

    function drExpInBand(bands, i, me) {
      return bands.size() > i && drExpInPair(bands[i], me);
    }

    /*
     * Named on an Expenses action (src/lib/expenses-roles.ts mayAct) with the assignment carrying
     * authority, in any department and any amount band.
     */
    function drExpNamed(key, scoped, banded) {
      let a = exists(drExpRolesPath()) ? get(drExpRolesPath()).data.get('actions', {}).get(key, {}) : {};
      let me = drMe();
      let stored = a.get('type', 'users');
      let type = (stored == 'department' && !scoped) || (stored == 'amount' && !banded) ? 'users' : stored;
      return me != '' && a.get('mode', 'roles-only') in ['assigned-too', 'assigned-only'] && (
        type == 'roles' ? (a.get('roles', {}) is map && (a.get('roles', {}).get('alternates', []).hasAny([me])
            || a.get('roles', {}).get('primary', []).hasAny(get(permissionsPath()).data.get('roleNames', []))))
        : type == 'department' ? false
        : type == 'amount' ? (drExpInBand(a.get('bands', []), 0, me) || drExpInBand(a.get('bands', []), 1, me)
          || drExpInBand(a.get('bands', []), 2, me) || drExpInBand(a.get('bands', []), 3, me))
        : drExpInPair(a.get('users', {}), me));
    }

    function drExpensesReader() {
      return hasPermissions() && (
        get(permissionsPath()).data.p.keys().join('|').matches('(.*[|])?Expenses([.][^|]*)?([|].*)?')
        || drExpNamed('raise-request', true, true) || drExpNamed('edit-request', true, true)
        || drExpNamed('import-requests', true, false) || drExpNamed('view-reports', false, false));
    }

    /* ── The requisition's state ── */

    /** Money recorded against it (src/lib/requisition-progress.ts isPaymentLocked). */
    function drLocked(data) {
      return data.get('payments', []).size() > 0
        || (data.get('paidAmount', 0) is number && data.get('paidAmount', 0) > 0)
        || data.get('status', '') in ['Partially Paid', 'Paid'];
    }

    function drChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function drNewStatus() {
      return request.resource.data.get('status', '');
    }

    /** What a Bank Balance voucher writes (expenses/new foldPayments, cheques reversePayment). */
    function drPaymentFieldsOnly() {
      return drChanged().hasOnly(['paidAmount', 'payments', 'status', 'paidAt', 'lastPaidAt']);
    }

    /*
     * The action each status is reached by ([step]/page.tsx, ViewDailyRequisitionDialog,
     * GstTdsVerificationDialog): received or returned at Finance (or sent back from verification,
     * which clears it), cancelled, verified or flagged, sent for payment, paid by hand. Where it
     * comes from is not checked beyond that: the stage page re-reads it and moves only what is
     * still in the status it showed.
     */
    function drMayMoveTo(from, status) {
      return status == 'Pending' ? (drReceiving(['Return to Pending']) || drVerification(['Return to Pending'])
          || drPayment(['Return to Pending']))
        : status == 'Received' ? (drReceiving(['Mark as Received'])
          || (from in ['Verified', 'Needs Review'] && drVerification(['Return to Pending'])))
        : status == 'Cancelled' ? (drReceiving(['Reject', 'Cancel']) || drVerification(['Reject', 'Cancel'])
          || drPayment(['Reject', 'Cancel']))
        : status in ['Verified', 'Needs Review'] ? drVerification(['Verify', 'Re-verify'])
        : status == 'Received for Payment' ? (drPayment(['Mark as Received for Payment', 'Approve'])
          || drVerification(['Send for Payment']))
        : status == 'Paid' ? drPayment(['Mark as Received for Payment', 'Approve'])
        : false;
    }

    /** A stage's move: the status, its stamps, and verification's figures (or their clearing). */
    function drStageMove() {
      return !drLocked(resource.data) && drMayMoveTo(resource.data.get('status', ''), drNewStatus())
        && drChanged().hasOnly([
          'status', 'receivedAt', 'receivedById', 'verifiedAt', 'igstAmount', 'tdsAmount', 'cgstAmount',
          'sgstAmount', 'retentionAmount', 'otherDeduction', 'verificationNotes', 'gstNo', 'gstType', 'gstRate',
          'gstRegistrationId', 'netAmount', 'paidAt', 'paidAmount', 'manualPaid', 'paidById', 'paidByName'
        ])
        // Paid by hand only from Processed for Payment, and only then with the paid figures.
        && (drNewStatus() == 'Paid'
          || !drChanged().hasAny(['paidAt', 'paidAmount', 'manualPaid', 'paidById', 'paidByName']));
    }

    /** The Entry Sheet's edit form; a paid requisition keeps everything but its description. */
    function drEntryEdit() {
      return drPage('Entry Sheet', ['Edit'])
        && drChanged().hasOnly(drLocked(resource.data)
          ? ['description']
          : ['date', 'projectId', 'departmentId', 'partyName', 'description', 'grossAmount', 'netAmount']);
    }

    /** Manage Documents (and the view dialog's document buttons); files only with Upload. */
    function drDocuments() {
      return drChanged().hasOnly(['documentStatus', 'documentStatusUpdatedById', 'documentStatusUpdatedAt', 'attachments'])
        && (drChanged().hasAny(['attachments'])
          ? drPage('Manage Documents', ['Upload'])
          : drPage('Manage Documents', ['Upload', 'Mark as Missing', 'Not Required', 'Mark as Not Required', 'Move to Pending']));
    }

    /** New Payment: a voucher pays what is awaiting payment, and records the line. */
    function drVoucherPays() {
      return drHolds('Bank Balance.Expenses', ['Add']) && drPaymentFieldsOnly()
        && resource.data.get('status', '') in ['Received for Payment', 'Partially Paid']
        && drNewStatus() in ['Partially Paid', 'Paid']
        && request.resource.data.get('payments', []).size() > resource.data.get('payments', []).size();
    }

    /*
     * The Cheque Register cancelling or bouncing a voucher: its lines come off, and the status is
     * recomputed only while the requisition is in the payment stage.
     */
    function drVoucherReversed() {
      return drHolds('Bank Balance.Expenses', ['Delete']) && drPaymentFieldsOnly()
        && request.resource.data.get('payments', []).size() <= resource.data.get('payments', []).size()
        && (drNewStatus() == resource.data.get('status', '')
          || (resource.data.get('status', '') in ['Received for Payment', 'Partially Paid', 'Paid']
            && drNewStatus() in ['Received for Payment', 'Partially Paid', 'Paid']));
    }

    match /dailyRequisitions/{requisitionId} {
      allow read: if drModuleReader() || drExpensesReader();
      // A voucher re-reads by id what it pays or reverses, whatever has happened to it since.
      allow get: if drHolds('Bank Balance.Expenses', ['Add', 'Delete']);
      // New Payment's list: `where status in ['Received for Payment', 'Partially Paid']`.
      allow list: if drHolds('Bank Balance.Expenses', ['Add'])
        && resource.data.status in ['Received for Payment', 'Partially Paid'];

      // The entry form, Receive Multiple and the import (which may bring paid history with it).
      allow create: if drPage('Entry Sheet', ['Add']);
      allow update: if drEntryEdit() || drStageMove() || drDocuments() || drVoucherPays() || drVoucherReversed();
      allow delete: if drPage('Entry Sheet', ['Delete']) && !drLocked(resource.data);
    }

    /*
     * Field Control and Data Control: one document (`module-config`), written whole by either
     * page. Read by the Entry Sheet and the import for everyone who records requisitions; a read
     * failure falls back to the shipped defaults. Nothing in it is sensitive.
     */
    match /dailyRequisitionSettings/{settingId} {
      allow read: if signedIn();
      allow create, update: if settingId == 'module-config'
        && (drPage('Field Control', ['Edit']) || drPage('Data Control', ['Edit']));
    }

    /* ── Site Fund Requisition (`requisitions`; src/components/site-fund-requisition) ─────────────
     *
     * The register (AllRequisitionsTab2) shows a person the requisitions they raised, and all of
     * them with `Site Fund Requisition` View All. The stage queues read every requisition at their
     * stage, the Site Fund Summary report and Billing Recon's dashboard tile read them all. So a
     * module user — View Module, or the Requests page (which links every stage queue), View All, the
     * report — and Billing Recon's users read the register whole; anyone else reads what they
     * raised (the register asks `where raisedById == me`) and what is waiting on them (the header's
     * task list and the work dashboard ask `where assignees array-contains me`, and the view
     * dialog re-reads it by id).
     *
     * Being on the current step's `assignees` is the authority to act (workflow-utils
     * getAssigneeForStep; no permission is checked), so the assignees move a requisition through
     * the workflow; before anyone has received it its details may be corrected by whoever sees it
     * in the register. The escalation cron writes on the Admin SDK.
     *
     * Names are `users` document ids (`userPermissions.userDocId`), never the auth uid. Budget: the
     * permissions document (1).
     */
    function drSfrAllReader() {
      return drHolds('Site Fund Requisition', ['View All'])
        || drHolds('Site Fund Requisition 2', ['View Module'])
        || drHolds('Site Fund Requisition 2.Requests', ['View', 'View All'])
        || drHolds('Site Fund Requisition 2.Reports.Site Fund Summary', ['View'])
        || drHolds('Billing Recon', ['View Module']);
    }

    function drSfrRaisedByMe(data) {
      return drMe() != '' && data.get('raisedById', '') == drMe();
    }

    function drSfrAssignee(data) {
      return drMe() != '' && data.get('assignees', []).hasAny([drMe()]);
    }

    match /requisitions/{requisitionId} {
      allow read: if drSfrAllReader() || drSfrRaisedByMe(resource.data) || drSfrAssignee(resource.data);

      // Raised as yourself, at the start of the workflow ("New Request", the Excel and bulk entry).
      allow create: if request.resource.data.get('status', '') == 'Pending'
        && drSfrRaisedByMe(request.resource.data)
        && (drHolds('Site Fund Requisition', ['Create Requisition']) || drHolds('Site Fund Requisition 2.Requests', ['Add']));

      allow update: if
        // A workflow action by the current step's assignee (ViewRequisitionDialog(2), the stage page).
        (drSfrAssignee(resource.data)
          && drChanged().hasOnly(['status', 'stage', 'currentStepId', 'assignees', 'deadline', 'history', 'expenseRequestNo']))
        // The register's edit, before anyone has received it (AllRequisitionsTab2 handleEditRequest).
        || (resource.data.get('stage', '') == 'Request Receiving'
          && (drSfrRaisedByMe(resource.data) || drHolds('Site Fund Requisition', ['View All'])
            || drHolds('Site Fund Requisition 2.Requests', ['View All']))
          && drChanged().hasOnly(['projectId', 'departmentId', 'amount', 'partyName', 'description', 'date', 'attachments']));
      // Requisitions are never deleted from the browser.
    }

    /* ── Vehicle Management and the driver app (src/lib/permissions.ts, "Vehicle Management" and
     *    "Driver Management"; src/lib/vehicle-management.ts) ──────────────────────────────────────
     *
     * The fleet. Every screen inside the Vehicle Management shell (module-layout-shell canViewModule:
     * View Module, or any grant on one of its sections) reads the registers whole on mount — the
     * overview, Renewals, Vehicle Health and the reports read every compliance register whatever
     * the page's own check says — so the registers, drivers and logs are readable by anyone the
     * shell admits and by nobody else. Writes follow the action each screen checks, and the
     * cascades a save runs on another register (the vehicle's cached compliance health, the
     * vehicle ↔ driver assignment, archiving the record a renewal replaces) are narrowed to their
     * own fields.
     *
     * The vehicle list itself is readable by any signed-in user: the driver app picks from it, and
     * Site Account Statement's expense forms — used by site staff who hold nothing here — read it by
     * project, by id and whole (use-vehicle-fuel.ts). It names vehicles and their assigned driver,
     * nothing more. Settings are read the same way (field control, trip tracking, vehicle types).
     *
     * The driver app (/driver-management, also in the Android WebView) is used by drivers who hold
     * no permission at all: being linked to a `vehicleManagementDriver` record is the authority. A
     * record is the caller's when its `linkedUserId` is their `users` document id, or — for drivers
     * saved before their login existed — when its `mobileNumber` is the mobile on their `users`
     * document, both cut to the last ten digits as the app does (hooks.ts useCurrentDriverProfile).
     * The pages ask for their own records with `driverId == <their driver record>`, and for their
     * vehicle's papers with `vehicleId == <their vehicle>`, which is theirs when the vehicle's
     * `assignedDriverId` is their record (Driver Master and Vehicle Master keep the two in step, one
     * driver per vehicle). Trips carry their GPS track, so only trip managers and the trip's own
     * driver read them.
     *
     * Site Account Statement keeps one fuel log per vehicle-fuel expense at `sas-<expenseId>`, written
     * after the expense by whoever may write that expense, under that module's own rules.
     *
     * Names are `users` document ids (`userPermissions.userDocId`), never the auth uid. Under Switch
     * User the administrator's own grants apply; a driver's own screens then refuse unless the
     * administrator holds the registers. Budget: the permissions document (1), a driver record (1),
     * the caller's `users` document for a mobile match (1), and one of the vehicle, the trip, or the
     * Site Account expense and its old and new project (≤3) — at most 6 of 10.
     */
    function vmPage(page) {
      return 'Vehicle Management.' + page;
    }

    function dmPage(page) {
      return 'Driver Management.' + page;
    }

    /*
     * The caller's grants, read once and passed along: a write that tries several grants in turn
     * would otherwise re-walk the permissions document for each, and the evaluation has a ceiling.
     */
    function vmPerms() {
      return hasPermissions() ? get(permissionsPath()).data.p : {};
    }

    function vmCan(p, resource, actions) {
      return p.get(resource, []).hasAny(actions);
    }

    function vmHolds(resource, actions) {
      return vmCan(vmPerms(), resource, actions);
    }

    /** Admitted by the Vehicle Management shell: View Module, or a grant on any of its sections. */
    function vmFleetUser() {
      let p = vmPerms();
      return vmCan(p, 'Vehicle Management', ['View Module']) || p.keys().hasAny([
        'Vehicle Management.Vehicle Master', 'Vehicle Management.Insurance Management',
        'Vehicle Management.PUC Management', 'Vehicle Management.Fitness Certificate Management',
        'Vehicle Management.Road Tax Management', 'Vehicle Management.Permit Management',
        'Vehicle Management.Maintenance Management', 'Vehicle Management.Fuel Management',
        'Vehicle Management.Driver Management', 'Vehicle Management.Trip Management',
        'Vehicle Management.Document Management', 'Vehicle Management.Reports', 'Vehicle Management.Settings'
      ]);
    }

    /** The caller's `users` id; '' when unknown, which then matches no one. */
    function vmMe() {
      return hasPermissions() ? get(permissionsPath()).data.get('userDocId', '') : '';
    }

    function vmIsMe(userId) {
      let me = vmMe();
      return me != '' && userId == me;
    }

    function vmChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /* ── Who is a driver ── */

    /** A mobile number as the app compares them (normalizeMobile): its digits, the last ten. */
    function vmLocalMobile(value) {
      let digits = string(value).replace('[^0-9]', '');
      return digits.size() > 10 ? digits[digits.size() - 10:digits.size()] : digits;
    }

    function vmMobileIsMine(value) {
      let me = vmMe();
      let local = vmLocalMobile(value);
      return me != '' && local != '' && exists(/databases/$(database)/documents/users/$(me))
        && vmLocalMobile(get(/databases/$(database)/documents/users/$(me)).data.get('mobile', '')) == local;
    }

    /** The driver record is the caller's (useCurrentDriverProfile). */
    function vmLinked(driver) {
      return vmIsMe(driver.get('linkedUserId', '')) || vmMobileIsMine(driver.get('mobileNumber', ''));
    }

    function vmDriverPath(driverId) {
      return /databases/$(database)/documents/vehicleManagementDriver/$(driverId);
    }

    /** `driverId` names the caller's own driver record. */
    function vmIsDriver(driverId) {
      return driverId is string && driverId != '' && hasPermissions() && exists(vmDriverPath(driverId))
        && vmLinked(get(vmDriverPath(driverId)).data);
    }

    function vmVehiclePath(vehicleId) {
      return /databases/$(database)/documents/vehicleManagementVehicles/$(vehicleId);
    }

    /** A company vehicle still in the fleet: in Vehicle Master, and not sold, scrapped or retired. */
    function vmFleetVehicle(vehicleId) {
      return vehicleId is string && vehicleId != '' && exists(vmVehiclePath(vehicleId))
        && !get(vmVehiclePath(vehicleId)).data.get('vehicleStatus', '')
          .matches('(?i).*(sold|scrap|dispos|inactive|retired|written).*');
    }

    /** The vehicle is assigned to the caller's driver record. */
    function vmDrivesVehicle(vehicleId) {
      return vehicleId is string && vehicleId != '' && hasPermissions() && exists(vmVehiclePath(vehicleId))
        && vmIsDriver(get(vmVehiclePath(vehicleId)).data.get('assignedDriverId', ''));
    }

    /** The driver record is the caller's and is assigned this vehicle (as the driver app sees it). */
    function vmIsDriverOf(driverId, vehicleId) {
      return vmIsDriver(driverId) && get(vmDriverPath(driverId)).data.get('assignedVehicleId', '') == vehicleId;
    }

    /** The grants that open a driver-app screen that writes (canAdd / canStartStop). */
    function vmDriverAppRole(p) {
      return vmCan(p, 'Driver Management.Driver Fuel', ['Add']) || vmCan(p, 'Vehicle Management.Driver Mobile Fuel', ['Add'])
        || vmCan(p, 'Vehicle Management.Fuel Management', ['Add'])
        || vmCan(p, 'Driver Management.Driver Daily Status', ['Add'])
        || vmCan(p, 'Vehicle Management.Driver Daily Status', ['Add'])
        || vmCan(p, 'Vehicle Management.Driver Management', ['Add'])
        || vmCan(p, 'Driver Management.Driver Trips', ['Add']) || vmCan(p, 'Vehicle Management.Driver Mobile Trip', ['Add'])
        || vmCan(p, 'Vehicle Management.Driver Mobile', ['Add']);
    }

    /* ── The vehicle list ── */

    /** Saving a compliance record recomputes the vehicle's cached health (compliance-sync.ts). */
    function vmComplianceWriter(p) {
      let actions = ['Add', 'Edit', 'Delete', 'Import'];
      return vmCan(p, 'Vehicle Management.Vehicle Master', actions)
        || vmCan(p, 'Vehicle Management.Insurance Management', actions)
        || vmCan(p, 'Vehicle Management.PUC Management', actions)
        || vmCan(p, 'Vehicle Management.Fitness Certificate Management', actions)
        || vmCan(p, 'Vehicle Management.Road Tax Management', actions)
        || vmCan(p, 'Vehicle Management.Permit Management', actions)
        || vmCan(p, 'Vehicle Management.Document Management', actions);
    }

    /*
     * What the driver app writes on the vehicle it drives: where it is and whether it is on a trip
     * (trips), its odometer (fuel, daily status) and running state (daily status). The page stamps
     * `updatedByDriverId`; the vehicle's own `assignedDriverId` vouches for pages from before that.
     * Someone who holds a driver-app grant may be on a vehicle not assigned to them.
     */
    function vmDriverAppVehicleUpdate(p, changed, vehicleId) {
      let next = request.resource.data;
      return changed.hasOnly([
          'currentLatitude', 'currentLongitude', 'currentLocationAtIso', 'currentStatus', 'currentOdometerKm',
          'vehicleStatus', 'updatedAt', 'updatedByDriverId'
        ])
        && (!changed.hasAny(['vehicleStatus']) || next.vehicleStatus in ['Active', 'Under Maintenance'])
        && (!changed.hasAny(['currentStatus']) || next.currentStatus in ['On Trip', 'In Operation'])
        && (vmDriverAppRole(p)
          || vmIsDriverOf(next.get('updatedByDriverId', ''), vehicleId)
          || (!changed.hasAny(['updatedByDriverId']) && vmIsDriver(resource.data.get('assignedDriverId', ''))));
    }

    function vmVehicleUpdate(vehicleId) {
      let p = vmPerms();
      let changed = vmChanged();
      return vmCan(p, 'Vehicle Management.Vehicle Master', ['Edit'])
        || (changed.hasOnly(['documentHealthStatus', 'hasExpiredDocuments', 'documentAlertCount'])
          && vmComplianceWriter(p))
        // Driver Master assigns and releases the vehicle (driver/page.tsx onAfterSave, onAfterDelete).
        || (changed.hasOnly(['assignedDriverId', 'assignedDriverName'])
          && vmCan(p, 'Vehicle Management.Driver Management', ['Add', 'Edit', 'Delete']))
        || vmDriverAppVehicleUpdate(p, changed, vehicleId);
    }

    match /vehicleManagementVehicles/{vehicleId} {
      allow read: if signedIn();
      allow create: if vmHolds(vmPage('Vehicle Master'), ['Add', 'Import']);
      allow update: if vmVehicleUpdate(vehicleId);
      allow delete: if vmHolds(vmPage('Vehicle Master'), ['Delete']);
    }

    /* ── The compliance registers and the maintenance log ── */

    /** Add archives the record it renews (generic-crud-page, insurance and PUC renewal mode). */
    function vmRenewalArchive() {
      return vmChanged().hasOnly(['renewalStatus', 'renewedById', 'renewedAt', 'isArchived', 'updatedAt']);
    }

    function vmRegisterUpdate(page) {
      let p = vmPerms();
      return vmCan(p, vmPage(page), ['Edit']) || (vmCan(p, vmPage(page), ['Add']) && vmRenewalArchive());
    }

    /** The registers' readers: the fleet, and the driver of the vehicle (driver-mobile/vehicle-details). */
    function vmRegisterReader(data) {
      return vmFleetUser() || vmDrivesVehicle(data.get('vehicleId', ''));
    }

    match /vehicleManagementInsurance/{recordId} {
      allow read: if vmRegisterReader(resource.data);
      allow create: if vmHolds(vmPage('Insurance Management'), ['Add', 'Import']);
      allow update: if vmRegisterUpdate('Insurance Management')
        // The renewal workflow marks the policy it opened a case for (insurance/workflow/page.tsx).
        || (vmHolds(vmPage('Insurance Management'), ['Add', 'Edit'])
          && vmChanged().hasOnly(['workflowCaseId', 'renewalStatus', 'updatedAt']));
      allow delete: if vmHolds(vmPage('Insurance Management'), ['Delete']);
    }

    match /vehicleManagementPuc/{recordId} {
      allow read: if vmRegisterReader(resource.data);
      allow create: if vmHolds(vmPage('PUC Management'), ['Add', 'Import']);
      allow update: if vmRegisterUpdate('PUC Management');
      allow delete: if vmHolds(vmPage('PUC Management'), ['Delete']);
    }

    match /vehicleManagementFitness/{recordId} {
      allow read: if vmRegisterReader(resource.data);
      allow create: if vmHolds(vmPage('Fitness Certificate Management'), ['Add', 'Import']);
      allow update: if vmRegisterUpdate('Fitness Certificate Management');
      allow delete: if vmHolds(vmPage('Fitness Certificate Management'), ['Delete']);
    }

    match /vehicleManagementRoadTax/{recordId} {
      allow read: if vmRegisterReader(resource.data);
      allow create: if vmHolds(vmPage('Road Tax Management'), ['Add', 'Import']);
      allow update: if vmRegisterUpdate('Road Tax Management');
      allow delete: if vmHolds(vmPage('Road Tax Management'), ['Delete']);
    }

    match /vehicleManagementPermit/{recordId} {
      allow read: if vmRegisterReader(resource.data);
      allow create: if vmHolds(vmPage('Permit Management'), ['Add', 'Import']);
      allow update: if vmRegisterUpdate('Permit Management');
      allow delete: if vmHolds(vmPage('Permit Management'), ['Delete']);
    }

    match /vehicleManagementDocuments/{recordId} {
      allow read: if vmRegisterReader(resource.data);
      allow create: if vmHolds(vmPage('Document Management'), ['Add', 'Import']);
      allow update: if vmRegisterUpdate('Document Management');
      allow delete: if vmHolds(vmPage('Document Management'), ['Delete']);
    }

    match /vehicleManagementMaintenanceLogs/{recordId} {
      allow read: if vmRegisterReader(resource.data);
      allow create: if vmHolds(vmPage('Maintenance Management'), ['Add', 'Import']);
      allow update: if vmRegisterUpdate('Maintenance Management');
      allow delete: if vmHolds(vmPage('Maintenance Management'), ['Delete']);
    }

    /* ── Fuel: the register, the driver app, and Site Account Statement's expenses ── */

    function vmSasExpensePath(expenseId) {
      return /databases/$(database)/documents/siteAccountExpenses/$(expenseId);
    }

    /*
     * Written or rewritten after its expense saved (syncFuelLog), so the expense is there and names
     * the project; a move to another project needs the right to write in both, as the expense did.
     */
    function vmSasFuelWrite(logId) {
      let data = request.resource.data;
      let expenseId = data.get('sasExpenseId', '');
      return logId.matches('sas-.+') && expenseId is string && expenseId != '' && logId == 'sas-' + expenseId
        && data.get('source', '') == 'site-account-statement'
        && hasPermissions() && exists(vmSasExpensePath(expenseId))
        && get(vmSasExpensePath(expenseId)).data.get('projectId', '') == data.get('sasProjectId', '')
        && sasLedgerWriter('Expenses', data.get('sasProjectId', ''))
        && (resource == null || sasLedgerWriter('Expenses', resource.data.get('sasProjectId', '')));
    }

    /** Removed after its expense is deleted, or when the expense stops being vehicle fuel. */
    function vmSasFuelDelete(logId) {
      return logId.matches('sas-.+') && (resource == null
        || (resource.data.get('source', '') == 'site-account-statement'
          && (sasHoldsAny('Expenses', ['Delete'])
            || sasLedgerWriter('Expenses', resource.data.get('sasProjectId', '')))));
    }

    match /vehicleManagementFuelLogs/{logId} {
      allow read: if vmRegisterReader(resource.data) || vmIsDriver(resource.data.get('driverId', ''));
      allow create: if vmHolds(vmPage('Fuel Management'), ['Add', 'Import'])
        // A driver's own fill-up (components/driver-management/driver-app/driver-fuel.tsx) — of an
        // office vehicle only: one in Vehicle Master and still in the fleet. A personal vehicle's
        // running is claimed per km (My Trips), never as fuel.
        || (request.resource.data.get('sourceApp', '') == 'Driver Mobile'
          && vmIsMe(request.resource.data.get('enteredByUserId', ''))
          && vmIsDriver(request.resource.data.get('driverId', ''))
          && vmFleetVehicle(request.resource.data.get('vehicleId', '')))
        || vmSasFuelWrite(logId);
      allow update: if vmHolds(vmPage('Fuel Management'), ['Edit']) || vmSasFuelWrite(logId);
      allow delete: if vmHolds(vmPage('Fuel Management'), ['Delete']) || vmSasFuelDelete(logId);
    }

    /* ── Drivers ── */

    match /vehicleManagementDriver/{driverId} {
      // The shell's registers, and the driver app's lookup of the caller's own record
      // (`linkedUserId == me`, `mobileNumber == mine`, `mobileNumber in [my formats]`).
      allow read: if vmFleetUser() || vmLinked(resource.data);
      allow create: if vmHolds(vmPage('Driver Management'), ['Add', 'Import']);
      allow update: if vmRegisterUpdate('Driver Management')
        // Vehicle Master assigns its vehicle to a driver, or takes it away.
        || (vmHolds(vmPage('Vehicle Master'), ['Add', 'Edit']) && vmChanged().hasOnly([
          'assignedVehicleId', 'assignedVehicleNumber', 'updatedAt', 'updatedBy', 'updatedByName'
        ]));
      allow delete: if vmHolds(vmPage('Driver Management'), ['Delete']);
    }

    /** Append-only: who drove what, written beside every assignment. */
    match /vehicleManagementDriverAssignments/{entryId} {
      allow read: if vmFleetUser();
      allow create: if vmHolds(vmPage('Vehicle Master'), ['Add', 'Edit'])
        || vmHolds(vmPage('Driver Management'), ['Add', 'Edit', 'Delete']);
    }

    /** A driver's end-of-day report, filed from the driver app; never edited there. */
    match /vehicleManagementDriverDailyStatus/{entryId} {
      allow read: if vmFleetUser() || vmIsDriver(resource.data.get('driverId', ''));
      allow create: if request.resource.data.get('sourceApp', '') == 'Driver Mobile'
        && vmIsDriver(request.resource.data.get('driverId', ''));
    }

    /* ── Trips and their GPS track ── */

    /** Trip Management, from either module (trips/page.tsx, the overview's month figures). */
    function vmTripManager() {
      return holdsAnyOf([vmPage('Trip Management'), dmPage('Trip Management')]);
    }

    function vmTripPath(tripId) {
      return /databases/$(database)/documents/vehicleManagementTrips/$(tripId);
    }

    function vmOwnTrip(tripId) {
      return tripId is string && tripId != '' && hasPermissions() && exists(vmTripPath(tripId))
        && vmIsDriver(get(vmTripPath(tripId)).data.get('driverId', ''));
    }

    match /vehicleManagementTrips/{tripId} {
      // Deleting a vehicle or a driver first checks they have no trips (`limit(1)`).
      allow read: if vmTripManager() || vmHolds(vmPage('Vehicle Master'), ['Delete'])
        || vmHolds(vmPage('Driver Management'), ['Delete'])
        || vmIsDriver(resource.data.get('driverId', ''));
      // SEL Fleet: trips are started, tracked, ended and reviewed through /api/fleet on the Admin
      // SDK, which owns the vehicle lock, the odometer and every figure that is billed. No browser
      // writes a trip: the old browser tracker is gone, and so is Trip Management's route-distance
      // correction (that page became Fleet Control › Fleet Trips, which reads through the API).
      // Reading is unchanged — the overview's month figures and the delete checks still read here.
      allow create, update: if false;
    }

    /**
     * A trip's GPS track. Written only by /api/fleet (batches of up to 200, idempotent on the
     * phone's point id), so no browser creates a point; reading the route stays as it was.
     */
    match /vehicleManagementTripLocations/{pointId} {
      allow read: if vmTripManager() || vmOwnTrip(resource.data.get('tripId', ''));
      allow create: if false;
    }

    /* ── Employee trip reimbursement, retired (the old driver-management/employee-trips page; the
     *    collection held no records when My Trips and the employeeTrip* collections replaced it) ── */

    /** canManageAll: works every claim. Everyone else files and edits their own. */
    function vmClaimManager() {
      return vmHolds(dmPage('Employee Trip Log'), ['Edit', 'Delete', 'Approve'])
        || vmHolds(vmPage('Employee Trip Reimbursement'), ['Edit', 'Delete', 'Approve'])
        || vmHolds(vmPage('Driver Management'), ['View'])
        || vmHolds(dmPage('Trip Management'), ['View']);
    }

    /*
     * Your own claim, filed as yourself and waiting for a decision: the decision fields are the
     * approvers', and a decided claim is changed only by them.
     */
    match /vehicleManagementEmployeeTrips/{claimId} {
      allow read: if vmClaimManager() || vmIsMe(resource.data.get('submittedByUserId', ''));
      allow create: if vmClaimManager()
        || (vmIsMe(request.resource.data.get('submittedByUserId', ''))
          && request.resource.data.get('approvalStatus', 'Submitted') == 'Submitted');
      allow update: if vmClaimManager()
        || (vmIsMe(resource.data.get('submittedByUserId', ''))
          && !(resource.data.get('approvalStatus', '') in ['Approved', 'Rejected', 'Reimbursed'])
          && request.resource.data.get('submittedByUserId', '') == resource.data.get('submittedByUserId', '')
          && request.resource.data.get('approvalStatus', '') == resource.data.get('approvalStatus', '')
          && request.resource.data.get('approverRemarks', '') == resource.data.get('approverRemarks', ''));
      allow delete: if vmClaimManager();
    }

    /* ── The insurance renewal workflow ── */

    match /vehicleManagementInsuranceWorkflowCases/{caseId} {
      // The workflow board, and the dashboard on / and /my-work (`assigneeIds array-contains me`).
      allow read: if holdsAnyOf([vmPage('Insurance Management')])
        || (vmMe() != '' && resource.data.get('assigneeIds', []).hasAny([vmMe()]));
      // The expiry scan opens cases, the board's actions move them, a renewal closes them; the
      // scheduler (api/vehicle-management/insurance-workflow) does the same on the Admin SDK.
      allow create, update: if vmHolds(vmPage('Insurance Management'), ['Add', 'Edit']);
    }

    /** Append-only and write-only from the browser: each action, as the person who took it. */
    match /vehicleManagementInsuranceWorkflowActivities/{entryId} {
      allow create: if vmHolds(vmPage('Insurance Management'), ['Add', 'Edit'])
        && vmIsMe(request.resource.data.get('userId', ''));
    }

    /* ── Settings: read by every form, the driver app and Site Account Statement ── */

    match /vehicleManagementSettings/{settingId} {
      allow read: if signedIn();
      allow create, update: if settingId == 'fieldControl'
        ? vmHolds(vmPage('Settings'), ['Manage Field Control', 'Edit'])
        : vmHolds(vmPage('Settings'), ['Edit']);
    }

    /* ── Windows Agent: activity, devices, access, notifications, settings ───────────────────────
     *
     * The rest of the module (src/lib/windows-agent-permissions.ts; every browser query is in
     * src/lib/windows-agent-service.ts). The agent and the work-calls app write through
     * /api/windows-agent/* on the Admin SDK; nothing here is written by a machine.
     *
     * Sessions, daily rollups and activity spans follow `canViewActivityOf`:
     *   - `View All`: anybody's;
     *   - your own (`userId` == your `users` id), when `canViewOwnActivity` holds — any Activity
     *     grant, or the installation's `employeeSelfViewEnabled`, which is on unless switched off;
     *   - `View Department` and `View Team`: rows filed under one of `userPermissions.departmentIds`
     *     (the lists query `departmentId in [...]`), or one named person whose `users.departmentId`
     *     is one of them (the person page queries `userId == X`). A team is drawn from those same
     *     departments in this installation (`teamUserIds` in the module's provider), and the team
     *     lists ask by department for that reason — a list of user ids cannot be checked here;
     *   - `Live Users View`: open sessions only, which is all the live board subscribes to.
     * Sessions View, Attendance View, Reports View and Dashboard View open pages; what those pages
     * show is still the activity scope above, so they add nothing at this layer.
     *
     * Budget: the permissions document (1), the settings document (1, own rows without a grant) and
     * the named person's `users` document (1) — 3 of 10.
     */
    function waHolds(page, actions) {
      return hasPermissions() && get(permissionsPath()).data.p.get('Windows Agent.' + page, []).hasAny(actions);
    }

    /** The caller's `users` id; '' when unknown or deactivated, which then matches no one. */
    function waMe() {
      return hasPermissions() && get(permissionsPath()).data.get('active', false) == true
        ? get(permissionsPath()).data.get('userDocId', '') : '';
    }

    function waSettingsPath() {
      return /databases/$(database)/documents/windowsAgentSettings/default;
    }

    /** `canViewOwnActivity`: a grant, or the installation setting (a missing document means on). */
    function waSelfView() {
      return waHolds('Activity', ['View Own', 'View Team', 'View Department', 'View All'])
        || !exists(waSettingsPath())
        || get(waSettingsPath()).data.get('employeeSelfViewEnabled', true) != false;
    }

    function waOwn(userId) {
      return waMe() != '' && userId == waMe() && waSelfView();
    }

    function waMyDepartments() {
      return get(permissionsPath()).data.get('departmentIds', []);
    }

    function waUserPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    /** A named person in one of the caller's departments, by their `users` record. */
    function waColleague(userId) {
      return exists(waUserPath(userId)) && get(waUserPath(userId)).data.get('departmentId', '') in waMyDepartments();
    }

    /** Sessions and daily rollups, which carry the department they were recorded under. */
    function waActivityReader(data) {
      return waHolds('Activity', ['View All'])
        || waOwn(data.userId)
        || (waHolds('Activity', ['View Department', 'View Team'])
          && (data.departmentId in waMyDepartments() || waColleague(data.userId)));
    }

    match /windowsSessions/{sessionId} {
      allow read: if (resource.data.status == 'OPEN' && holds('Windows Agent.Live Users', 'View'))
        || waActivityReader(resource.data);
    }

    match /windowsDailyActivity/{rollupId} {
      allow read: if waActivityReader(resource.data);
    }

    /** One person's spans for one day (`userId ==`, `workDate ==`). They carry no department. */
    match /windowsActivityEvents/{eventId} {
      allow read: if waHolds('Activity', ['View All'])
        || waOwn(resource.data.userId)
        || (waHolds('Activity', ['View Department', 'View Team']) && waColleague(resource.data.userId));
    }

    /* Enrolled computers. Created, re-keyed and secured only by the API: each browser action may
     * change its own fields and the update stamps, so the credential (`deviceSecretHash`,
     * `secretVersion`), the posture (`securityPosture`, `lastSecurityCheckAt`), the security
     * policy and the maintenance grant are out of every browser's reach. */
    function waChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function waStampedBy(field) {
      return !waChanged().hasAny([field]) || request.resource.data[field] == waMe();
    }

    function waDeviceUpdate() {
      return waStampedBy('updatedBy') && (
        // Approve a pending PC (Edit); block any PC, or unblock a blocked one (Block).
        (waChanged().hasOnly(['status', 'statusReason', 'statusChangedAt', 'statusChangedBy',
            'updatedAt', 'updatedBy', 'updatedByName'])
          && waStampedBy('statusChangedBy')
          && ((waHolds('Devices', ['Edit']) && resource.data.status == 'PENDING'
              && request.resource.data.status == 'ACTIVE')
            || (waHolds('Devices', ['Block']) && (request.resource.data.status == 'BLOCKED'
              || (resource.data.status == 'BLOCKED' && request.resource.data.status == 'ACTIVE')))))
        || (waHolds('Devices', ['Force Re-authentication']) && waChanged().hasAny(['forceReauthAt'])
          && waChanged().hasOnly(['forceReauthAt', 'statusReason', 'updatedAt', 'updatedBy', 'updatedByName']))
        || (waHolds('Devices', ['Sign Out User']) && waChanged().hasAny(['forceSignOutAt'])
          && waChanged().hasOnly(['forceSignOutAt', 'statusReason', 'updatedAt', 'updatedBy', 'updatedByName']))
        || (waHolds('Devices', ['Assign Users']) && request.resource.data.assignedUserIds is list
          && waChanged().hasOnly(['assignedUserIds', 'updatedAt', 'updatedBy', 'updatedByName']))
        || (waHolds('Devices', ['Edit'])
          && waChanged().hasOnly(['updateRing', 'deviceName', 'updatedAt', 'updatedBy', 'updatedByName'])
          && request.resource.data.get('updateRing', 'BROAD') in ['PILOT', 'EARLY', 'BROAD', 'HELD']
          && request.resource.data.deviceName is string && request.resource.data.deviceName.size() > 0)
      );
    }

    match /windowsDevices/{deviceId} {
      // The live board joins its open sessions to the machines they are on.
      allow read: if waHolds('Devices', ['View']) || holds('Windows Agent.Live Users', 'View');
      allow update: if waDeviceUpdate();
    }

    /** Which PCs one person may sign in on, keyed by their `users` id. Never their own to edit. */
    match /windowsUserAccess/{userId} {
      allow read: if waHolds('Devices', ['View', 'Assign Users']);
      allow create, update: if waHolds('Devices', ['Assign Users'])
        && request.resource.data.userId == userId
        && request.resource.data.allowedDeviceIds is list
        && request.resource.data.get('updatedBy', '') == waMe();
      allow delete: if waHolds('Devices', ['Assign Users']);
    }

    /** Sent through /api/windows-agent/notifications/send; the delivery report reads the counts. */
    match /windowsNotifications/{notificationId} {
      allow read: if waHolds('Notifications', ['View', 'Send']);
    }

    /*
     * The monitoring statement and the self-view switch. Readable by everybody signed in: a
     * disclosure only the monitors can read is not one, and the switch decides what the rules above
     * let employees see. Written by Monitoring Policy Edit, in the fields its page saves.
     */
    function waSettingsValid(data) {
      return data.employeeSelfViewEnabled is bool
        && (data.monitoringPolicyText == null || data.monitoringPolicyText is string)
        && data.minimumFullDaySeconds is number
        && data.minimumFullDaySeconds > 0 && data.minimumFullDaySeconds <= 86400
        && data.get('updatedBy', '') == waMe();
    }

    match /windowsAgentSettings/{docId} {
      allow get: if signedIn();
      allow create: if docId == 'default' && holds('Windows Agent.Monitoring Policy', 'Edit')
        && request.resource.data.keys().hasOnly(['employeeSelfViewEnabled', 'monitoringPolicyText',
          'minimumFullDaySeconds', 'updatedAt', 'updatedBy', 'updatedByName'])
        && waSettingsValid(request.resource.data);
      allow update: if holds('Windows Agent.Monitoring Policy', 'Edit')
        && waChanged().hasOnly(['employeeSelfViewEnabled', 'monitoringPolicyText', 'minimumFullDaySeconds',
          'updatedAt', 'updatedBy', 'updatedByName'])
        && waSettingsValid(request.resource.data);
    }

    /* ── TRANSITIONAL CATCH-ALL ─────────────────────────────────────────────────────────────────
     *
     * Every collection not closed above stays open to any signed-in user, as it has been since
     * 2026-10-13. Stage 2 shrinks this module by module. Keyed on the top-level collection, so a
     * closed collection's subcollections are closed with it.
     */
    match /{collection}/{document=**} {
      allow read: if signedIn() && !serverOnly(collection) && !ownRules(collection);
      allow write: if signedIn() && !serverOnly(collection) && !browserReadOnly(collection)
        && !ownRules(collection);
    }
  }
}
