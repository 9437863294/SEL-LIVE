{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "src/app/(protected)/employee/sync/**/*.tsx",
    "src/app/api/greythr/**/*.ts",
    "src/components/employee/**/*.tsx",
